.reviews/
.ansible/

# Scratch clone of github.com/tyrchen/sbe used while writing SBE_DEVC_NOTES.md.
# It was committed as a bare gitlink by the 4373f35 merge — a pointer with no
# .gitmodules, so it was unresolvable on a fresh clone and a latent path for
# unreviewed third-party code to enter the repo. Untracked on purpose.
sbe/

# Security-review working artifacts. These are point-in-time notes about a
# specific branch or commit range — they go stale the moment the code moves,
# and a stale finding read as current is worse than no finding. The durable
# conclusions belong in README.md (Limitations), TESTS.md (coverage gaps), or
# docs/design-principles.md instead. Anchored to the repo root so anything
# deliberately curated under docs/ stays tracked.
/DIFFERENTIAL_REVIEW*.md
/SHARP_EDGES*.md
/INSECURE_DEFAULTS*.md
/VARIANT_ANALYSIS*.md
/TOB_REVIEW*.md
/FIX_PLAN.md
/VERIFICATION_REQUESTS.md
/SBE_DEVC_NOTES.md
/VERIFIER_STATUS*.md
/FINDINGS_measured*.md
/FINDINGS_attack_detection*.md

# Saved web pages kept while researching version pins (e.g. the Alpine package
# index consulted while writing the pins in bc6786d). Research residue, not part
# of the role — and this is a Galaxy role, so anything at the repo root ships to
# every consumer on `ansible-galaxy install`.
*.html

# Personal dev sandbox for working ON this repo (a vendored copy of
# trailofbits/claude-code-devcontainer). It is NOT part of the role — the role
# is tasks/, templates/, defaults/, meta/, and a Galaxy consumer never receives
# this. Tracking it at the repo root made it read as a role artifact (it is not)
# and pinned a byte-identical third-party copy with no upstream update path.
# Kept local, untracked. Re-clone the upstream devcontainer if you want it back.
.devcontainer/
