#!/bin/bash
# supply-chain-allow-build — Managed by ansible-supply-chain-security
#
# A SAFE, single-command escape hatch for uv's `no-build = true`. A developer
# building their OWN trusted source vouches for that ONE build — WITHOUT
# dropping the other hardened uv settings.
#
# WHAT no-build BLOCKS (MEASURED, uv 0.12.7): source builds — `uv pip install .`
# from a local project, `uv pip install --no-binary :all: ...`, and any install
# that must compile a wheel from an sdist. A pure-Python EDITABLE install
# (`uv pip install -e .`) is a PEP 660 install and is NOT blocked; an editable
# install that has to compile is.
#
# THE FOOTGUN THIS REPLACES. uv has no clean single-key negation for no-build:
# UV_NO_BUILD=false is silently ignored and --no-build has no negation flag
# (verified, uv 0.12.7). The only built-in overrides are blunt and drop
# protections silently:
#   --no-config                    -> drops ALL config (index-strategy,
#                                     exclude-newer, verify-hashes,
#                                     allow-insecure-host)
#   --config-file / UV_CONFIG_FILE -> REPLACE discovery, so a hand-written
#                                     minimal file silently drops those same four
# So this helper MIRRORS the current hardened uv.toml, flips ONLY no-build to
# false, and applies it (via UV_CONFIG_FILE) to the single command you pass.
# Every OTHER protection stays on for the build window.
#
# USAGE
#   supply-chain-allow-build -- uv pip install .
#   supply-chain-allow-build    uv sync            # the -- is optional
#
# HONEST RESIDUAL (see docs/design-principles.md, "developer mode")
#   - uv cannot scope build permission per package, so this opens the build
#     engine for the WHOLE command. Trust the source you point it at.
#   - UV_CONFIG_FILE REPLACES config discovery, so a project-level [tool.uv] /
#     uv.toml is NOT merged for this command; pass any needed flags explicitly.

set -euo pipefail
PROG=supply-chain-allow-build

usage() {
  cat >&2 <<EOF
$PROG: run ONE uv command with no-build lifted — every other hardened uv
setting kept on.

  usage: $PROG [--] uv <args...>
  e.g.:  $PROG -- uv pip install .

It mirrors the hardened uv.toml, flips only no-build=false, and scopes that to
the command via UV_CONFIG_FILE. It refuses commands that are not 'uv'.
EOF
}

# --- args: optional leading `--`, then the command to run ---
if [ "${1:-}" = "--" ]; then shift; fi
if [ "$#" -lt 1 ]; then usage; exit 2; fi

# This hatch only mirrors uv config, so it only makes sense for uv. Accept
# `uv` or a path ending in /uv; refuse anything else rather than silently
# running a non-uv command under a uv config file.
case "$1" in
  uv | */uv) : ;;
  *)
    echo "$PROG: refusing to run '$1' — this hatch is only for 'uv' commands." >&2
    exit 2
    ;;
esac

# --- locate the hardened uv.toml to mirror (user config first, then system) ---
# Same resolution uv itself uses for user config: $XDG_CONFIG_HOME/uv, else
# $HOME/.config/uv. Require our marker so we mirror OUR config, never a foreign
# uv.toml a caller happens to have.
if [ -n "${XDG_CONFIG_HOME:-}" ]; then
  user_cfg="$XDG_CONFIG_HOME/uv/uv.toml"
else
  user_cfg="${HOME:-}/.config/uv/uv.toml"
fi
src=""
for c in "$user_cfg" /etc/uv/uv.toml; do
  if [ -f "$c" ] && grep -q "Managed by ansible-supply-chain-security" "$c" 2>/dev/null; then
    src="$c"
    break
  fi
done
if [ -z "$src" ]; then
  echo "$PROG: no hardened uv.toml found (looked at '$user_cfg' and /etc/uv/uv.toml)." >&2
  echo "$PROG: is the supply-chain-hardening role applied for uv on this host?" >&2
  exit 3
fi

# --- build the transient mirror: same config, no-build flipped to false ---
tmp="$(mktemp)"
out="$(mktemp)"
trap 'rm -f "$tmp" "$out"' EXIT INT TERM

{
  echo "# TRANSIENT — generated by $PROG; mirrors $src with no-build lifted."
  echo "# Not persisted; do not edit."
} >"$tmp"
if grep -qE '^[[:space:]]*no-build[[:space:]]*=' "$src"; then
  sed -E 's/^[[:space:]]*no-build[[:space:]]*=.*/no-build = false/' "$src" >>"$tmp"
  lifted=1
else
  # No no-build in the hardened file (uv_no_build was false): nothing to lift.
  cat "$src" >>"$tmp"
  lifted=0
fi

echo "[$PROG] mirroring $src; no-build lifted for THIS command only — every other uv protection stays on." >&2
if [ "$lifted" = 0 ]; then
  echo "[$PROG] note: the hardened uv.toml sets no 'no-build' restriction, so nothing was lifted." >&2
fi
echo "[$PROG] running: $*" >&2

# --- run the one command with the mirrored config; capture output to summarize builds ---
set +e
UV_CONFIG_FILE="$tmp" "$@" 2>&1 | tee "$out"
rc=${PIPESTATUS[0]}
set -e

# --- auto-verify: report what actually built from source, so the vouching is
#     visible rather than implicit (the agent's "check the cache after"). ---
built="$(grep -iE '(^|[[:space:]])(Building|Built)[[:space:]]' "$out" | sed 's/^/    /' || true)"
if [ -n "$built" ]; then
  echo "[$PROG] built from source during this command (review these):" >&2
  printf '%s\n' "$built" >&2
else
  echo "[$PROG] uv reported no source builds for this command." >&2
fi
exit "$rc"
