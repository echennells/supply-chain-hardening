#!/bin/bash
# cargo — supply-chain-hardening wrapper
# Managed by ansible-supply-chain-security.
#
# SCOPE — read this before extending it.
#
# This is a FIRST-INVOCATION control, not an enforcement boundary. Three
# mechanisms route around it and none can be closed from here:
#   - cargo overwrites $CARGO with its own resolved toolchain path, so build
#     scripts and third-party subcommands that re-enter cargo do so unwrapped;
#   - a repo-local rust-toolchain.toml with `path =` supplies its own cargo;
#   - RUSTC_WRAPPER / repo-local .cargo/config.toml execute code with no
#     registry involvement at all.
# It raises the floor for ordinary invocations. Containment of build.rs is a
# separate concern that this wrapper does not attempt. See the README
# limitations section for what is and is not covered.
#
# WHAT IT DOES
#
#   1. --locked injection. There is no config or env route to --locked
#      (CARGO_LOCKED is not a thing), so a wrapper is the only mechanism.
#      When a Cargo.lock exists, cargo may not silently change resolution to
#      satisfy a build; a new transitive dependency becomes an error.
#   2. Prefix-exec: routes resolution-affecting commands through
#      `cargo cooldown` (publish-age gate) and/or `sfw` (threat intel) when
#      those are enabled and present.
#
# WHAT IT DELIBERATELY DOES NOT DO
#
# Re-implement cargo's CLI semantics. Two removed controls did that and both
# failed silently: an install-time age check that queried crates.io with
# curl+python3 (inert for binary-only crates, which is most of what `cargo
# install` installs), and a lockfile-writer gate that copied the user's
# Cargo.toml/Cargo.lock aside and restored them on refusal. Wrappers are sound
# at prefixing and injecting, and unsound at parsing and deciding.
#
# PARSING
#
# The subcommand is the FIRST NON-FLAG ARGUMENT, exactly as npm-wrapper.sh.j2
# and deno-wrapper.sh.j2 determine it. Reading argv[1] directly is wrong:
# `cargo -q build`, `cargo --color always build` and `cargo -v build` are
# ordinary Makefile and CI forms, and treating `-q` as the subcommand silently
# disabled every control here.
#
# Cargo needs one addition over the npm idiom: five of its thirteen global
# flags take a value, and the value must be skipped or `cargo --color always
# build` resolves to the subcommand "always". The global-flag set is closed and
# documented (`cargo --help`); the SUBCOMMAND set is not, which is why unknown
# subcommands are warned about and passed through rather than enumerated.
#
# BYPASS (per-invocation)
#
#   {{ cargo_real_path }} build              # around the wrapper entirely
#   SUPPLY_CHAIN_CARGO_WRAPPED=1 cargo build
#
# DISABLE
#
#   cargo_path_wrapper=false restores the real binary on the next apply.
#
# `rustup update` rewrites ~/.cargo/bin/cargo and overwrites this wrapper.
# Re-apply the role afterwards; supply-chain-verify reports the gap.

set -u

REAL_CARGO='{{ cargo_real_path }}'
# RUN-PROBE. Record that this wrapper actually executed.
#
# Free on a real invocation (SCH_WRAPPER_PROBE is unset, so this is one test).
# supply-chain-verify sets it to a temp file, invokes the tool, and reads back
# which wrappers ran.
#
# It replaces inferring "did our wrapper run" from PATH position, which CANNOT
# tell a bypassed wrapper from one chained behind another wrap. MEASURED: with
# an Aikido safe-chain shim first on PATH the wrapper ran on every call while
# the verifier reported "shadowed and never runs". Every version manager
# (asdf, mise, volta, nodenv, pyenv) is shim-first and delegates the same way.
#
# The value is caller-controlled, so it is only ever a redirect target. Never
# interpolate it into a command.
if [ -n "${SCH_WRAPPER_PROBE:-}" ]; then
  printf '%s\n' "$0" >> "$SCH_WRAPPER_PROBE" 2>/dev/null || true
fi


# cargo-cooldown lives in $CARGO_HOME/bin, which is on PATH for a rustup cargo
# but NOT for a distro/apt cargo (whose ~/.cargo/bin is nowhere on PATH). Without
# this, `command -v cargo-cooldown` below fails on apt-cargo hosts and cargo's
# own `cargo cooldown` subcommand resolution (cargo-<name> on PATH) fails too —
# so the age gate silently does nothing even though the backend built fine.
# Prepend it, idempotently, so both lookups succeed on every host shape.
COOLDOWN_BIN='{{ cargo_cooldown_bin | default("") }}'
if [ -n "$COOLDOWN_BIN" ] && [ -d "$COOLDOWN_BIN" ]; then
  case ":$PATH:" in *":$COOLDOWN_BIN:"*) ;; *) PATH="$COOLDOWN_BIN:$PATH"; export PATH ;; esac
fi

# Recursion guard — same pattern as the bun, composer, deno, npm and pip
# wrappers.
if [ -z "$REAL_CARGO" ] || [ ! -x "$REAL_CARGO" ] || [ "$REAL_CARGO" = "$0" ]; then
  echo "[supply-chain-hardening] error: real cargo not found at '$REAL_CARGO'; refusing to recurse" >&2
  exit 127
fi

# Re-entrancy guard: cargo-cooldown invokes cargo internally, and without this
# that inner call routes back into cooldown forever.
if [ -n "${SUPPLY_CHAIN_CARGO_WRAPPED:-}" ]; then
  exec "$REAL_CARGO" "$@"
fi

# ARGV[0] MUST BE "cargo". rustup's ~/.cargo/bin/cargo is a symlink to the
# rustup binary, which dispatches on the name it was invoked as; a backup named
# cargo-real is rejected with "unknown proxy name: 'cargo-real'". On a
# non-rustup cargo, argv[0] is not consulted, so this is safe for both shapes.
run_real() {
  local pfx=""
{% if cargo_socket_firewall | bool %}
  if [ "${SCH_NET:-0}" = "1" ] && command -v sfw >/dev/null 2>&1; then
    pfx="sfw"
  fi
{% endif %}
  if [ -n "$pfx" ]; then
    # sfw execs the child itself, so argv[0] cannot be set here. Safe because
    # cargo-real is an argv[0] shim on rustup hosts.
    exec "$pfx" "$REAL_CARGO" "$@"
  fi
  exec -a cargo "$REAL_CARGO" "$@"
}

# --- find the subcommand: first non-flag argument ---
subcmd=""
skip_value=0
unknown_flag=""
for arg in "$@"; do
  if [ "$skip_value" = "1" ]; then skip_value=0; continue; fi
  case "$arg" in
    +*) ;;                                          # rustup toolchain override
    --color|--explain|-C|--config|-Z) skip_value=1 ;;  # these take a value
    -*) ;;
    *) subcmd="$arg"; break ;;
  esac
done

# Does the caller already state an explicit resolution intent? Scan only the
# args cargo parses — everything after `--` belongs to the user's program.
has_resolution_flag() {
  local a
  for a in "$@"; do
    [ "$a" = "--" ] && return 1
    case "$a" in --locked|--frozen|--offline) return 0 ;; esac
  done
  return 1
}

# Walk up for a lockfile. Cargo is routinely run from a workspace subdirectory,
# so checking only ./Cargo.lock would skip --locked for most real invocations.
# Stops at the first directory containing one.
has_lockfile() {
  local d="$PWD"
  while [ -n "$d" ] && [ "$d" != "/" ]; do
    [ -f "$d/Cargo.lock" ] && return 0
    d="$(dirname "$d")"
  done
  [ -f "/Cargo.lock" ]
}

# Re-emit argv with EXTRA inserted immediately after the subcommand. Never
# appended: `cargo run -- prog` would otherwise hand the flag to prog.
# Same construction as the deno wrapper.
exec_with() {
  local extra="$1"; shift
  local -a out=()
  local inserted=0 a
  for a in "$@"; do
    out+=("$a")
    if [ "$inserted" = "0" ] && [ "$a" = "$subcmd" ]; then
      out+=("$extra")
      inserted=1
    fi
  done
  run_real "${out[@]}"
}

# Re-emit argv with the subcommand token REPLACED IN PLACE by the given tokens.
# Order matters and must be preserved: rustup requires `+toolchain` to be the
# first argument, so rebuilding as `<sub> <rest>` and appending the leading
# globals produces `cooldown build +nightly`, which rustup rejects.
exec_sub() {
  local a b="$1" c="$2"; shift 2
  local -a out=()
  local done_sub=0 a
  for a in "$@"; do
    if [ "$done_sub" = "0" ] && [ "$a" = "$subcmd" ]; then
      out+=("$b" "$c"); done_sub=1
    else
      out+=("$a")
    fi
  done
  run_real "${out[@]}"
}

# --- occupy cargo-cooldown's top precedence level -------------------------
#
# cargo-cooldown resolves policy in this order:
#   1. environment  (COOLDOWN_*, CARGO_REGISTRY_*_MIN_PUBLISH_AGE)
#   2. member cooldown.toml
#   3. workspace cooldown.toml
#   4. $CARGO_HOME/cooldown.toml   <-- the only level this role writes
#
# so a caller could replace the entire policy with one exported variable, and
# nothing said so. MEASURED (cargo-cooldown 0.3.5, deployed 48h/deny window,
# dependency published 7 minutes before the test): `cargo build` refuses with
#   `incompatible-publish-age = "deny"` blocked fresh versions
# while EACH of COOLDOWN_MINUTES=0, COOLDOWN_ENFORCEMENT=off,
# COOLDOWN_ENFORCEMENT=cargo_compatible, COOLDOWN_INCOMPATIBLE_PUBLISH_AGE=allow
# (and =fallback), COOLDOWN_NOW=2050-01-01T00:00:00Z,
# COOLDOWN_SKIP_REGISTRIES=crates-io, CARGO_REGISTRY_GLOBAL_MIN_PUBLISH_AGE=0 and
# CARGO_REGISTRY_MIN_PUBLISH_AGE=0 builds it instead, exit 0 -- while
# supply-chain-verify still reported "window 48 hours" and "deny". Same class as
# ECH-197 on the npm side: caller input routing around the control the wrapper
# exists to apply.
#
# CLEARING level 1 is not sufficient. It hands the decision back to a file whose
# LOCATION the caller still controls, and CARGO_HOME is an eleventh bypass
# (MEASURED: relocate it to a directory with no cooldown.toml and the gate is
# gone). SETTING level 1 makes this wrapper's policy win against every level
# below it. The wrapper is rendered from the same variables as
# templates/cargo-cooldown.toml.j2, so writer and wrapper cannot drift.
#
# Pinning beats a repo-local or workspace cooldown.toml for every setting that
# HAS an environment form: the global window, the crates.io window
# (`[registry] min-publish-age`, which otherwise beats the global one), the
# clock (`now`), the skip list (`skip_registries`), the violation action and the
# lockfile baseline. It does NOT neutralise a committed cooldown.toml, because
# the settings below have no environment form and a file can only loosen them,
# never be overridden (src/config.rs min_publish_age_seconds_for /
# allow_rules.rs, read from source):
#   [allow.global] minutes, [[allow.package]] minutes  -> shrink the window
#   [[allow.exact]]                                    -> admit one version
#   [registries.<alt>] min-publish-age                 -> an alt registry's window
# So a cooldown.toml committed to an untrusted repo is still a bypass, and
# supply-chain-verify reports one as GAP. The cost of the pins is that a repo
# legitimately shipping a WIDER window is narrowed to this host's
# release_age_hours.
#
# Presence is tested against one captured `env` rather than ${!var} indirection
# or eval. This script is #!/bin/bash so indirection would work; the reason is
# hygiene, not portability -- a security-relevant function in a wrapper that
# runs on every `cargo build` should not do dynamic name resolution or dynamic
# execution when a static list reads the same.
# ONE SPELLING PER SETTING. cargo-cooldown accepts two names for two of these
# settings and ABORTS if both are set and disagree (src/config.rs apply_env):
#   COOLDOWN_ENFORCEMENT        strict|cargo_compatible|off  -> Deny|Fallback|Allow
#   COOLDOWN_INCOMPATIBLE_PUBLISH_AGE  deny|fallback|allow
#   COOLDOWN_CARGO_COMPATIBLE_ACCEPT / COOLDOWN_FALLBACK_ACCEPT   (same pairing)
# An earlier cut of this function exported COOLDOWN_ENFORCEMENT=strict ALONGSIDE
# COOLDOWN_INCOMPATIBLE_PUBLISH_AGE. With the default `deny` the two agree, so
# every test passed; with the supported override
# `cargo_cooldown_violation_action: fallback` they do not, and MEASURED
# (faithful ansible render, cargo-cooldown 0.3.5) every routed cargo command
# failed with:
#   Error: environment defines incompatible `COOLDOWN_ENFORCEMENT` and
#   `COOLDOWN_INCOMPATIBLE_PUBLISH_AGE` values
# So the compat aliases are CLEARED and only the canonical names are pinned.
# Do not "complete the set" by exporting the alias too.
#
# The pinned values are exactly what templates/cargo-cooldown.toml.j2 writes, so
# with the file present nothing changes; with it absent (a relocated CARGO_HOME)
# behaviour is the same as if it were present, rather than falling to
# cargo-cooldown's built-in defaults.
sanitize_cooldown_env() {
  _sc_env=$(env)
  _sc_had=''
  for _sc_v in COOLDOWN_MINUTES COOLDOWN_ENFORCEMENT COOLDOWN_INCOMPATIBLE_PUBLISH_AGE \
               COOLDOWN_FALLBACK_ACCEPT COOLDOWN_CARGO_COMPATIBLE_ACCEPT \
               COOLDOWN_LOCKFILE_BASELINE COOLDOWN_NOW COOLDOWN_SKIP_REGISTRIES \
               CARGO_REGISTRY_GLOBAL_MIN_PUBLISH_AGE CARGO_REGISTRY_MIN_PUBLISH_AGE; do
    if printf '%s\n' "$_sc_env" | grep -q "^$_sc_v="; then
      _sc_had="$_sc_had $_sc_v"
    fi
    unset "$_sc_v"
  done
  # PER-REGISTRY WINDOWS. cargo-cooldown also scans every
  # CARGO_REGISTRIES_<NAME>_MIN_PUBLISH_AGE (src/config.rs,
  # env_registry_min_publish_age_overrides) and applies it to the registry whose
  # lowercased name matches. For crates.io that never matches -- CRATES_IO
  # lowercases to crates_io, not crates-io, which is why it MEASURED inert -- but
  # for an alternative registry named without a dash it sets that registry's
  # window, to 0 if the caller likes. Read from source, not measured: there was no
  # alternative registry to test against. The names are matched by a fixed
  # pattern of [A-Za-z0-9_], so the word-split below cannot carry anything else.
  for _sc_v in $(printf '%s\n' "$_sc_env" | sed -n 's/^\(CARGO_REGISTRIES_[A-Za-z0-9_]*_MIN_PUBLISH_AGE\)=.*/\1/p'); do
    _sc_had="$_sc_had $_sc_v"
    unset "$_sc_v"
  done
  # A name bash cannot unset. cargo-cooldown takes ANY text between the prefix
  # and suffix as the registry name, so `env 'CARGO_REGISTRIES_my-reg_MIN_PUBLISH_AGE=0'`
  # zeroes the window of a registry spelled with its real dashed name -- and
  # `unset` rejects that as an invalid identifier, so it would reach
  # cargo-cooldown untouched. Refuse rather than pass it through.
  if printf '%s\n' "$_sc_env" | grep -q '^CARGO_REGISTRIES_[^=]*[^A-Za-z0-9_=][^=]*_MIN_PUBLISH_AGE='; then
    echo "[supply-chain-hardening] error: a CARGO_REGISTRIES_*_MIN_PUBLISH_AGE variable with a non-identifier name is set; this wrapper cannot clear it and it would override this host's publish-age window. Unset it and retry." >&2
    exit 2
  fi
  if [ -n "$_sc_had" ]; then
    echo "[supply-chain-hardening] note: overriding caller publish-age setting(s):$_sc_had - this host's {{ release_age_hours }}h/{{ cargo_cooldown_violation_action }} policy applies instead. For a per-crate exception use cargo_cooldown_allow_exact, which writes an [[allow.exact]] rule this override does not touch." >&2
  fi
  export COOLDOWN_MINUTES={{ release_age_hours | int * 60 }}
  # The crates.io window. Without it a repo cooldown.toml's
  # `[registry] min-publish-age = "0"` beats COOLDOWN_MINUTES (MEASURED: built a
  # crate published hours earlier). Cargo reads the same variable as its own
  # unstable registry.min-publish-age and prints `warning: ignoring
  # registry.min-publish-age without -Zmin-publish-age` once or twice per build
  # (cargo 1.99). Harmless, and if cargo stabilises the setting it will enforce
  # this same window itself.
  export CARGO_REGISTRY_MIN_PUBLISH_AGE="{{ release_age_hours | int }} hours"
  export COOLDOWN_INCOMPATIBLE_PUBLISH_AGE={{ cargo_cooldown_violation_action }}
  export COOLDOWN_LOCKFILE_BASELINE=floor
  export COOLDOWN_FALLBACK_ACCEPT=auto
  # The real clock and an EMPTY skip list. Both have file forms (`now`,
  # `skip_registries`) that a repo cooldown.toml can set; the environment
  # replaces them. The role exposes no skip list, so empty is its policy.
  export COOLDOWN_NOW="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  export COOLDOWN_SKIP_REGISTRIES=
  # Diagnostic only, deliberately not a refusal: relocating CARGO_HOME for cache
  # keying is a supported CI shape, and with level 1 pinned above the gate holds
  # there anyway (MEASURED).
  _sc_ch="${CARGO_HOME:-$HOME/.cargo}"
  [ -f "$_sc_ch/cooldown.toml" ] || \
    echo "[supply-chain-hardening] note: no cooldown.toml at $_sc_ch - the window above is in force from the environment; allow.exact rules from that file are not." >&2
}

# --- classify the subcommand ---
#
# RESOLVING  compiles or resolves, and accepts --locked
# WRITER     exists to CHANGE the lockfile, so --locked is contradictory
# QUIET      cannot change resolution; pass through with no output
# unknown    third-party subcommand, repo alias or typo: warn, pass through,
#            and do NOT inject anything (we do not know its flag grammar)
case "$subcmd" in
  build|b|check|c|test|t|run|r|bench|doc|d|rustc|rustdoc|tree|fetch|package|publish|clippy)
    KIND=RESOLVING ;;
  update|add|remove|rm|generate-lockfile|vendor)
    KIND=WRITER ;;
  install)
    KIND=INSTALL ;;
  ""|new|init|clean|fmt|search|login|logout|owner|yank|uninstall|locate-project|\
metadata|pkgid|read-manifest|verify-project|config|version|help|cooldown|binstall)
    KIND=QUIET ;;
  *)
    KIND=UNKNOWN ;;
esac

case "$KIND" in
  QUIET)
    run_real "$@"
    ;;

  UNKNOWN)
    # The subcommand set is open (any cargo-* on PATH, plus repo [alias]).
    # Enumerating it cannot converge, so say what is happening instead of
    # silently doing nothing — a silent pass-through and a protected build are
    # otherwise indistinguishable at the terminal.
    echo "[supply-chain-hardening] note: 'cargo $subcmd' is not a recognised subcommand; no supply-chain controls applied to this invocation" >&2
    run_real "$@"
    ;;

  INSTALL)
    # `cargo install` takes the newest version by default and no workspace
    # lockfile applies. --locked makes it honour the lockfile the crate was
    # published with. It is NOT age-gated: the previous 112-line crates.io
    # check was inert for binary-only crates and failed open on any network or
    # interpreter problem. A deliberate, interactive command gets an honest
    # line instead of a control that only looks like one.
    #
    # SCH_NET=1 so `cargo install` still routes through Socket Firewall like every
    # other network path. MEASURED: before this, install set neither SCH_NET nor a
    # gate, so cargo's most network-heavy subcommand was fully unfiltered while the
    # README claimed cargo was wired to sfw. Only the age gate skips install now.
    echo "[supply-chain-hardening] note: 'cargo install' is not age-gated (it is routed through Socket Firewall); check the crate's publish date before installing" >&2
    if has_resolution_flag "$@"; then
      SCH_NET=1 run_real "$@"
    fi
    SCH_NET=1 exec_with "--locked" "$@"
    ;;

  WRITER)
    # These are supposed to change the lockfile, so --locked is contradictory.
    # `cargo update` is also the one resolution path --locked can never cover,
    # which is why the age gate matters most here.
{% if cargo_cooldown_enforce | bool %}
    if command -v cargo-cooldown >/dev/null 2>&1; then
      sanitize_cooldown_env
      case "$subcmd" in
        update)
          export SUPPLY_CHAIN_CARGO_WRAPPED=1
          SCH_NET=1 exec_sub cooldown update "$@" ;;
        *)
          # EVERY OTHER WRITER IS UNGATED, AND MUST SAY SO. `cargo add` and
          # `cargo generate-lockfile` write a lockfile entry with no age check;
          # lockfile-baseline = "floor" then GRANDFATHERS that entry on the
          # next gated `cargo build`. So two ordinary commands defeat the gate.
          # This warning previously lived only in the cooldown-ABSENT branch,
          # which inverted it: the hardened configuration was the silent one
          # and the unhardened one warned.
          echo "[supply-chain-hardening] warning: 'cargo $subcmd' writes Cargo.lock and is NOT age-gated; a freshly published version recorded here is trusted by later gated commands" >&2 ;;
      esac
    else
      echo "[supply-chain-hardening] warning: cargo-cooldown not installed — 'cargo $subcmd' can write a lockfile entry for a freshly published crate with no age check" >&2
    fi
{% else %}
    echo "[supply-chain-hardening] note: 'cargo $subcmd' is not age-gated (cargo_cooldown_enforce=false)" >&2
{% endif %}
    SCH_NET=1 run_real "$@"
    ;;

  RESOLVING)
{% if cargo_cooldown_enforce | bool %}
    if command -v cargo-cooldown >/dev/null 2>&1; then
      sanitize_cooldown_env
      case "$subcmd" in
        build|b) SUB=build ;;
        check|c) SUB=check ;;
        test|t)  SUB=test ;;
        run|r)   SUB=run ;;
        *)       SUB="" ;;
      esac
      if [ -n "$SUB" ]; then
        export SUPPLY_CHAIN_CARGO_WRAPPED=1
        SCH_NET=1 exec_sub cooldown "$SUB" "$@"
      fi
    fi
{% endif %}
    # No age gate available (or a subcommand cooldown has no verb for).
    # Fall back to --locked, and say so when nothing at all applies rather
    # than leaving an unprotected build indistinguishable from a gated one.
    if has_resolution_flag "$@"; then
      SCH_NET=1 run_real "$@"
    fi
    if has_lockfile; then
      SCH_NET=1 exec_with "--locked" "$@"
    fi
    echo "[supply-chain-hardening] warning: no Cargo.lock found and no publish-age gate available — 'cargo $subcmd' will resolve the newest matching versions unchecked" >&2
    SCH_NET=1 run_real "$@"
    ;;
esac
