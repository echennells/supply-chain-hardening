# FRAGMENT 90 OF /usr/local/bin/supply-chain-verify — the report and the exit
# code. Assembled by tasks/verify.yml after templates/verify.sh.j2 (the
# context preamble and the host-only probes) and files/verify-probes.sh (the
# probe body shared byte-for-byte with the CI surface).
#
# This half is last because it consumes what every probe produced. It is a
# template rather than a static file only so that it lives beside the other
# half of this surface's user-facing contract; it contains no Jinja.
#
# Defaults so this fragment still renders if it is ever run without a
# preamble in front of it.
: "${SCV_SCOPE_LABEL:=on $(hostname)}"
: "${SCV_APPLIED_AT:=unknown}"
: "${SCV_MIN_AGE_HOURS:=}"
: "${NA_DESIGN:=0}"
: "${VERBOSE:=0}"
: "${JSON:=0}"

# --json is the machine contract (ECH-195): the rows and result as JSON, the
# shape a CI pre-install gate consumes. It bypasses the table AND --quiet,
# because a gate wants the data, not a suppressed table. The exit code below is
# unchanged, so `supply-chain-verify --json` is itself the gate.
if [ "$JSON" -eq 1 ]; then
  # Minimal, dependency-free JSON escaping: backslash and double-quote are the
  # only characters that can appear in a detail string and break JSON. Rows are
  # single-line (\t-separated, \n-terminated), so no embedded newlines to handle.
  scv_jesc() { local s=$1; s=${s//\\/\\\\}; s=${s//\"/\\\"}; printf '%s' "$s"; }
  printf '{\n'
  printf '  "scope": "%s",\n' "$(scv_jesc "$SCV_SCOPE_LABEL")"
  printf '  "generated": "%s",\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  printf '  "declared_intent_recorded": "%s",\n' "$(scv_jesc "$SCV_APPLIED_AT")"
  if [ -n "$SCV_MIN_AGE_HOURS" ]; then
    printf '  "min_age_hours": %s,\n' "$SCV_MIN_AGE_HOURS"
  else
    printf '  "min_age_hours": null,\n'
  fi
  printf '  "result": { "gaps": %s, "weaks": %s, "na_design": %s },\n' "$GAPS" "$WEAKS" "$NA_DESIGN"
  printf '  "rows": [\n'
  scv_first=1
  # '%b' expands the row separators; see the note in the table branch below.
  printf '%b' "$ROWS" | { while IFS=$'\t' read -r s e p d; do
      [ -n "$s" ] || continue
      if [ "$scv_first" -eq 1 ]; then scv_first=0; else printf ',\n'; fi
      printf '    { "status": "%s", "evidence": "%s", "protection": "%s", "detail": "%s" }' \
        "$(scv_jesc "$s")" "$(scv_jesc "$e")" "$(scv_jesc "$p")" "$(scv_jesc "$d")"
    done; }
  printf '\n  ]\n}\n'
elif [ "$QUIET" -eq 0 ]; then
  echo
  echo "supply-chain-hardening — what is ACTUALLY enforcing $SCV_SCOPE_LABEL"
  echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  # What this host DECLARED, and when. A GAP below means "below what this
  # line promised", so the reader needs to see the promise — and needs to
  # know how old it is, because the preamble is frozen at apply time while
  # the host keeps drifting. A verifier judging against a year-old intent
  # should say so rather than be quietly believed.
  echo "declared intent recorded $SCV_APPLIED_AT${SCV_MIN_AGE_HOURS:+ · age window ${SCV_MIN_AGE_HOURS}h} — re-apply the role to refresh it"
  echo
  printf "%-6s %-11s %-32s %s\n" "STATUS" "EVIDENCE" "PROTECTION" "DETAIL"
  printf "%-6s %-11s %-32s %s\n" "------" "-----------" "--------------------------------" "------"
  # '%b', NOT "$ROWS" as a format string. A bare % in an interpolated path
  # would otherwise rewrite the row that names the file. %b expands the \n
  # row separators without treating % as a directive, so it is safe by
  # construction rather than by escaping. action/verify.sh does the same, and
  # files/verify-probes.sh's cq() is a pass-through to match — all three move
  # together or none do.
  printf '%b' "$ROWS" | while IFS=$'\t' read -r s e p d; do
    [ -n "$s" ] || continue
    # ECH-195: by default condense DETAIL to a one-line summary so the table is
    # scannable; --verbose prints the full rationale. STATUS + EVIDENCE +
    # PROTECTION — the signal a reader actually scans for — is never truncated.
    if [ "$VERBOSE" -eq 0 ]; then
      d=${d%%. *}                            # first sentence, if the detail has one
      [ ${#d} -gt 66 ] && d="${d:0:65}..."   # then cap the column width
    fi
    printf "%-6s %-11s %-32s %s\n" "$s" "$e" "$p" "$d"
  done
  echo
  [ "$VERBOSE" -eq 0 ] && { echo "(one-line summaries — run with --verbose for the full rationale, or --json for machine output)"; echo; }
  echo "EVIDENCE: FUNCTIONAL = observed behavior · PARSED = the tool reported the"
  echo "setting back · PRESENT = a file exists and nothing more (unverified)."
  echo "N/A rows say '-' (the tool is not installed here) or BYDESIGN (this"
  echo "host's role configuration never asked for it)."
  echo
  if [ "$GAPS" -gt 0 ]; then
    echo "RESULT: $GAPS gap(s) — protections NOT in effect $SCV_SCOPE_LABEL."
  else
    echo "RESULT: no gaps."
  fi
  [ "$WEAKS" -gt 0 ] && echo "        $WEAKS row(s) verified only as PRESENT — not evidence of enforcement."
  [ "$NA_DESIGN" -gt 0 ] && echo "        $NA_DESIGN row(s) N/A — not requested by this host's configuration."
  echo
fi

[ "$GAPS" -gt 0 ] && exit 1
[ "$STRICT" -eq 1 ] && [ "$WEAKS" -gt 0 ] && exit 1
exit 0
