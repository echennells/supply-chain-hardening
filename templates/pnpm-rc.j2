; Managed by ansible-supply-chain-security
minimum-release-age={{ pnpm_minimum_release_age_minutes }}
minimum-release-age-strict={{ pnpm_minimum_release_age_strict | bool | lower }}
{% for pkg in pnpm_minimum_release_age_exclude %}
minimum-release-age-exclude[]={{ pkg }}
{% endfor %}
; block-exotic-subdeps is deliberately NOT emitted here.
;
; It refuses git / http(s) / tarball-URL dependencies, and runtime
; enforcement requires pnpm 11+. Writing it to THIS file is dead in both
; directions:
;   - pnpm 10 reads this file but silently ignores the key. Verified
;     empirically against pnpm 10.34.5, which proceeded to a DNS lookup for
;     `pnpm add https://does-not-resolve.invalid/pkg.tgz`.
;   - pnpm 11+ enforces the key but does not read this file at all (it reads
;     only ~/.config/pnpm/config.yaml for non-auth settings).
; So no pnpm version exists in which this line does anything.
;
; The live emission is `blockExoticSubdeps: true` in pnpm-config.yaml.j2.
; When the detected pnpm is older than 11, tasks/pnpm.yml records the gap in
; the end-of-run "protections NOT applied" summary instead of leaving an inert
; key behind that reads like coverage. Same principle as 111e21b (composer:
; stop shipping fake script-blocking protection).
; Store integrity + lockfile determinism (see defaults/main.yml for rationale).
; verify-store-integrity: hash-check store contents against the lockfile.
; prefer-frozen-lockfile: install from an up-to-date lockfile without
; re-resolving (deterministic pins). Neither hard-fails on drift — hard
; freeze (frozen-lockfile) is intentionally left to CI so dev installs that
; legitimately update the lockfile keep working.
verify-store-integrity={{ pnpm_verify_store_integrity | bool | lower }}
prefer-frozen-lockfile={{ pnpm_prefer_frozen_lockfile | bool | lower }}
{% if pnpm_built_dependencies | length > 0 %}
; Explicit build-script allowlist (pnpm 11+). Listed packages may run build
; scripts; everything else is blocked. Override /etc/npmrc's
; ignore-scripts=true explicitly — pnpm merges config per-key, and an
; omitted key here would let the system-wide value win (silently disabling
; this allowlist). The allowlist below is what actually constrains scripts.
ignore-scripts=false
{% for pkg in pnpm_built_dependencies %}
only-built-dependencies[]={{ pkg }}
{% endfor %}
{% else %}
; No build scripts allowed for any package — equivalent default-deny via the
; older mechanism (works on pnpm 8-11+). To allow specific packages to run
; build scripts, set pnpm_built_dependencies in role vars.
ignore-scripts=true
{% endif %}
