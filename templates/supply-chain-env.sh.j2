#!/bin/sh
# Managed by ansible-supply-chain-security
# System-wide supply chain hardening — loaded by /etc/profile.d/

# === npm / pnpm / yarn / bun ===
export NPM_CONFIG_IGNORE_SCRIPTS={{ npm_ignore_scripts | lower }}
export NPM_CONFIG_AUDIT={{ npm_audit | lower }}
export NPM_CONFIG_SAVE_EXACT={{ npm_save_exact | lower }}
export NPM_CONFIG_FUND={{ npm_fund | lower }}
export NPM_CONFIG_UPDATE_NOTIFIER={{ npm_update_notifier | lower }}
export NPM_CONFIG_MIN_RELEASE_AGE={{ npm_minimum_release_age_days }}

# === Python (pip / uv) ===
export PYTHONDONTWRITEBYTECODE={{ python_dont_write_bytecode | int }}
export PIP_DISABLE_PIP_VERSION_CHECK={{ pip_disable_version_check | int }}
export UV_LINK_MODE=copy
# Note: we deliberately do NOT set UV_NO_SYSTEM_CONFIG=1 here, even though
# uv 0.11.16+ supports it as a "block /etc/uv/ overrides" defense. The
# role deploys /etc/uv/uv.toml as the system-wide hardening fallback for
# sudo / non-deploying-user invocations (see tasks/uv.yml). Setting the
# env var would make uv ignore that file in PAM-loaded shells — the
# exact case the fallback exists for. The "defends against malicious
# /etc/uv/" reasoning is hollow anyway: an attacker who can write
# root:root /etc/uv/uv.toml can also edit /etc/environment to unset the
# env var. Defense lives in file permissions and integrity monitoring,
# not in a self-disarming env var.

# === Go ===
# Sumdb + proxy stay active. GOPRIVATE / GONOPROXY / GOINSECURE are emptied so
# no module is exempted from sumdb checks, proxy traffic, or HTTPS. GOTOOLCHAIN
# locks to the installed toolchain to prevent auto-download of alternatives.
export GOSUMDB='{{ go_sumdb }}'
export GOPROXY='{{ go_proxy }}'
export GOFLAGS='-mod={{ goflags_mod }}'
export GOPRIVATE='{{ go_private }}'
export GONOPROXY='{{ go_noproxy }}'
export GOINSECURE='{{ go_insecure }}'
# GONOSUMDB is REAL and is a sumdb bypass. MEASURED on go1.27.0:
#   go env -w GONOSUMDB=example.com   -> rc 0, accepted
#   go env -w GONOSUMCHECK=1          -> unknown go command variable
# `go help environment` documents GOPRIVATE, GONOPROXY, GONOSUMDB together
# as prefixes 'not compared against the checksum database', and the
# GOINSECURE entry names GONOSUMDB as a way to disable sumdb validation.
# It was omitted because 10-go-adversarial.bats asserted it was not a real
# variable - a wrong test comment was the documented reason a recommended
# sweep (SOURCES.md:16) got dropped. Clearing it, like the other three.
export GONOSUMDB='{{ go_nosumdb | default('', true) }}'
export GOTOOLCHAIN=local

# === PHP (Composer) ===
# Belt-and-suspenders for `php composer.phar` callers that bypass our
# /usr/local/bin/composer wrapper but inherit the system env. Composer
# 2.8.0+ honors COMPOSER_SKIP_SCRIPTS=<event,list> by skipping dispatch
# of any user-defined script registered for the named events. MEASURED:
# silently ignored on 2.2.6 (Ubuntu 22.04) and 2.7.1 (Ubuntu 24.04),
# honoured on 2.8.12+ — an earlier comment here said 2.9 and was wrong.
# On 2.2-2.7 this export is inert and the composer PATH wrapper is the
# only script-blocking layer; tasks/composer.yml records that in
# skipped_protections so the end-of-run summary says so. Below is
# the full enumeration from composer's ScriptEvents + PackageEvents +
# PluginEvents at the time of writing. Composer silently ignores unknown
# names, so extra events here are harmless if composer drops one in the
# future — but a NEW event added by composer that we don't list here
# slips through. The /usr/local/bin/composer wrapper is the primary
# protection; this env var is the backup for shells that bypass it.
export COMPOSER_SKIP_SCRIPTS='pre-install-cmd,post-install-cmd,pre-update-cmd,post-update-cmd,pre-status-cmd,post-status-cmd,pre-autoload-dump,post-autoload-dump,post-root-package-install,post-create-project-cmd,pre-archive-cmd,post-archive-cmd,pre-package-install,post-package-install,pre-package-update,post-package-update,pre-package-uninstall,post-package-uninstall,init,command,pre-file-download,post-file-download,pre-command-run,pre-pool-create'
# COMPOSER_ALLOW_SUPERUSER=1 is also exported inside the composer wrapper
# (templates/composer-wrapper.sh.j2). Both locations are needed — not a
# duplication: the wrapper covers callers in non-PAM contexts (cron,
# systemd ExecStart, container CMD) where /etc/profile.d/ never loads;
# this profile.d export covers `php composer.phar` callers that bypass
# the wrapper but inherit the PAM-loaded environment. Removing either
# leaves a coverage gap.
export COMPOSER_ALLOW_SUPERUSER=1

# === .NET (NuGet) ===
# This env var OVERRIDES signatureValidationMode in NuGet.Config in BOTH
# directions, on every SDK. MEASURED on 6.0.428, 8.0.424, 9.0.317 and 10.0.400
# (linux-arm64): DOTNET_NUGET_SIGNATURE_VERIFICATION=false disables signature
# enforcement even when tasks/nuget.yml has deployed
# signatureValidationMode=require — so leaving it unset lets any inherited
# `false` silently disarm the file. Pinning it true fixes the safe side of that
# conflict and does more than the file can on the 6.x tier, where the config
# key is accepted-and-inert: MEASURED, 6.0.428 parses require and restores an
# unsigned package anyway, but refuses with NU3004 once this is true. 8.0.424+
# enforce the config key unaided, so true is a no-op there beyond denying a
# later `false` the last word.
export DOTNET_NUGET_SIGNATURE_VERIFICATION=true
