#!/bin/bash
# /usr/local/bin/supply-chain-verify — Managed by ansible-supply-chain-security
#
# WHAT THIS IS FOR
#
# Every protection in this role has failed at least once in the same way: the
# config file was written correctly, the tool ignored it, and nothing said so.
#   yarn npmMinimalAgeGate: "2d"     -> parsed to NaN, gate silently absent
#   npm  MINIMUM_RELEASE_AGE         -> key npm does not read, gate absent
#   pnpm 11                          -> stopped reading rc/npmrc entirely
#   pnpm 10 block-exotic-subdeps     -> accepted the key, ignored it
#   bun  ignoreScripts               -> bunfig not loaded for `bun run`
#   npq  on Node < 20.13             -> passes through to npm, exits 0
#
# Grepping our own config files cannot catch any of these, because in every
# case the file was exactly what we intended to write. The only thing that
# catches them is asking the TOOL what it ended up believing, or watching it
# act. That is what this script does, on the real host, against the real
# installed versions.
#
# EVIDENCE STRENGTH — reported per row, because it is the whole point
#
#   FUNCTIONAL  We ran the protection and observed its behavior. Strongest.
#   PARSED      The tool itself reported the setting back to us. Proves the
#               tool read the file, recognized the key, and accepted the
#               value — which is what all six failures above violated.
#   PRESENT     We only know a file or binary exists. Weakest; this is the
#               evidence level that produced every bug listed above, so rows
#               reporting it are flagged rather than counted as coverage.
#
# STATUS
#   OK        protection verified at the stated evidence strength
#   GAP       tool is installed but the protection is NOT in effect
#   WEAK      tool is installed, protection looks present, but we could only
#             establish PRESENT — treat as unverified, not as covered
#   N/A       tool not installed on this host; nothing to protect
#
# Exit code: 0 when there are no GAP rows, 1 otherwise. WEAK does not fail the
# run by itself — use --strict to make it.
#
# Safe to run any time: every probe is read-only. Nothing here installs,
# fetches, or writes.

set -u

STRICT=0
QUIET=0
for arg in "$@"; do
  case "$arg" in
    --strict) STRICT=1 ;;
    --quiet)  QUIET=1 ;;
    -h|--help)
      sed -n '2,44p' "$0" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
  esac
done

GAPS=0
WEAKS=0
ROWS=""

row() { # status, strength, protection, detail
  ROWS="${ROWS}$1\t$2\t$3\t$4\n"
  [ "$1" = "GAP" ]  && GAPS=$((GAPS + 1))
  [ "$1" = "WEAK" ] && WEAKS=$((WEAKS + 1))
  return 0
}

have() { command -v "$1" >/dev/null 2>&1; }

# Does npm actually IMPLEMENT a config key, or is it merely echoing our file
# back at us?
#
# This distinction cost a false OK in this very script. `npm config get <key>`
# returns whatever is in the config for ANY key, implemented or not:
#
#   $ echo 'this-key-does-not-exist=hello' >> ~/.npmrc
#   $ npm config get this-key-does-not-exist
#   hello
#
# So a value coming back proves npm READ the file — not that npm honors the
# key. On npm 10.9.8, `npm config get min-release-age` happily returns our
# value while npm has no such feature (it landed in 11.10.0). That is the same
# silently-ignored-setting failure the whole script exists to catch, reproduced
# inside the detector.
#
# The discriminator: ask npm with our config and env stripped away. A key npm
# implements has a built-in default; a key it does not know returns
# "undefined" even though our file sets it.
npm_implements() {
  local key="$1" tmp v
  tmp=$(mktemp -d 2>/dev/null) || return 1
  : > "$tmp/u"; : > "$tmp/g"
  # env -i also drops NPM_CONFIG_*, which otherwise supplies the value and
  # recreates the exact false positive.
  v=$(env -i PATH="$PATH" HOME="$tmp" npm config get "$key" \
        --userconfig="$tmp/u" --globalconfig="$tmp/g" 2>/dev/null | head -1 | tr -d '\r')
  rm -rf "$tmp"
  [ -n "$v" ] && [ "$v" != "undefined" ]
}

# ---------------------------------------------------------------- npm --------
if have npm; then
  # `npm config get` is npm's own view after merging every config source. If it
  # disagrees with our file, npm did not honor our file.
  if ! npm_implements ignore-scripts; then
    row GAP FUNCTIONAL "npm lifecycle scripts blocked" "npm $(npm --version 2>/dev/null) does not implement ignore-scripts"
  else
    v=$(npm config get ignore-scripts 2>/dev/null | tr -d '\r')
    if [ "$v" = "true" ]; then
      row OK PARSED "npm lifecycle scripts blocked" "npm implements ignore-scripts and reports true"
    else
      row GAP PARSED "npm lifecycle scripts blocked" "npm reports ignore-scripts=${v:-<unset>}"
    fi
  fi

  # The age gate needs BOTH checks, and the implementation check comes first.
  # npm echoes back keys it does not implement, so the value alone is not
  # evidence — see npm_implements() above.
  nv=$(npm --version 2>/dev/null)
  if ! npm_implements min-release-age; then
    row GAP FUNCTIONAL "npm age gate" "npm $nv does NOT implement min-release-age (added in npm 11.10.0). Our config sets it and npm echoes it back, but nothing enforces it."
  else
    v=$(npm config get min-release-age 2>/dev/null | tr -d '\r')
    case "$v" in
      ''|null|undefined) row GAP PARSED "npm age gate" "npm implements min-release-age but reports no value" ;;
      *[!0-9]*)          row GAP PARSED "npm age gate" "npm reports non-numeric min-release-age='$v'" ;;
      0)                 row GAP PARSED "npm age gate" "min-release-age=0 disables the gate" ;;
      *)                 row OK  PARSED "npm age gate" "npm $nv implements min-release-age and reports $v day(s)" ;;
    esac
  fi
else
  row "N/A" - "npm" "npm not installed"
fi

# ---------------------------------------------------------------- yarn -------
if have yarn; then
  yv=$(yarn --version 2>/dev/null)
  case "$yv" in
    1.*)
      # Yarn classic never reads .yarnrc.yml, so none of our yarn hardening
      # applies. Silent today; reported here.
      row GAP FUNCTIONAL "yarn hardening" "yarn $yv is classic and ignores .yarnrc.yml entirely" ;;
    *)
      # The "2d" bug: yarn accepted the file, parsed the value to NaN, and
      # applied no gate. Asking yarn for the value is what exposes that.
      v=$(yarn config get npmMinimalAgeGate 2>/dev/null | tr -d '\r' | tr -d ' ')
      case "$v" in
        ''|undefined|null)
          row GAP PARSED "yarn age gate" "yarn does not report npmMinimalAgeGate (needs yarn >= 4.10; found $yv)" ;;
        *[!0-9]*)
          row GAP PARSED "yarn age gate" "yarn reports non-integer npmMinimalAgeGate='$v' (this is the NaN failure)" ;;
        0)
          row GAP PARSED "yarn age gate" "npmMinimalAgeGate=0 disables the gate" ;;
        *)
          row OK PARSED "yarn age gate" "yarn reports npmMinimalAgeGate=$v minutes" ;;
      esac
      v=$(yarn config get enableScripts 2>/dev/null | tr -d '\r' | tr -d ' ')
      if [ "$v" = "false" ]; then
        row OK PARSED "yarn lifecycle scripts blocked" "yarn reports enableScripts=false"
      else
        row GAP PARSED "yarn lifecycle scripts blocked" "yarn reports enableScripts=${v:-<unset>}"
      fi
      ;;
  esac
else
  row "N/A" - "yarn" "yarn not installed"
fi

# ---------------------------------------------------------------- pnpm -------
if have pnpm; then
  pv=$(pnpm --version 2>/dev/null)
  pmaj=${pv%%.*}
  if [ -n "$pmaj" ] && [ "$pmaj" -ge 11 ] 2>/dev/null; then
    row OK FUNCTIONAL "pnpm exotic-dep blocking" "pnpm $pv enforces blockExoticSubdeps"
  else
    # No pnpm 10 config key enforces this — verified against 10.34.5, which
    # went to DNS for a tarball dep.
    row GAP FUNCTIONAL "pnpm exotic-dep blocking" "pnpm $pv cannot enforce blockExoticSubdeps (needs >= 11); no config key changes this"
  fi
  # DELIBERATELY WEAKER THAN THE npm ROW. pnpm is known to accept config keys
  # it does not implement and silently ignore them — that is precisely how
  # block-exotic-subdeps behaved on 10.34.5. So a value echoed back by
  # `pnpm config get` proves pnpm read the file and nothing more, and there is
  # no pnpm equivalent of the npm_implements() discriminator (pnpm has no
  # documented way to ask "do you know this key"). Reporting OK here would
  # repeat the npm false positive, so a good-looking value caps out at WEAK.
  v=$(pnpm config get minimum-release-age 2>/dev/null | tr -d '\r' | tr -d ' ')
  case "$v" in
    ''|undefined|null) row GAP  PRESENT "pnpm age gate" "pnpm did not report minimum-release-age back" ;;
    *[!0-9]*)          row GAP  PARSED  "pnpm age gate" "pnpm reports non-numeric minimum-release-age='$v'" ;;
    0)                 row GAP  PARSED  "pnpm age gate" "minimum-release-age=0 disables the gate" ;;
    *)                 row WEAK PRESENT "pnpm age gate" "pnpm echoes minimum-release-age=$v, but pnpm echoes unimplemented keys too — not proof of enforcement" ;;
  esac
else
  row "N/A" - "pnpm" "pnpm not installed"
fi

# ------------------------------------------------- npq (reputation layer) ----
# The layer that addresses slopsquatting — an attacker pre-registering a
# plausible name an agent might guess. An age gate does nothing against a squat
# registered months ago; this is what catches it. It also fails OPEN: below
# Node 20.13.0 it warns, runs the real package manager, and exits 0.
if have npq-hero; then
  out=$(npq-hero --version 2>&1)
  if printf '%s' "$out" | grep -qi 'npq suppressed'; then
    row GAP FUNCTIONAL "npq reputation checks" "npq is installed but SUPPRESSED on Node $(node --version 2>/dev/null); it passes through to npm and exits 0"
  else
    row OK FUNCTIONAL "npq reputation checks" "npq responds normally (not suppressed)"
  fi
else
  row GAP PRESENT "npq reputation checks" "npq-hero not installed — no pre-install reputation checking"
fi

# ------------------------------------------------- sfw (reputation layer) ----
if have sfw; then
  if sfw --version >/dev/null 2>&1; then
    row OK FUNCTIONAL "Socket Firewall" "sfw responds to --version"
  else
    row GAP FUNCTIONAL "Socket Firewall" "sfw is on PATH but does not execute successfully"
  fi
else
  row GAP PRESENT "Socket Firewall" "sfw not installed — npm installs are not threat-intel filtered"
fi

# ------------------------------------------------------- PATH wrappers -------
# Wrappers are the weakest evidence class in the whole role: existence proves
# nothing about whether callers resolve through them.
#
# CHECK THE PATH CALLERS ACTUALLY HIT, NOT A FIXED DIRECTORY.
# An earlier version of this loop only looked in /usr/local/bin. But only npm
# and pip/pip3 deploy there — composer, deno, bun and bunx are written to the
# DISCOVERED binary path (composer.yml "Deploy composer wrapper at the
# discovered composer path", dest: {{ composer_binary_path.stdout }}). On a
# stock Ubuntu 24.04 that is /usr/bin/composer, so the probe reported "not
# deployed" for a wrapper that was installed and working. That is the same
# defect as the npm false OK, pointing the other way: a real protection
# reported as absent. Under-reporting is the safer direction, but it is still
# wrong, and a verifier that cries wolf gets ignored.
for w in npm pip pip3 bun bunx composer deno cargo; do
  have "$w" || continue
  p=$(command -v "$w" 2>/dev/null)   # what callers resolve to
  if [ -n "$p" ] && grep -q "supply-chain-hardening" "$p" 2>/dev/null; then
    # Wrappers reach the real tool two different ways, and the check must know
    # both or it cries wolf. bun/deno/composer/cargo RENAME the binary to
    # <tool>-real and exec that. npm embeds REAL_NPM='<path>'; pip/pip3 embed
    # UV='<path>'. So check the TARGET THE WRAPPER ACTUALLY EXECS — the value
    # of its REAL_*/UV assignment — not a <tool>-real file that npm/pip never
    # create. (Checking ${p}-real reported npm/pip wrappers as "refuses to run"
    # on every host, a false GAP for a working wrapper — the mirror of the old
    # composer false GAP.)
    target=$(grep -oE "^(REAL_[A-Z]+|UV)='[^']*'" "$p" 2>/dev/null | head -1 | sed "s/^[^=]*='//; s/'\$//")
    if [ -n "$target" ] && [ -x "$target" ]; then
      row WEAK PRESENT "$w PATH wrapper" "active at $p; callers bypassing PATH are unaffected"
    else
      row GAP PRESENT "$w PATH wrapper" "wrapper at $p but its real target '${target:-<none>}' is missing or not executable — the recursion guard makes it refuse to run"
    fi
  elif [ -f "/usr/local/bin/$w" ] && grep -q "supply-chain-hardening" "/usr/local/bin/$w" 2>/dev/null; then
    # Deployed, but something earlier on PATH shadows it — the wrapper exists
    # and is bypassed on every call, which reads as coverage and is not.
    row GAP PRESENT "$w PATH wrapper" "wrapper is at /usr/local/bin/$w but $w resolves to $p — the wrapper is shadowed and never runs"
  else
    row WEAK PRESENT "$w PATH wrapper" "not deployed; $w resolves to an unwrapped binary at $p"
  fi
done

# ------------------------------------------------------------ composer ------
if have composer; then
  # Composer 2.2.x prints "Composer 2.2.6 <date>"; 2.7+ prints "Composer version
  # 2.7.1 <date>". Requiring the word "version" silently failed to parse exactly
  # the OLDEST composer — the one with the largest gap — and reported
  # "could not parse" where the answer should have been "no audit blocking at
  # all". Measured on stock Ubuntu 22.04.
  cv=$(composer --version --no-plugins 2>/dev/null | sed -nE 's/.*[Cc]omposer( version)? ([0-9]+\.[0-9]+\.[0-9]+).*/\2/p' | head -1)
  cmaj=${cv%%.*}; crest=${cv#*.}; cmin=${crest%%.*}
  # Version-tiered, matching what the role renders. audit.block-* needs 2.9;
  # audit.abandoned=fail needs 2.7. Distro composer is routinely below both:
  # jammy 2.2.6, bookworm 2.5.5, noble 2.7.1.
  if [ -n "${cmaj:-}" ] && [ -n "${cmin:-}" ]; then
    if [ "$cmaj" -gt 2 ] 2>/dev/null || { [ "$cmaj" -eq 2 ] && [ "$cmin" -ge 9 ]; } 2>/dev/null; then
      row OK FUNCTIONAL "composer audit blocking" "composer $cv supports audit.block-insecure / block-abandoned"
    elif [ "$cmaj" -eq 2 ] && [ "$cmin" -ge 7 ] 2>/dev/null; then
      row GAP FUNCTIONAL "composer audit blocking" "composer $cv supports audit.abandoned=fail but NOT block-insecure/block-abandoned (needs >= 2.9); advisories do not refuse installs"
    else
      row GAP FUNCTIONAL "composer audit blocking" "composer $cv is below 2.7 — no audit blocking of any kind is available"
    fi
  else
    row WEAK PRESENT "composer audit blocking" "could not parse composer version"
  fi
fi

# ---------------------------------------------------------------- go ---------
if have go; then
  # `go env` is go's effective config, not our file.
  v=$(go env GOFLAGS 2>/dev/null)
  case "$v" in
    *-mod=readonly*)
      row OK PARSED "go module integrity" "go env GOFLAGS contains -mod=readonly" ;;
    *)
      # The role delivers GOFLAGS through /etc/profile.d + /etc/environment,
      # which only a PAM-launched or login shell loads. An empty value in a
      # docker exec / systemd / CMD context is the DOCUMENTED non-PAM gap, not
      # a misconfiguration — and saying "not configured" would send an operator
      # to fix a file that is already correct. Distinguish the two.
      if grep -qs -- "-mod=readonly" /etc/environment /etc/profile.d/*.sh 2>/dev/null; then
        row WEAK PRESENT "go module integrity" "GOFLAGS is empty in THIS process, but -mod=readonly is present in /etc/environment or /etc/profile.d — non-PAM contexts (docker exec, systemd, CMD) do not load it. Verify from a login shell."
      else
        row GAP PARSED "go module integrity" "GOFLAGS='${v:-<empty>}' and -mod=readonly is not in /etc/environment or /etc/profile.d either"
      fi ;;
  esac
  v=$(go env GONOSUMDB 2>/dev/null; go env GONOSUMCHECK 2>/dev/null)
  v2=$(go env GOPRIVATE 2>/dev/null)
  if [ -z "$v2" ]; then
    row OK PARSED "go checksum verification" "GOPRIVATE empty — sumdb checks apply to all modules"
  else
    row GAP PARSED "go checksum verification" "GOPRIVATE='$v2' exempts modules from sumdb verification"
  fi
else
  row "N/A" - "go" "go not installed"
fi

# ---------------------------------------------------------------- cargo ------
# Cargo is the one ecosystem where the config layer cannot help at all: build.rs
# and proc-macros execute at COMPILE time with the user's full privileges, and
# cargo has no --ignore-scripts. The only control that PREVENTS execution is
# refusing to resolve a too-new version, and that lives entirely in the wrapper.
#
# So this probe asks the wrapper what it actually DOES with `cargo build`,
# rather than checking that a config file exists. Checking our own config file
# and calling it enforcement is precisely the mistake that produced the npm
# false OK (5522373) and, pointing the other way, the composer false GAP.
cargo_wrapper_dispatch() {
  # Prints the argv the deployed wrapper would hand to the real cargo for
  # `cargo build` in a directory that has a lockfile. Runs the REAL wrapper
  # with a stub standing in for cargo: no network, no compile, no side effects.
  local w tmp
  w=$(command -v cargo 2>/dev/null) || return 1
  [ -n "$w" ] || return 1
  grep -q 'supply-chain-hardening' "$w" 2>/dev/null || return 1
  tmp=$(mktemp -d 2>/dev/null) || return 1
  printf '#!/bin/sh\nfor a in "$@"; do printf "%%s\\n" "$a"; done\n' > "$tmp/real"
  # Neutralise sfw for THIS probe with a pass-through stub placed first on
  # PATH. The wrapper prefixes network commands with sfw, so a broken sfw would
  # otherwise swallow the probe's output and make the verifier report "cargo is
  # not wrapped" — a false GAP on the age gate caused by an unrelated component.
  # sfw's own health is reported by its own row.
  printf '#!/bin/sh\nexec "$@"\n' > "$tmp/sfw"
  chmod +x "$tmp/real" "$tmp/sfw" 2>/dev/null
  sed "s|^REAL_CARGO=.*|REAL_CARGO='$tmp/real'|" "$w" > "$tmp/cargo" 2>/dev/null
  chmod +x "$tmp/cargo" 2>/dev/null
  : > "$tmp/Cargo.lock"
  ( cd "$tmp" && unset SUPPLY_CHAIN_CARGO_WRAPPED && PATH="$tmp:$PATH" ./cargo ${SCH_PROBE_FLAGS:-} build 2>/dev/null )
  rm -rf "$tmp"
}

# Probe a FLAG-PREFIXED invocation as well as the bare one.
#
# An earlier wrapper read the subcommand from argv[1], so `cargo -q build`
# matched no case and fell through with no controls and no warning — while this
# verifier, which probed only the bare form, reported OK. A verifier that tests
# only the happy path certifies the one invocation that works. `-q`, `--quiet`
# and `--color always` are ordinary Makefile and CI forms.
cargo_dispatch_differs() {
  local bare flagged
  bare=$(cargo_wrapper_dispatch)
  flagged=$(SCH_PROBE_FLAGS=-q cargo_wrapper_dispatch)
  [ -z "$bare" ] && return 1
  # Strip the leading global flag before comparing: `-q cooldown build` and
  # `cooldown build` are the same decision.
  flagged=$(printf '%s\n' "$flagged" | grep -vx -- '-q')
  [ "$bare" != "$flagged" ]
}

# Separate probe for the sfw hop: it cannot be read out of cargo_wrapper_dispatch
# above, because when sfw is in play IT execs the stub, so the stub's own output
# never mentions sfw. Here a stub `sfw` is put first on PATH and we observe
# whether the wrapper actually calls it.
cargo_wrapper_uses_sfw() {
  local w tmp out
  w=$(command -v cargo 2>/dev/null) || return 1
  [ -n "$w" ] || return 1
  grep -q 'supply-chain-hardening' "$w" 2>/dev/null || return 1
  tmp=$(mktemp -d 2>/dev/null) || return 1
  printf '#!/bin/sh\necho SFW-INVOKED\nexit 0\n' > "$tmp/sfw"
  printf '#!/bin/sh\nexit 0\n' > "$tmp/real"
  chmod +x "$tmp/sfw" "$tmp/real" 2>/dev/null
  sed "s|^REAL_CARGO=.*|REAL_CARGO='$tmp/real'|" "$w" > "$tmp/cargo" 2>/dev/null
  chmod +x "$tmp/cargo" 2>/dev/null
  : > "$tmp/Cargo.lock"
  out=$( cd "$tmp" && unset SUPPLY_CHAIN_CARGO_WRAPPED && PATH="$tmp:$PATH" ./cargo build 2>/dev/null )
  rm -rf "$tmp"
  printf '%s\n' "$out" | grep -q 'SFW-INVOKED'
}

if have cargo; then
  cdisp=$(cargo_wrapper_dispatch)
  if [ -n "$cdisp" ] && cargo_dispatch_differs; then
    row GAP FUNCTIONAL "cargo publish-age gate" "the wrapper treats \`cargo build\` and \`cargo -q build\` DIFFERENTLY — a global flag before the subcommand bypasses the controls. Ordinary Makefile and CI invocations are ungated"
  elif [ -z "$cdisp" ]; then
    row GAP PRESENT "cargo publish-age gate" "cargo is not wrapped — \`cargo build\` executes build.rs from whatever version the resolver picks, including one published minutes ago"
  elif printf '%s\n' "$cdisp" | grep -qx 'cooldown'; then
    cage=$(grep -m1 'global-min-publish-age' "${CARGO_HOME:-$HOME/.cargo}/cooldown.toml" 2>/dev/null | sed 's/.*= *//; s/"//g')
    # CAN THE BACKEND RUN — resolved the way the WRAPPER resolves it.
    # The wrapper prepends its embedded COOLDOWN_BIN ($CARGO_HOME/bin) to PATH
    # before dispatching, because on apt-cargo hosts cargo-cooldown is installed
    # there and that dir is NOT on PATH. Probing `cargo-cooldown` by BARE NAME
    # here reproduces the exact bug the prepend exists to fix: on apt cargo /
    # Ubuntu 26 the bare probe returned 127 and this row reported a WORKING gate
    # as "cannot execute" (measured — the behavioural signoff gated correctly on
    # the same host). So resolve it via the wrapper's COOLDOWN_BIN, and keep two
    # failure modes apart: not installed where the wrapper looks, vs installed
    # there but unable to execute (a prebuilt binary needing newer glibc than
    # the distro ships — cargo-binstall picks by target triple, which says
    # nothing about glibc; on Debian 12 the published build dies in the loader).
    cw=$(command -v cargo 2>/dev/null)
    cbin=$(grep -oE "^COOLDOWN_BIN='[^']*'" "$cw" 2>/dev/null | head -1 | sed "s/^[^=]*='//; s/'$//")
    cool=""
    for cand in "$cbin/cargo-cooldown" "${CARGO_HOME:-$HOME/.cargo}/bin/cargo-cooldown" "$(command -v cargo-cooldown 2>/dev/null)"; do
      [ -n "$cand" ] && [ -x "$cand" ] && { cool="$cand"; break; }
    done
    if [ -z "$cool" ]; then
      row GAP FUNCTIONAL "cargo publish-age gate" "the wrapper routes builds through \`cargo cooldown\`, but cargo-cooldown is not installed where the wrapper looks (${cbin:-\$CARGO_HOME/bin}). The route dead-ends, so \`cargo build\` is BROKEN, not gated. Reinstall from source: cargo install cargo-cooldown"
    elif ! "$cool" --version >/dev/null 2>&1; then
      row GAP FUNCTIONAL "cargo publish-age gate" "cargo-cooldown is installed ($cool) but CANNOT EXECUTE (usually a prebuilt binary needing newer glibc than this distro ships). The wrapper routes builds into it, so \`cargo build\` is BROKEN, not gated. Reinstall from source: cargo install cargo-cooldown"
    else
      # FUNCTIONAL covers the ROUTING plus the backend being runnable, which is
      # what we observed. Whether cargo-cooldown then honours the window is its
      # behaviour, not ours, and is deliberately not claimed here.
      row OK FUNCTIONAL "cargo publish-age gate" "wrapper routes \`cargo build\` through \`cargo cooldown\` (backend at $cool runs; window ${cage:-<unset>} per cooldown.toml; the window's own enforcement is cargo-cooldown's and is not verified here)"
    fi
  elif printf '%s\n' "$cdisp" | grep -qx -- '--locked'; then
    row WEAK FUNCTIONAL "cargo publish-age gate" "wrapper injects --locked but cargo-cooldown is absent — protects projects with a committed Cargo.lock, does nothing for \`cargo update\` or a fresh checkout with no lockfile"
  else
    row GAP FUNCTIONAL "cargo publish-age gate" "cargo is wrapped but the wrapper applied neither the cooldown route nor --locked"
  fi
  # Threat-intel layer, reported separately because it covers a DIFFERENT axis:
  # cooldown blocks by publish time and only at resolution; sfw blocks by intel
  # at download time and therefore also covers a lockfile written elsewhere.
  # Neither subsumes the other, so a single merged row would hide which half is
  # missing.
  if [ -z "$cdisp" ]; then
    :   # unwrapped; the GAP row above already says cargo is unprotected
  elif ! have sfw; then
    row GAP PRESENT "cargo threat-intel filtering" "sfw not installed — crate downloads are not filtered, so a lockfile written elsewhere pinning a known-malicious crate is fetched normally (needs Node >= 20)"
  elif ! timeout 60 sfw --help >/dev/null 2>&1; then
    # The operator's builds are failing RIGHT NOW and this row is the fastest
    # way to learn why: the wrapper prefixes cargo with sfw, so a non-runnable
    # sfw propagates its exit code out of every build. Measured exit 9.
    row GAP FUNCTIONAL "cargo threat-intel filtering" "sfw is present but CANNOT EXECUTE — the wrapper prefixes cargo with it, so EVERY cargo build on this host is failing. Set cargo_socket_firewall=false and re-apply, or remove sfw. Note sfw downloads its firewall binary from GitHub on first use; this state usually means that fetch has never succeeded"
  elif ! cargo_wrapper_uses_sfw; then
    row GAP FUNCTIONAL "cargo threat-intel filtering" "sfw is installed but the wrapper does not route cargo through it (cargo_socket_firewall=false?)"
  else
    # Deliberately WEAK, not OK. Measured: with no network sfw prints "fetch
    # failed", exits 0, and the build proceeds UNFILTERED. Presence of the
    # route is not evidence that filtering happened on any given run.
    row WEAK FUNCTIONAL "cargo threat-intel filtering" "wrapper routes cargo through sfw; note sfw FAILS OPEN — if it cannot reach Socket it warns, exits 0 and the build proceeds unfiltered"
  fi
else
  row "N/A" - "cargo" "cargo not installed"
fi

# ---------------------------------------------------------------- pip --------
if have pip3 || have pip; then
  PIPBIN=$(command -v pip3 2>/dev/null || command -v pip 2>/dev/null)
  v=$("$PIPBIN" config list 2>/dev/null | tr -d ' ')
  if printf '%s' "$v" | grep -q 'only-binary'; then
    row OK PARSED "pip source-build blocking" "pip reports only-binary in its effective config"
  else
    row GAP PARSED "pip source-build blocking" "pip config list does not report only-binary"
  fi
else
  row "N/A" - "pip" "pip not installed"
fi

# ---------------------------------------------------------------- report -----
if [ "$QUIET" -eq 0 ]; then
  echo
  echo "supply-chain-hardening — what is ACTUALLY enforcing on $(hostname)"
  echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  echo
  printf "%-6s %-11s %-32s %s\n" "STATUS" "EVIDENCE" "PROTECTION" "DETAIL"
  printf "%-6s %-11s %-32s %s\n" "------" "-----------" "--------------------------------" "------"
  printf "$ROWS" | while IFS=$'\t' read -r s e p d; do
    [ -n "$s" ] || continue
    printf "%-6s %-11s %-32s %s\n" "$s" "$e" "$p" "$d"
  done
  echo
  echo "EVIDENCE: FUNCTIONAL = observed behavior · PARSED = the tool reported the"
  echo "setting back · PRESENT = a file exists and nothing more (unverified)."
  echo
  if [ "$GAPS" -gt 0 ]; then
    echo "RESULT: $GAPS gap(s) — protections NOT in effect on this host."
  else
    echo "RESULT: no gaps."
  fi
  [ "$WEAKS" -gt 0 ] && echo "        $WEAKS row(s) verified only as PRESENT — not evidence of enforcement."
  echo
fi

[ "$GAPS" -gt 0 ] && exit 1
[ "$STRICT" -eq 1 ] && [ "$WEAKS" -gt 0 ] && exit 1
exit 0
