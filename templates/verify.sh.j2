#!/bin/bash
# /usr/local/bin/supply-chain-verify — Managed by ansible-supply-chain-security
#
# THIS FILE IS FRAGMENT 00 OF AN ASSEMBLED SCRIPT. Do not edit the deployed
# copy — tasks/verify.yml rebuilds it from three pieces, in this order:
#
#   00-context.sh   templates/verify.sh.j2         (this file)
#                   the CONTEXT PREAMBLE, the row/expectation API, and the
#                   probes that are still host-only (npm, yarn, pnpm, npq,
#                   sfw, PATH wrappers, go, pip)
#   50-probes.sh    files/verify-probes.sh         (SHARED, byte-identical
#                   with the CI surface: bun, deno, uv, composer, cargo,
#                   bundler, maven, gradle, nuget)
#   90-report.sh    templates/verify-report.sh.j2  (renderer + exit code)
#
# The shared body is plain bash with no Jinja in it, which is what lets it be
# `copy`d rather than `template`d and therefore be the SAME BYTES the CI
# surface runs. It needs exactly three things from this file: row(), have()
# and requested(). Everything else it defines itself.
#
# WHAT THIS IS FOR
#
# Every protection in this role has failed at least once in the same way: the
# config file was written correctly, the tool ignored it, and nothing said so.
#   yarn npmMinimalAgeGate: "2d"     -> parsed to NaN, gate silently absent
#   npm  MINIMUM_RELEASE_AGE         -> key npm does not read, gate absent
#   pnpm 11                          -> stopped reading rc/npmrc entirely
#   pnpm 10 block-exotic-subdeps     -> accepted the key, ignored it
#   bun  ignoreScripts               -> bunfig not loaded for `bun run`
#   npq  on Node < 20.13             -> passes through to npm, exits 0
#
# Grepping our own config files cannot catch any of these, because in every
# case the file was exactly what we intended to write. The only thing that
# catches them is asking the TOOL what it ended up believing, or watching it
# act. That is what this script does, on the real host, against the real
# installed versions.
#
# Run `supply-chain-verify --help` for the evidence taxonomy and the flags.
#
# Safe to run any time: every probe is read-only. Nothing here installs,
# fetches, or writes outside a temporary directory it removes again.

set -u

# =========================================================================
# CONTEXT PREAMBLE — the only Jinja in the verifier
# =========================================================================
#
# WHY THIS BLOCK EXISTS.
#
# A probe answers "is this protection in effect?". It cannot answer "was it
# supposed to be?", and until this block existed the verifier had no way to
# know. That produced the defect this preamble closes: a host with every PATH
# wrapper deployed and a host with none both printed "RESULT: no gaps",
# because "wrapper not deployed" was reported as WEAK and WEAK does not move
# the exit code. The verifier could see the absence and had nothing to
# compare it against.
#
# So the role renders its own INTENT here, at apply time, from the variables
# that decided what to deploy. A negative result is then either a broken
# promise (GAP) or something this host never asked for (N/A BYDESIGN), and
# those two are no longer the same row.
#
# THE ONE RULE FOR EDITING THIS BLOCK: freeze INTENT, never DISCOVERY.
# "bun_path_wrapper was true" is intent and belongs here. "bun lives at
# /root/.bun/bin/bun", "npm is 10.9.8", "GOFLAGS is set" are discovery: they
# are re-derived by the probes on every run, because this file outlives the
# apply and the host drifts underneath it. The single exception is
# SCV_WRAPPER_PATHS, which records where a wrapper was MEANT to land so the
# probe can name both halves when PATH resolves somewhere else.
#
# This is executed bash, not rendered text: $(hostname) below runs when the
# verifier runs. Only the literal string is frozen at apply time.

SCV_SCOPE_LABEL="on $(hostname)"

# When this host's intent was recorded. A stale preamble is the one failure
# mode this design introduces, so the report says how old it is out loud.
# Truncated to the DAY on purpose. A per-second timestamp changes on every
# apply, so the rendered fragment differs every run, assemble reports
# changed forever and the role is never idempotent. Same reasoning and same
# resolution as uv_exclude_newer in defaults/main.yml.
SCV_APPLIED_AT='{{ (ansible_date_time.iso8601 | default("unknown"))[:10] }}'

# The age window the role promised, in hours (defaults/main.yml:release_age_hours).
SCV_MIN_AGE_HOURS='{{ release_age_hours | default("") }}'

# 1 = SCV_EXPECT is authoritative. Always 1 on this surface: the preamble is
# rendered from the role's own variables, so a record always exists. The
# accessor below still defaults it to 0 so that the shared body keeps working
# unchanged if it is ever run without a preamble.
SCV_EXPECT_KNOWN=1

# WHAT THIS HOST PROMISED. Whitespace-separated tokens; a `!` prefix negates.
#
#   <ecosystem>      npm yarn pnpm bun pip uv go deno cargo composer
#                    bundler maven gradle nuget
#   wrapper.<tool>   a PATH wrapper the role was configured to deploy
#   tool.<name>      a protection COMPONENT (npq, sfw), not an ecosystem
#
# Ecosystem tokens are emitted unconditionally, INCLUDING on a tag-scoped
# run. That is deliberate and it is the same reasoning as tasks/main.yml's
# "Confirm full coverage" guard: `--tags npm` narrows what this run applied,
# it does not narrow what the host is expected to have. Narrowing the
# verifier from a scoped apply would let `--tags npm` quietly delete every
# other ecosystem's rows from every future run of the deployed binary.
#
# Wrapper and tool tokens come from role BOOLEANS, which are fully defined on
# every run including a scoped one, so they are exact in every run shape.
# They are deliberately NOT implied by their ecosystem token: `bun` says bun
# is expected to be hardened, `wrapper.bun` says a wrapper was requested, and
# bun_path_wrapper=false is a supported configuration.
{% set scv_expect = ['npm', 'yarn', 'pnpm', 'bun', 'pip', 'uv', 'go', 'deno',
                     'cargo', 'composer', 'bundler', 'maven', 'gradle', 'nuget'] %}
{#- npm's wrapper is deployed by socket.yml and only routes through sfw, so it
    requires BOTH switches; npm_path_wrapper alone deploys nothing. -#}
{% if (npm_path_wrapper | default(true) | bool) and (socket_firewall_install | default(true) | bool) %}
{%- set _ = scv_expect.append('wrapper.npm') %}
{% endif %}
{#- uv.yml deploys the pip -> uv redirect unconditionally wherever uv is
    found; there is no per-wrapper switch for it. -#}
{% set _ = scv_expect.append('wrapper.pip') %}
{% set _ = scv_expect.append('wrapper.pip3') %}
{% if bun_path_wrapper | default(true) | bool %}
{%- set _ = scv_expect.append('wrapper.bun') %}
{%- set _ = scv_expect.append('wrapper.bunx') %}
{% endif %}
{% if composer_path_wrapper | default(true) | bool %}
{%- set _ = scv_expect.append('wrapper.composer') %}
{% endif %}
{% if deno_path_wrapper | default(true) | bool %}
{%- set _ = scv_expect.append('wrapper.deno') %}
{% endif %}
{% if cargo_path_wrapper | default(true) | bool %}
{%- set _ = scv_expect.append('wrapper.cargo') %}
{% endif %}
{% if socket_firewall_install | default(true) | bool %}
{%- set _ = scv_expect.append('tool.sfw') %}
{% endif %}
{#- npq.yml is unconditional. -#}
{% set _ = scv_expect.append('tool.npq') %}
SCV_EXPECT='{{ scv_expect | join(" ") }}'

# Appended to every "N/A BYDESIGN" detail so a suppressed row can always be
# traced back to the decision that suppressed it.
{% set scv_scope_notes = [] %}
{% if ansible_run_tags | default(['all']) != ['all'] %}
{%- set _ = scv_scope_notes.append('this run was limited to tags ' ~ (ansible_run_tags | join(','))) %}
{% endif %}
{% if ansible_skip_tags | default([]) | length > 0 %}
{%- set _ = scv_scope_notes.append('this run skipped tags ' ~ (ansible_skip_tags | join(','))) %}
{% endif %}
SCV_EXPECT_WHY='not enabled in the role configuration for this host{% if scv_scope_notes %} ({{ scv_scope_notes | join("; ") }}, so ecosystem coverage was NOT narrowed){% endif %}'

# Which tools get a PATH-wrapper row. Surface-specific: the pip/pip3 -> uv
# redirect is a host-role deliverable and does not exist in CI.
SCV_WRAPPERS='npm pip pip3 bun bunx composer deno cargo'

# Where each wrapper was INTENDED to land, one `tool=path` per line.
# Best-effort and newline-separated so a path containing a space survives.
# This is the one piece of apply-time discovery that earns its place here:
# without it the probe cannot tell "we deployed to /usr/bin/composer and
# something shadows it" from "we never deployed a composer wrapper".
#
# composer_binary_path is a REGISTERED FACT, so it is undefined on any run
# where composer.yml did not execute (`--tags npm`, `--tags verify`, or
# composer_path_wrapper=false). It previously appeared bare at what Jinja
# treats as file scope — a `#` is a shell comment, not a Jinja one — and
# failed the DEPLOY on exactly those runs. Guarded here; never dereference a
# registered fact in this template without `| default("", true)`.
SCV_WRAPPER_PATHS='{% if npm_path_wrapper | default(true) | bool and socket_firewall_install | default(true) | bool %}npm=/usr/local/bin/npm
{% endif %}pip=/usr/local/bin/pip
pip3=/usr/local/bin/pip3
{% if composer_path_wrapper | default(true) | bool and composer_binary_path is defined %}composer={{ composer_binary_path.stdout | default("", true) | trim }}
{% endif %}'

# =========================================================================
# END OF PREAMBLE — nothing below this line is rendered from role variables
# =========================================================================

STRICT=0
QUIET=0

usage() {
  cat <<'EOF'
supply-chain-verify — what is ACTUALLY enforcing on this host

USAGE
  supply-chain-verify [--strict] [--quiet] [--help]

  --strict  also exit non-zero when a row could only be established as
            PRESENT (a protection that looks deployed but was not proven)
  --quiet   suppress the table; exit code only

EVIDENCE STRENGTH — reported per row, because it is the whole point

  FUNCTIONAL  We ran the protection and observed its behavior. Strongest.
  PARSED      The tool itself reported the setting back to us. Proves the
              tool read the file, recognized the key, and accepted the
              value — which is what every failure this script exists to
              catch violated.
  PRESENT     We only know a file or binary exists. Weakest; this is the
              evidence level that produced those bugs, so rows reporting
              it are flagged rather than counted as coverage.

STATUS
  OK        protection verified at the stated evidence strength
  GAP       the protection this host asked for is NOT in effect
  WEAK      protection looks present, but we could only establish PRESENT —
            treat as unverified, not as covered
  N/A       nothing to report. The EVIDENCE column says which kind:
              -         the tool is not installed on this host
              BYDESIGN  this host's role configuration never asked for it

  A GAP is measured against what THIS host declared, recorded at apply time
  in the context preamble at the top of this file. "Not deployed" is a GAP
  when the role was configured to deploy it and an N/A when it was not —
  before that distinction existed, a host with every wrapper and a host with
  none printed the same verdict.

EXIT CODE
  0 when there are no GAP rows, 1 otherwise. WEAK does not fail the run by
  itself — use --strict to make it.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --strict) STRICT=1 ;;
    --quiet)  QUIET=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "[supply-chain-verify] warning: unrecognised argument '$arg'" >&2 ;;
  esac
done

GAPS=0
WEAKS=0
NA_DESIGN=0
ROWS=""

row() { # status, strength, protection, detail
  ROWS="${ROWS}$1\t$2\t$3\t$4\n"
  [ "$1" = "GAP" ]  && GAPS=$((GAPS + 1))
  [ "$1" = "WEAK" ] && WEAKS=$((WEAKS + 1))
  [ "$2" = "BYDESIGN" ] && NA_DESIGN=$((NA_DESIGN + 1))
  return 0
}

have() { command -v "$1" >/dev/null 2>&1; }

# Normalise once so the substring tests below can rely on single-space
# separators and leading/trailing padding.
: "${SCV_EXPECT_KNOWN:=0}"
: "${SCV_EXPECT:=}"
: "${SCV_EXPECT_WHY:=not in the declared expectations for this surface}"
SCV_EXPECT=" $(printf '%s' "$SCV_EXPECT" | tr '\n\t' '  ' | tr -s ' ') "

# expected <token> — was this promised on this surface?
#
# Fails OPEN when there is no record (SCV_EXPECT_KNOWN=0): "we cannot tell
# what was intended" must mean "check everything", never "assume nothing was
# wanted". That is the direction in which a mistake is visible.
expected() {
  [ "$SCV_EXPECT_KNOWN" -eq 1 ] || return 0
  case "$SCV_EXPECT" in *" !$1 "*) return 1 ;; esac
  case "$SCV_EXPECT" in *" $1 "*)  return 0 ;; esac
  # An ecosystem token covers its dotted children: `cargo` implies
  # `cargo.age-gate`. It does NOT imply `wrapper.cargo`, whose prefix is
  # `wrapper` — wrapper intent is a separate switch and stays separate.
  case "$SCV_EXPECT" in *" ${1%%.*} "*) return 0 ;; esac
  return 1
}

# requested <ecosystem> — the name the SHARED probe body calls. Same
# question, and the body asks it only about ecosystems.
#
# Note this is new on the host surface. Before it existed, the shared body's
# `requested composer` call resolved to "command not found" (rc 127), which
# reads as "not requested" and silently deleted the whole composer block from
# every host report.
requested() { expected "$1"; }

# The BYDESIGN half of the truth table. Never used for a tool that is merely
# absent — that is `row "N/A" - ...` and means something different.
na_design() { # protection, detail
  row "N/A" BYDESIGN "$1" "$2 — not required here: $SCV_EXPECT_WHY"
}

# Does npm actually IMPLEMENT a config key, or is it merely echoing our file
# back at us?
#
# This distinction cost a false OK in this very script. `npm config get <key>`
# returns whatever is in the config for ANY key, implemented or not:
#
#   $ echo 'this-key-does-not-exist=hello' >> ~/.npmrc
#   $ npm config get this-key-does-not-exist
#   hello
#
# So a value coming back proves npm READ the file — not that npm honors the
# key. On npm 10.9.8, `npm config get min-release-age` happily returns our
# value while npm has no such feature (it landed in 11.10.0). That is the same
# silently-ignored-setting failure the whole script exists to catch, reproduced
# inside the detector.
#
# The discriminator: ask npm with our config and env stripped away. A key npm
# implements has a built-in default; a key it does not know returns
# "undefined" even though our file sets it.
npm_implements() {
  local key="$1" tmp v
  tmp=$(mktemp -d 2>/dev/null) || return 1
  : > "$tmp/u"; : > "$tmp/g"
  # env -i also drops NPM_CONFIG_*, which otherwise supplies the value and
  # recreates the exact false positive.
  v=$(env -i PATH="$PATH" HOME="$tmp" npm config get "$key" \
        --userconfig="$tmp/u" --globalconfig="$tmp/g" 2>/dev/null | head -1 | tr -d '\r')
  rm -rf "$tmp"
  [ -n "$v" ] && [ "$v" != "undefined" ]
}

# ---------------------------------------------------------------- npm --------
if have npm; then
  # `npm config get` is npm's own view after merging every config source. If it
  # disagrees with our file, npm did not honor our file.
  if ! npm_implements ignore-scripts; then
    row GAP FUNCTIONAL "npm lifecycle scripts blocked" "npm $(npm --version 2>/dev/null) does not implement ignore-scripts"
  else
    v=$(npm config get ignore-scripts 2>/dev/null | tr -d '\r')
    if [ "$v" = "true" ]; then
      row OK PARSED "npm lifecycle scripts blocked" "npm implements ignore-scripts and reports true"
    else
      row GAP PARSED "npm lifecycle scripts blocked" "npm reports ignore-scripts=${v:-<unset>}"
    fi
  fi

  # The age gate needs BOTH checks, and the implementation check comes first.
  # npm echoes back keys it does not implement, so the value alone is not
  # evidence — see npm_implements() above.
  nv=$(npm --version 2>/dev/null)
  if ! npm_implements min-release-age; then
    row GAP FUNCTIONAL "npm age gate" "npm $nv does NOT implement min-release-age (added in npm 11.10.0). Our config sets it and npm echoes it back, but nothing enforces it."
  else
    v=$(npm config get min-release-age 2>/dev/null | tr -d '\r')
    case "$v" in
      ''|null|undefined) row GAP PARSED "npm age gate" "npm implements min-release-age but reports no value" ;;
      *[!0-9]*)          row GAP PARSED "npm age gate" "npm reports non-numeric min-release-age='$v'" ;;
      0)                 row GAP PARSED "npm age gate" "min-release-age=0 disables the gate" ;;
      *)                 row OK  PARSED "npm age gate" "npm $nv implements min-release-age and reports $v day(s)" ;;
    esac
  fi
else
  row "N/A" - "npm" "npm not installed"
fi

# ---------------------------------------------------------------- yarn -------
if have yarn; then
  yv=$(yarn --version 2>/dev/null)
  case "$yv" in
    1.*)
      # Yarn classic never reads .yarnrc.yml, so none of our yarn hardening
      # applies. Silent today; reported here.
      row GAP FUNCTIONAL "yarn hardening" "yarn $yv is classic and ignores .yarnrc.yml entirely" ;;
    *)
      # The "2d" bug: yarn accepted the file, parsed the value to NaN, and
      # applied no gate. Asking yarn for the value is what exposes that.
      v=$(yarn config get npmMinimalAgeGate 2>/dev/null | tr -d '\r' | tr -d ' ')
      case "$v" in
        ''|undefined|null)
          row GAP PARSED "yarn age gate" "yarn does not report npmMinimalAgeGate (needs yarn >= 4.10; found $yv)" ;;
        *[!0-9]*)
          row GAP PARSED "yarn age gate" "yarn reports non-integer npmMinimalAgeGate='$v' (this is the NaN failure)" ;;
        0)
          row GAP PARSED "yarn age gate" "npmMinimalAgeGate=0 disables the gate" ;;
        *)
          row OK PARSED "yarn age gate" "yarn reports npmMinimalAgeGate=$v minutes" ;;
      esac
      v=$(yarn config get enableScripts 2>/dev/null | tr -d '\r' | tr -d ' ')
      if [ "$v" = "false" ]; then
        row OK PARSED "yarn lifecycle scripts blocked" "yarn reports enableScripts=false"
      else
        row GAP PARSED "yarn lifecycle scripts blocked" "yarn reports enableScripts=${v:-<unset>}"
      fi
      ;;
  esac
else
  row "N/A" - "yarn" "yarn not installed"
fi

# ---------------------------------------------------------------- pnpm -------
if have pnpm; then
  pv=$(pnpm --version 2>/dev/null)
  pmaj=${pv%%.*}
  if [ -n "$pmaj" ] && [ "$pmaj" -ge 11 ] 2>/dev/null; then
    row OK FUNCTIONAL "pnpm exotic-dep blocking" "pnpm $pv enforces blockExoticSubdeps"
  else
    # No pnpm 10 config key enforces this — verified against 10.34.5, which
    # went to DNS for a tarball dep.
    row GAP FUNCTIONAL "pnpm exotic-dep blocking" "pnpm $pv cannot enforce blockExoticSubdeps (needs >= 11); no config key changes this"
  fi
  # DELIBERATELY WEAKER THAN THE npm ROW. pnpm is known to accept config keys
  # it does not implement and silently ignore them — that is precisely how
  # block-exotic-subdeps behaved on 10.34.5. So a value echoed back by
  # `pnpm config get` proves pnpm read the file and nothing more, and there is
  # no pnpm equivalent of the npm_implements() discriminator (pnpm has no
  # documented way to ask "do you know this key"). Reporting OK here would
  # repeat the npm false positive, so a good-looking value caps out at WEAK.
  v=$(pnpm config get minimum-release-age 2>/dev/null | tr -d '\r' | tr -d ' ')
  case "$v" in
    ''|undefined|null) row GAP  PRESENT "pnpm age gate" "pnpm did not report minimum-release-age back" ;;
    *[!0-9]*)          row GAP  PARSED  "pnpm age gate" "pnpm reports non-numeric minimum-release-age='$v'" ;;
    0)                 row GAP  PARSED  "pnpm age gate" "minimum-release-age=0 disables the gate" ;;
    *)                 row WEAK PRESENT "pnpm age gate" "pnpm echoes minimum-release-age=$v, but pnpm echoes unimplemented keys too — not proof of enforcement" ;;
  esac
else
  row "N/A" - "pnpm" "pnpm not installed"
fi

# ------------------------------------------------- npq (reputation layer) ----
# The layer that addresses slopsquatting — an attacker pre-registering a
# plausible name an agent might guess. An age gate does nothing against a squat
# registered months ago; this is what catches it. It also fails OPEN: below
# Node 20.13.0 it warns, runs the real package manager, and exits 0.
#
# npq is a protection COMPONENT, not an ecosystem, so "not installed" is a
# broken promise rather than "nothing to protect" — provided it was promised.
if have npq-hero; then
  out=$(npq-hero --version 2>&1)
  if printf '%s' "$out" | grep -qi 'npq suppressed'; then
    row GAP FUNCTIONAL "npq reputation checks" "npq is installed but SUPPRESSED on Node $(node --version 2>/dev/null); it passes through to npm and exits 0"
  else
    row OK FUNCTIONAL "npq reputation checks" "npq responds normally (not suppressed)"
  fi
elif expected tool.npq; then
  row GAP PRESENT "npq reputation checks" "npq-hero not installed — no pre-install reputation checking"
else
  na_design "npq reputation checks" "npq-hero not installed"
fi

# ------------------------------------------------- sfw (reputation layer) ----
if have sfw; then
  if sfw --version >/dev/null 2>&1; then
    row OK FUNCTIONAL "Socket Firewall" "sfw responds to --version"
  else
    row GAP FUNCTIONAL "Socket Firewall" "sfw is on PATH but does not execute successfully"
  fi
elif expected tool.sfw; then
  row GAP PRESENT "Socket Firewall" "sfw not installed — npm installs are not threat-intel filtered"
else
  na_design "Socket Firewall" "sfw not installed (socket_firewall_install=false)"
fi

# ------------------------------------------------------- PATH wrappers -------
# Wrappers are the weakest evidence class in the whole role: existence proves
# nothing about whether callers resolve through them.
#
# CHECK THE PATH CALLERS ACTUALLY HIT, NOT A FIXED DIRECTORY.
# An earlier version of this loop only looked in /usr/local/bin. But only npm
# and pip/pip3 deploy there — composer, deno, bun and bunx are written to the
# DISCOVERED binary path. On a stock Ubuntu 24.04 that is /usr/bin/composer, so
# the probe reported "not deployed" for a wrapper that was installed and
# working. That is the same defect as the npm false OK, pointing the other way:
# a real protection reported as absent. Under-reporting is the safer direction,
# but it is still wrong, and a verifier that cries wolf gets ignored.
#
# AND THE OTHER HALF, WHICH IS THE ONE THE PREAMBLE FIXED. "Not deployed" used
# to be WEAK, which does not move the exit code, so a host with every wrapper
# and a host with none both printed "RESULT: no gaps". It is now measured
# against SCV_EXPECT: a GAP when the role was configured to deploy it, an
# N/A BYDESIGN when it was not.

# Where a wrapper for this tool was MEANT to go, per the preamble. Empty when
# the role deploys it to a path only discovered at apply time.
scv_intended_path() { # tool
  printf '%s\n' "$SCV_WRAPPER_PATHS" | sed -n "s|^$1=||p" | head -1
}

# Find a deployed wrapper for this tool ANYWHERE a caller could have it, not
# just where the tool currently resolves from. A shadowed wrapper is by
# definition not on the resolved path, so looking only there reports it as
# "never deployed" — the wrong diagnosis, pointing at the wrong fix.
#
# The marker is "supply-chain-harden", a substring of both this role's
# "supply-chain-hardening" and the CI action's "supply-chain-harden action",
# so one probe recognises a wrapper from either surface.
locate_wrapper() { # tool
  local w="$1" d ip
  local -a dirs
  IFS=: read -ra dirs <<< "$PATH"
  for d in "${dirs[@]}"; do
    [ -n "$d" ] || continue
    if [ -f "$d/$w" ] && grep -q "supply-chain-harden" "$d/$w" 2>/dev/null; then
      printf '%s\n' "$d/$w"; return 0
    fi
  done
  ip=$(scv_intended_path "$w")
  if [ -n "$ip" ] && [ -f "$ip" ] && grep -q "supply-chain-harden" "$ip" 2>/dev/null; then
    printf '%s\n' "$ip"; return 0
  fi
  return 1
}

for w in $SCV_WRAPPERS; do
  if ! have "$w"; then
    # The SUBJECT tool is absent, so there is nothing for a wrapper to wrap.
    # This is the one wrapper outcome that is N/A regardless of intent.
    row "N/A" - "$w PATH wrapper" "$w not installed"
    continue
  fi
  p=$(command -v "$w" 2>/dev/null)   # what callers resolve to
  if [ -n "$p" ] && grep -q "supply-chain-harden" "$p" 2>/dev/null; then
    # Wrappers reach the real tool two different ways, and the check must know
    # both or it cries wolf. bun/deno/composer/cargo RENAME the binary to
    # <tool>-real and exec that. npm embeds REAL_NPM='<path>'; pip/pip3 embed
    # UV='<path>'. So check the TARGET THE WRAPPER ACTUALLY EXECS — the value
    # of its REAL_*/UV assignment — not a <tool>-real file that npm/pip never
    # create. (Checking ${p}-real reported npm/pip wrappers as "refuses to run"
    # on every host, a false GAP for a working wrapper — the mirror of the old
    # composer false GAP.)
    target=$(grep -oE "^(REAL_[A-Z]+|UV)='[^']*'" "$p" 2>/dev/null | head -1 | sed "s/^[^=]*='//; s/'\$//")
    if [ -n "$target" ] && [ -x "$target" ]; then
      # WEAK, not OK, and deliberately so: nothing here EXECUTED the wrapper.
      # We know PATH resolves to it and that its exec target exists. That is
      # PRESENT evidence, and this file's own rule is that PRESENT evidence is
      # flagged rather than counted as coverage.
      row WEAK PRESENT "$w PATH wrapper" "active at $p; callers bypassing PATH are unaffected"
    else
      row GAP PRESENT "$w PATH wrapper" "wrapper at $p but its real target '${target:-<none>}' is missing or not executable — the recursion guard makes it refuse to run"
    fi
  elif shadow=$(locate_wrapper "$w"); then
    # Deployed, but something earlier on PATH shadows it — the wrapper exists
    # and is bypassed on every call, which reads as coverage and is not. A GAP
    # regardless of intent: we found our own artifact being ignored.
    row GAP PRESENT "$w PATH wrapper" "wrapper is at $shadow but $w resolves to $p — the wrapper is shadowed and never runs"
  elif expected "wrapper.$w"; then
    row GAP PRESENT "$w PATH wrapper" "not deployed; $w resolves to an unwrapped binary at $p"
  else
    na_design "$w PATH wrapper" "not deployed; $w resolves to an unwrapped binary at $p"
  fi
done

# ---------------------------------------------------------------- go ---------
if have go; then
  # `go env` is go's effective config, not our file.
  v=$(go env GOFLAGS 2>/dev/null)
  case "$v" in
    *-mod=readonly*)
      row OK PARSED "go module integrity" "go env GOFLAGS contains -mod=readonly" ;;
    *)
      # The role delivers GOFLAGS through /etc/profile.d + /etc/environment,
      # which only a PAM-launched or login shell loads. An empty value in a
      # docker exec / systemd / CMD context is the DOCUMENTED non-PAM gap, not
      # a misconfiguration — and saying "not configured" would send an operator
      # to fix a file that is already correct. Distinguish the two.
      if grep -qs -- "-mod=readonly" /etc/environment /etc/profile.d/*.sh 2>/dev/null; then
        row WEAK PRESENT "go module integrity" "GOFLAGS is empty in THIS process, but -mod=readonly is present in /etc/environment or /etc/profile.d — non-PAM contexts (docker exec, systemd, CMD) do not load it. Verify from a login shell."
      else
        row GAP PARSED "go module integrity" "GOFLAGS='${v:-<empty>}' and -mod=readonly is not in /etc/environment or /etc/profile.d either"
      fi ;;
  esac
  v2=$(go env GOPRIVATE 2>/dev/null)
  if [ -z "$v2" ]; then
    row OK PARSED "go checksum verification" "GOPRIVATE empty — sumdb checks apply to all modules"
  else
    row GAP PARSED "go checksum verification" "GOPRIVATE='$v2' exempts modules from sumdb verification"
  fi
else
  row "N/A" - "go" "go not installed"
fi

# ---------------------------------------------------------------- pip --------
if have pip3 || have pip; then
  PIPBIN=$(command -v pip3 2>/dev/null || command -v pip 2>/dev/null)
  v=$("$PIPBIN" config list 2>/dev/null | tr -d ' ')
  if printf '%s' "$v" | grep -q 'only-binary'; then
    row OK PARSED "pip source-build blocking" "pip reports only-binary in its effective config"
  else
    row GAP PARSED "pip source-build blocking" "pip config list does not report only-binary"
  fi
else
  row "N/A" - "pip" "pip not installed"
fi

