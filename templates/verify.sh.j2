#!/bin/bash
# /usr/local/bin/supply-chain-verify — Managed by ansible-supply-chain-security
#
# THIS FILE IS FRAGMENT 00 OF AN ASSEMBLED SCRIPT. Do not edit the deployed
# copy — tasks/verify.yml rebuilds it from three pieces, in this order:
#
#   00-context.sh   templates/verify.sh.j2         (this file)
#                   the CONTEXT PREAMBLE, the row/expectation API, and the
#                   probes that are still host-only (npm, npq,
#                   sfw, PATH wrappers, go GOFLAGS, pip)
#   50-probes.sh    files/verify-probes.sh         (SHARED, byte-identical
#                   with the CI surface: yarn, pnpm, bun, deno, uv, pip age gates,
#                   go checksum db + toolchain, composer, cargo, bundler,
#                   maven, gradle, nuget)
#   90-report.sh    templates/verify-report.sh.j2  (renderer + exit code)
#
# The shared body is plain bash with no Jinja in it, which is what lets it be
# `copy`d rather than `template`d and therefore be the SAME BYTES the CI
# surface runs. It needs exactly three things from this file: row(), have()
# and requested(). Everything else it defines itself.
#
# WHAT THIS IS FOR
#
# Every protection in this role has failed at least once in the same way: the
# config file was written correctly, the tool ignored it, and nothing said so.
#   yarn npmMinimalAgeGate: "2d"     -> 2 MINUTES on yarn 4.10.x, gate effectively absent
#   npm  MINIMUM_RELEASE_AGE         -> key npm does not read, gate absent
#   pnpm 11                          -> stopped reading rc/npmrc entirely
#   pnpm < 10.26 block-exotic-subdeps -> accepted the key, ignored it
#   bun  ignoreScripts               -> bunfig not loaded for `bun run`
#   npq  on Node < 20.13             -> passes through to npm, exits 0
#
# Grepping our own config files cannot catch any of these, because in every
# case the file was exactly what we intended to write. The only thing that
# catches them is asking the TOOL what it ended up believing, or watching it
# act. That is what this script does, on the real host, against the real
# installed versions.
#
# Run `supply-chain-verify --help` for the evidence taxonomy and the flags.
#
# Safe to run any time: every probe is read-only. Nothing here installs,
# fetches, or writes outside a temporary directory it removes again.

set -u

# The caller's PATH and HOME, saved before anything below changes them: go
# discovery and the shared body's discover() prepend directories to PATH, and
# the rows about this shell ("shell reachability") compare against what a bare
# command finds here. tests/ci/16-verify-reach.bats checks both preambles.
SCV_CALLER_PATH=${PATH-}
SCV_CALLER_HOME=${HOME-}
# 1 only for the role's own run at the end of an apply (--apply-run, below):
# never taken from the environment ("shell reachability").
SCV_APPLY_RUN=0

# =========================================================================
# CONTEXT PREAMBLE — the only Jinja in the verifier
# =========================================================================
#
# WHY THIS BLOCK EXISTS.
#
# A probe answers "is this protection in effect?". It cannot answer "was it
# supposed to be?", and until this block existed the verifier had no way to
# know. That produced the defect this preamble closes: a host with every PATH
# wrapper deployed and a host with none both printed "RESULT: no gaps",
# because "wrapper not deployed" was reported as WEAK and WEAK does not move
# the exit code. The verifier could see the absence and had nothing to
# compare it against.
#
# So the role renders its own INTENT here, at apply time, from the variables
# that decided what to deploy. A negative result is then either a broken
# promise (GAP) or something this host never asked for (N/A BYDESIGN), and
# those two are no longer the same row.
#
# THE ONE RULE FOR EDITING THIS BLOCK: freeze INTENT, never DISCOVERY.
# "bun_path_wrapper was true" is intent and belongs here. "bun lives at
# /root/.bun/bin/bun", "npm is 10.9.8", "GOFLAGS is set" are discovery: they
# are re-derived by the probes on every run, because this file outlives the
# apply and the host drifts underneath it. The single exception is
# SCV_WRAPPER_PATHS, which records where a wrapper was MEANT to land so the
# probe can name both halves when PATH resolves somewhere else.
#
# This is executed bash, not rendered text: $(hostname) below runs when the
# verifier runs. Only the literal string is frozen at apply time.

# Which delivery path deployed this host. The shared probe body reads it to
# word a remediation for THIS path ("re-apply the role" here, "re-run
# action/harden.sh" in CI); action/verify.sh declares SCV_SURFACE=ci.
# shellcheck disable=SC2034  # read by the shared probe body
SCV_SURFACE=role
SCV_SCOPE_LABEL="on $(hostname)"

# When this host's intent was recorded. A stale preamble is the one failure
# mode this design introduces, so the report says how old it is out loud.
# Truncated to the DAY on purpose. A per-second timestamp changes on every
# apply, so the rendered fragment differs every run, assemble reports
# changed forever and the role is never idempotent. Same reasoning and same
# resolution as uv_exclude_newer in defaults/main.yml.
SCV_APPLIED_AT='{{ (ansible_date_time.iso8601 | default("unknown"))[:10] }}'

# The age window the role promised, in hours (defaults/main.yml:release_age_hours).
SCV_MIN_AGE_HOURS='{{ release_age_hours | default("") }}'

# 1 = SCV_EXPECT is authoritative. Always 1 on this surface: the preamble is
# rendered from the role's own variables, so a record always exists. The
# accessor below still defaults it to 0 so that the shared body keeps working
# unchanged if it is ever run without a preamble.
SCV_EXPECT_KNOWN=1

# WHAT THIS HOST PROMISED. Whitespace-separated tokens; a `!` prefix negates.
#
#   <ecosystem>      npm yarn pnpm bun pip uv go deno cargo composer
#                    bundler maven gradle nuget
#   wrapper.<tool>   a PATH wrapper the role was configured to deploy
#   tool.<name>      a protection COMPONENT (npq, sfw), not an ecosystem
#
# Ecosystem tokens are emitted unconditionally, INCLUDING on a tag-scoped
# run. That is deliberate and it is the same reasoning as tasks/main.yml's
# "Confirm full coverage" guard: `--tags npm` narrows what this run applied,
# it does not narrow what the host is expected to have. Narrowing the
# verifier from a scoped apply would let `--tags npm` quietly delete every
# other ecosystem's rows from every future run of the deployed binary.
#
# Wrapper and tool tokens come from role BOOLEANS, which are fully defined on
# every run including a scoped one, so they are exact in every run shape.
# They are deliberately NOT implied by their ecosystem token: `bun` says bun
# is expected to be hardened, `wrapper.bun` says a wrapper was requested, and
# bun_path_wrapper=false is a supported configuration.
{% set scv_expect = ['npm', 'yarn', 'pnpm', 'bun', 'pip', 'uv', 'go', 'deno',
                     'cargo', 'composer', 'bundler', 'maven', 'gradle', 'nuget'] %}
{#- npm's wrapper is deployed by socket.yml and only routes through sfw, so it
    requires BOTH switches; npm_path_wrapper alone deploys nothing. -#}
{% if (npm_path_wrapper | default(true) | bool) and (socket_firewall_install | default(true) | bool) %}
{%- set _ = scv_expect.append('wrapper.npm') %}
{% endif %}
{#- uv.yml deploys the pip -> uv redirect unconditionally wherever uv is
    found; there is no per-wrapper switch for it. -#}
{% set _ = scv_expect.append('wrapper.pip') %}
{% set _ = scv_expect.append('wrapper.pip3') %}
{% if bun_path_wrapper | default(true) | bool %}
{%- set _ = scv_expect.append('wrapper.bun') %}
{%- set _ = scv_expect.append('wrapper.bunx') %}
{% endif %}
{% if composer_path_wrapper | default(true) | bool %}
{%- set _ = scv_expect.append('wrapper.composer') %}
{% endif %}
{% if deno_path_wrapper | default(true) | bool %}
{%- set _ = scv_expect.append('wrapper.deno') %}
{% endif %}
{% if cargo_path_wrapper | default(true) | bool %}
{%- set _ = scv_expect.append('wrapper.cargo') %}
{% endif %}
{% if socket_firewall_install | default(true) | bool %}
{%- set _ = scv_expect.append('tool.sfw') %}
{% endif %}
{#- npq.yml is unconditional. -#}
{% set _ = scv_expect.append('tool.npq') %}
{#- python_safe_path is opt-in and defaults false, so the token is only present
    when the operator asked for it. Without it the row reports N/A BYDESIGN
    rather than a GAP nobody can action by re-running the role. -#}
{% if python_safe_path | default(false) | bool %}
{%- set _ = scv_expect.append('python.safepath') %}
{% endif %}
SCV_EXPECT='{{ scv_expect | join(" ") }}'

# Appended to every "N/A BYDESIGN" detail so a suppressed row can always be
# traced back to the decision that suppressed it.
{% set scv_scope_notes = [] %}
{#- Sorted: Ansible hands the tags over as a set, so their order changes from run
    to run (MEASURED on 6c77f4e: three applies with the same --tags rendered
    three orders), and this fragment then changed, with the assembled verifier,
    on a re-apply that changed nothing. -#}
{% if ansible_run_tags | default(['all']) != ['all'] %}
{%- set _ = scv_scope_notes.append('this run was limited to tags ' ~ (ansible_run_tags | sort | join(','))) %}
{% endif %}
{% if ansible_skip_tags | default([]) | length > 0 %}
{%- set _ = scv_scope_notes.append('this run skipped tags ' ~ (ansible_skip_tags | sort | join(','))) %}
{% endif %}
SCV_EXPECT_WHY='not enabled in the role configuration for this host{% if scv_scope_notes %} ({{ scv_scope_notes | join("; ") }}, so ecosystem coverage was NOT narrowed){% endif %}'

# The packages the role lets build under pnpm (pnpm_built_dependencies). With any,
# pnpm reports ignore-scripts=false on purpose, and the pnpm row says why.
SCV_PNPM_BUILT_DEPS='{{ pnpm_built_dependencies | default([], true) | join(",") | regex_replace("[^A-Za-z0-9@_./,-]", "") }}'

# Which tools get a PATH-wrapper row. Surface-specific: the pip/pip3 -> uv
# redirect is a host-role deliverable and does not exist in CI.
SCV_WRAPPERS='npm pip pip3 bun bunx composer deno cargo'

# Where each wrapper was INTENDED to land, one `tool=path` per line.
# Best-effort and newline-separated so a path containing a space survives.
# This is the one piece of apply-time discovery that earns its place here:
# without it the probe cannot tell "we deployed to /usr/bin/composer and
# something shadows it" from "we never deployed a composer wrapper".
#
# composer_binary_path is a REGISTERED FACT, so it is undefined on any run
# where composer.yml did not execute (`--tags npm`, `--tags verify`, or
# composer_path_wrapper=false). It previously appeared bare at what Jinja
# treats as file scope — a `#` is a shell comment, not a Jinja one — and
# failed the DEPLOY on exactly those runs. Guarded here; never dereference a
# registered fact in this template without `| default("", true)`.
SCV_WRAPPER_PATHS='{% if npm_path_wrapper | default(true) | bool and socket_firewall_install | default(true) | bool %}npm=/usr/local/bin/npm
{% endif %}pip=/usr/local/bin/pip
pip3=/usr/local/bin/pip3
{% if composer_path_wrapper | default(true) | bool and composer_binary_path is defined %}composer={{ composer_binary_path.stdout | default("", true) | trim }}
{% endif %}'

# =========================================================================
# END OF PREAMBLE — nothing below this line is rendered from role variables
# =========================================================================

# Where a row's doc pointer leads. The role deploys no docs to the host, so a
# repo-relative path pointed nowhere. Nothing records which release of the role
# rendered this file, so this is the main branch, not a tag.
SCV_DOCS_URL="https://github.com/echennells/supply-chain-hardening/blob/main"

STRICT=0
QUIET=0
VERBOSE=0
JSON=0

usage() {
  cat <<'EOF'
supply-chain-verify — what is ACTUALLY enforcing on this host

USAGE
  supply-chain-verify [--strict] [--verbose] [--json] [--quiet] [--help]
                      [--apply-run]

  --strict   also exit non-zero on any WEAK row: a protection that looks
             deployed but was only established as PRESENT, or one in effect
             with a caveat the row states
  --verbose  show the full rationale for each row. The default prints a
             one-line summary per row so the table is scannable; -v is an alias
  --json     emit the rows and result as JSON instead of the table — the shape
             a CI pre-install gate consumes. The exit code is unchanged
             (non-zero when any protection is a GAP), so `supply-chain-verify
             --json` doubles as the gate itself. The result counts every
             status and lists tools_seen: an empty tools_seen means no
             package manager was checked, whatever "gaps" says
  --quiet    suppress the table; exit code only
  --apply-run  the role's own run at the end of an apply: ansible's process,
             not a shell anyone works in, so the env layer row is N/A and
             the "on this shell's PATH" rows are left out. Not for a person

EVIDENCE STRENGTH — reported per row, because it is the whole point

  FUNCTIONAL  We ran the protection and observed its behavior. Strongest.
  PARSED      The tool itself reported the setting back to us. Proves the
              tool read the file, recognized the key, and accepted the
              value — which is what every failure this script exists to
              catch violated.
  PRESENT     We only know a file or binary exists. Weakest; this is the
              evidence level that produced those bugs, so rows reporting
              it are flagged rather than counted as coverage.

STATUS
  OK        protection verified at the stated evidence strength
  GAP       the protection this host asked for is NOT in effect
  WEAK      not counted as coverage: either the protection looks present
            but we could only establish PRESENT, or the tool reported or showed
            it in effect with a caveat the row names (a stale cutoff, a narrow
            exemption, a default that proves nothing). Treat as unverified
  N/A       nothing to report. The EVIDENCE column says which kind:
              -         nothing here to check: the tool is not installed, or
                        what the row looks for (a project config) is not here
              BYDESIGN  this host's role configuration never asked for it

  A GAP is measured against what THIS host declared, recorded at apply time
  in the context preamble at the top of this file. "Not deployed" is a GAP
  when the role was configured to deploy it and an N/A when it was not —
  before that distinction existed, a host with every wrapper and a host with
  none printed the same verdict.

EXIT CODE
  0 when there are no GAP rows, 1 otherwise. WEAK does not fail the run by
  itself — use --strict to make it.
EOF
}

for arg in "$@"; do
  case "$arg" in
    --strict) STRICT=1 ;;
    --quiet)  QUIET=1 ;;
    --verbose|-v) VERBOSE=1 ;;
    --json)   JSON=1 ;;
    --apply-run) SCV_APPLY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "[supply-chain-verify] warning: unrecognised argument '$arg'" >&2 ;;
  esac
done

GAPS=0
WEAKS=0
WEAK_PRESENT=0   # the WEAK rows whose evidence is only PRESENT; the footer reports both
NA_DESIGN=0
ROWS=""

# One field of a row, made safe for the renderer. The report prints ROWS with
# printf '%b', which expands backslash escapes, and details carry text this script
# does not control: a config value read from the working directory, a file name a
# package chose. MEASURED: `min-release-age=1\c` in a checkout's .npmrc ended the
# table at that row, and a file named with `\n` and `\t` in it forged whole rows,
# in the table and in --json alike. Doubling every backslash makes %b print it
# literally; real control characters are flattened so a tab or newline cannot
# split a row either. Sets REPLY, to stay out of a subshell.
scv_field() {
  REPLY=${1//[[:cntrl:]]/ }
  REPLY=${REPLY//\\/\\\\}
}

row() { # status, strength, protection, detail
  local s e p d
  scv_field "$1"; s=$REPLY
  scv_field "$2"; e=$REPLY
  scv_field "$3"; p=$REPLY
  scv_field "$4"; d=$REPLY
  ROWS="${ROWS}${s}\t${e}\t${p}\t${d}\n"
  [ "$s" = "GAP" ]  && GAPS=$((GAPS + 1))
  [ "$s" = "WEAK" ] && WEAKS=$((WEAKS + 1))
  [ "$s" = "WEAK" ] && [ "$e" = "PRESENT" ] && WEAK_PRESENT=$((WEAK_PRESENT + 1))
  [ "$e" = "BYDESIGN" ] && NA_DESIGN=$((NA_DESIGN + 1))
  return 0
}

have() { command -v "$1" >/dev/null 2>&1; }

# >>> run_bounded
# run_bounded <seconds> <command> [args...]: runs the command, stopped after
# <seconds>: timeout(1) where it exists, then gtimeout (Homebrew coreutils),
# then a background-and-kill fallback. Stock macOS has neither, and a missing
# bound must turn into neither a missing command nor a hang. Returns the
# command's status, or 124 when it was stopped, as timeout(1) does. Variables
# assigned on the call (`VAR=x run_bounded ...`) reach the command. Like
# timeout(1), which signals its whole process group, the fallback stops what
# the command started as well (found with pgrep), so a child left holding a
# $( ) open cannot keep the hang going. The same block is in action/harden.sh,
# action/verify.sh and templates/verify.sh.j2; tests/ci/07-verify.bats checks
# that they match.
run_bounded() {
  local _rb_secs="$1" _rb_pid _rb_w _rb_rc=0 _rb_t0="$SECONDS"
  shift
  if command -v timeout >/dev/null 2>&1; then timeout "$_rb_secs" "$@"; return; fi
  if command -v gtimeout >/dev/null 2>&1; then gtimeout "$_rb_secs" "$@"; return; fi
  "$@" &
  _rb_pid=$!
  # The watcher writes nowhere: inside $( ), an inherited stdout would hold
  # the substitution open until the watcher's own sleep ended.
  ( _rb_n=0
    while kill -0 "$_rb_pid" 2>/dev/null; do
      if [ "$_rb_n" -ge "$_rb_secs" ]; then
        _rb_all=$_rb_pid _rb_q=$_rb_pid
        while _rb_q=$(pgrep -P "$(echo $_rb_q | tr ' ' ',')" 2>/dev/null | tr '\n' ' ') \
              && [ -n "${_rb_q%% }" ]; do
          _rb_all="$_rb_all $_rb_q"
        done
        kill -TERM $_rb_all 2>/dev/null || true
        sleep 2
        kill -KILL $_rb_all 2>/dev/null || true
        exit 0
      fi
      sleep 1
      _rb_n=$((_rb_n + 1))
    done ) >/dev/null 2>&1 &
  _rb_w=$!
  # 2>/dev/null: bash 3.2 reports the stopped job ("Terminated") here.
  wait "$_rb_pid" 2>/dev/null || _rb_rc=$?
  kill "$_rb_w" 2>/dev/null || true
  wait "$_rb_w" 2>/dev/null || true
  if [ "$_rb_rc" -gt 128 ] && [ $((SECONDS - _rb_t0)) -ge "$_rb_secs" ]; then
    return 124
  fi
  return "$_rb_rc"
}
# <<< run_bounded

# >>> no project code
# BYTE-IDENTICAL in templates/verify.sh.j2 and action/verify.sh, from the line
# above to the matching <<< line (tests/ci/07-verify.bats compares them).
#
# THE VERIFIER NEVER RUNS CODE A CHECKOUT SUPPLIES. AGENTS.md says to run it
# from inside a project too, and that may be a repo nobody has reviewed. Tools
# read files from the working directory and every directory above it, and some
# of those files name code that the tool then runs, for `--version` as much as
# for an install. MEASURED, each with a marker file written by the checkout:
#   yarn 1.22.22 and 4.1.0 to 4.19.0  .yarnrc.yml yarnPath or plugins, from any
#                                     parent directory (and classic's .yarnrc
#                                     yarn-path), on `yarn --version`
#   corepack 0.36.0 (Node 24)         a project .corepack.env that points
#                                     COREPACK_NPM_REGISTRY at any server, or
#                                     allows a packageManager URL: the yarn it
#                                     served ran on `yarn --version`
#   rustup 1.29.3                     rust-toolchain.toml `path =` (absolute), on
#                                     `cargo --version` and `rustc --version`
#   maven 3.10.0                      .mvn/jvm.config (-javaagent), on `mvn -v`
#   .NET SDK 10.0.404                 global.json sdk "paths": the checkout's own
#                                     SDK ran on `dotnet --version`
#   pip 25.1.1 (Python 3.13)          a pip.py or pip/ beside it, on
#                                     `python3 -m pip --version`
#   go1.24.10                         a go.mod `toolchain` line: go fetched and
#                                     ran go1.25.4 for `go env`
# So each tool is asked about itself from /, and what a project changes is read
# from its files, or through an option that names the directory (`dotnet nuget
# config --working-directory`). A tool still runs in the project only where it
# was measured to read nothing there but settings: npm's `config get`, uv's
# `--show-settings`, `bundle config get`, `poetry config` and the composer rows'
# --no-plugins with COMPOSER pointed at a file that cannot exist.
#
# COREPACK_ENV_FILE=0 stops corepack loading a project's .corepack.env (MEASURED,
# corepack 0.36.0: with it, the redirected download went to repo.yarnpkg.com).
# It is exported for every tool started here, so a corepack shim the verifier
# runs in the project (npm's, when `corepack enable npm` made one) runs only an
# official release, whichever version the project's packageManager names.
#
# THE SAME HOLDS FOR A DIRECTORY ANOTHER ACCOUNT CAN WRITE. The probes that
# build throwaway projects used `mktemp -d`, which lands in /tmp, and /tmp is
# writable by everyone. A file planted in /tmp sits above every one of them.
# MEASURED: /tmp/.mvn/jvm.config ran in the maven probes, /tmp/rust-toolchain.toml
# in a cargo --version there, /tmp/Directory.Build.props in the nuget restore
# probe, a /tmp/package.json workspace root's install scripts in the bun probe
# (bun 1.3.0), and a /tmp/.yarnrc.yml yarnPath in yarn. The sticky bit stops
# another account deleting your files, not creating new ones. So the scratch
# directory comes from a base that only root and this account can write, every
# directory up to /, and TMPDIR points into it for everything started here. A
# group-writable directory is accepted, as action/harden.sh accepts one for its
# env file: the group is a grant somebody made. A base inside the working
# directory is not, because the checkout's files would sit above the probes.
# macOS's per-user temp dir (`getconf DARWIN_USER_TEMP_DIR`, /var/folders/../T,
# 0700 under root-owned parents) is a candidate too, so a Mac always has one.
# With no such base (HOME and TMPDIR both below /tmp, as in a test harness, and
# no XDG_RUNTIME_DIR), the probes run under TMPDIR as before and stderr says so.
#
# TMPDIR ALONE DOES NOT STEER mktemp ON macOS. Given no template (`mktemp`,
# `mktemp -d`), Apple's mktemp creates in the per-user temp dir from confstr
# _CS_DARWIN_USER_TEMP_DIR and reads TMPDIR only when that is unavailable (its
# man page says so, and on GitHub's macos-15 runner the maven probes did not run
# under a TMPDIR exported below a planted .mvn/jvm.config). So while a scratch
# dir is in use, mktemp is a function that names it in the template, and the
# probes land in it on every platform. `command mktemp` is the real one.
export COREPACK_ENV_FILE=0
scv_private_dir() { # <absolute dir> -> 0 when it and every directory above it are owned by root or us and not world-writable
  scv__pd=$(cd -P -- "$1" 2>/dev/null && pwd -P) || return 1
  scv__me=$(id -u)
  while :; do
    scv__pl=$(ls -ldn -- "$scv__pd" 2>/dev/null) || return 1
    scv__pm=${scv__pl%% *}
    scv__pu=$(printf '%s\n' "$scv__pl" | awk '{print $3}')
    case "$scv__pu" in 0|"$scv__me") ;; *) return 1 ;; esac
    case "$scv__pm" in ????????w*) return 1 ;; esac
    [ "$scv__pd" = / ] && return 0
    scv__pd=${scv__pd%/*}; [ -n "$scv__pd" ] || scv__pd=/
  done
}
SCV_SCRATCH=""; SCV_SCRATCH_TRIED=""
scv__pwdp=$(pwd -P 2>/dev/null)
scv__cache="${XDG_CACHE_HOME:-${HOME:+$HOME/.cache}}"
scv__darwin=$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null) || scv__darwin=""
for scv__b in "${TMPDIR:-}" "${RUNNER_TEMP:-}" "${scv__cache:+$scv__cache/supply-chain-hardening}" "$scv__darwin" "${XDG_RUNTIME_DIR:-}"; do
  case "$scv__b" in /*) ;; *) continue ;; esac
  if [ "$scv__b" = "${scv__cache:+$scv__cache/supply-chain-hardening}" ] && [ ! -d "$scv__b" ]; then
    ( umask 077; mkdir -p -- "$scv__b" ) 2>/dev/null || true
  fi
  SCV_SCRATCH_TRIED="${SCV_SCRATCH_TRIED:+$SCV_SCRATCH_TRIED, }$scv__b"
  [ -d "$scv__b" ] && scv_private_dir "$scv__b" || continue
  scv__bp=$(cd -P -- "$scv__b" && pwd -P) || continue
  if [ -n "$scv__pwdp" ] && [ "$scv__pwdp" != / ]; then
    case "$scv__bp/" in "$scv__pwdp"/*) continue ;; esac
  fi
  SCV_SCRATCH=$(command mktemp -d "$scv__bp/scv.XXXXXX" 2>/dev/null) || { SCV_SCRATCH=""; continue; }
  break
done
if [ -n "$SCV_SCRATCH" ]; then
  TMPDIR=$SCV_SCRATCH; export TMPDIR
  trap 'rm -rf "$SCV_SCRATCH"' EXIT
  mktemp() {
    case "$*" in
      '') command mktemp "$SCV_SCRATCH/tmp.XXXXXXXXXX" ;;
      -d) command mktemp -d "$SCV_SCRATCH/tmp.XXXXXXXXXX" ;;
      *)  command mktemp "$@" ;;
    esac
  }
elif [ "${QUIET:-0}" != 1 ]; then
  echo "[supply-chain-verify] warning: found no directory for the probes' throwaway projects that only root and $(id -un 2>/dev/null) can write, all the way up (tried: ${SCV_SCRATCH_TRIED:-nothing}), so they run under ${TMPDIR:-/tmp}, where a file another account planted above them can run in them. Point TMPDIR at a directory of your own, outside the project" >&2
fi
# <<< no project code

# True when version $1 >= $2 (dotted numeric). GNU sort -V; hosts are Linux.
# Used as a deterministic, offline backstop for gates that only exist above a
# known tool version — a version cannot be faked by config echo the way a
# `config get` value can (see npm_implements and ECH-187).
ver_ge() { [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V 2>/dev/null | tail -n1)" = "$1" ]; }

# Normalise once so the substring tests below can rely on single-space
# separators and leading/trailing padding.
: "${SCV_EXPECT_KNOWN:=0}"
: "${SCV_EXPECT:=}"
: "${SCV_EXPECT_WHY:=not in the declared expectations for this surface}"
SCV_EXPECT=" $(printf '%s' "$SCV_EXPECT" | tr '\n\t' '  ' | tr -s ' ') "

# expected <token> — was this promised on this surface?
#
# Fails OPEN when there is no record (SCV_EXPECT_KNOWN=0): "we cannot tell
# what was intended" must mean "check everything", never "assume nothing was
# wanted". That is the direction in which a mistake is visible.
expected() {
  [ "$SCV_EXPECT_KNOWN" -eq 1 ] || return 0
  case "$SCV_EXPECT" in *" !$1 "*) return 1 ;; esac
  case "$SCV_EXPECT" in *" $1 "*)  return 0 ;; esac
  # An ecosystem token covers its dotted children: `cargo` implies
  # `cargo.age-gate`. It does NOT imply `wrapper.cargo`, whose prefix is
  # `wrapper` — wrapper intent is a separate switch and stays separate.
  case "$SCV_EXPECT" in *" ${1%%.*} "*) return 0 ;; esac
  return 1
}

# requested <ecosystem> — the name the SHARED probe body calls. Same
# question, and the body asks it only about ecosystems.
#
# Note this is new on the host surface. Before it existed, the shared body's
# `requested composer` call resolved to "command not found" (rc 127), which
# reads as "not requested" and silently deleted the whole composer block from
# every host report.
requested() { expected "$1"; }

# The BYDESIGN half of the truth table. Never used for a tool that is merely
# absent — that is `row "N/A" - ...` and means something different.
na_design() { # protection, detail
  row "N/A" BYDESIGN "$1" "$2 — not required here: $SCV_EXPECT_WHY"
}

# Does npm actually IMPLEMENT a config key, or is it merely echoing our file
# back at us?
#
# This distinction cost a false OK in this very script. `npm config get <key>`
# returns whatever is in the config for ANY key, implemented or not:
#
#   $ echo 'this-key-does-not-exist=hello' >> ~/.npmrc
#   $ npm config get this-key-does-not-exist
#   hello
#
# So a value coming back proves npm READ the file — not that npm honors the
# key. On npm 10.9.8, `npm config get min-release-age` happily returns our
# value while npm has no such feature (it landed in 11.10.0). That is the same
# silently-ignored-setting failure the whole script exists to catch, reproduced
# inside the detector.
#
# The discriminator: ask npm with our config and env stripped away. A key npm
# implements has a built-in default; a key it does not know returns
# "undefined" even though our file sets it.
npm_implements() {
  local key="$1" tmp v
  tmp=$(mktemp -d 2>/dev/null) || return 1
  : > "$tmp/u"; : > "$tmp/g"
  # Drop the env-layer config (NPM_CONFIG_*), which would otherwise supply the
  # value and recreate the exact false positive — but keep the REST of the
  # environment. `env -i` is too blunt: a version-manager shim (mise/asdf/volta)
  # needs its own env to resolve the real npm, and under `env -i` it fails
  # ("mise ERROR: npm is not a valid shim"), leaving empty output the probe read
  # as "npm does not implement ignore-scripts" — a FALSE GAP. MEASURED on an
  # Omarchy/Arch host whose npm is a mise shim, where ignore-scripts was in fact
  # in effect (a postinstall was blocked). HOME is left intact so the shim can
  # read its config; the user's ~/.npmrc is neutralised by --userconfig instead.
  # Run FROM the scratch dir too: npm ALSO reads a project .npmrc from the
  # current working directory, which --userconfig/--globalconfig do NOT
  # override. A real deploy (ECH-187) false-OK'd the age gate on npm 10.9.8
  # because supply-chain-verify ran in a directory whose .npmrc set
  # min-release-age, leaking it into this "clean" query.
  # (Not used for the age gate any more — its key defaults to null even when
  # implemented, so a value-returned probe can't judge it; the age gate uses a
  # version check instead. Still valid for keys with a non-null default, e.g.
  # ignore-scripts.)
  v=$( cd "$tmp" && \
       ( for _k in ${!NPM_CONFIG_@}; do unset "$_k"; done
         npm config get "$key" --userconfig="$tmp/u" --globalconfig="$tmp/g" 2>/dev/null ) \
       | head -1 | tr -d '\r')
  rm -rf "$tmp"
  [ -n "$v" ] && [ "$v" != "undefined" ]
}

# Behavioral probe for the npm age gate. Opt-in via SCV_BEHAVIORAL=1 because it
# runs a live (dry-run) resolution. FUNCTIONAL evidence — observed behavior — is
# the only tier that survives the "config echoed but not enforced" failure this
# whole script exists to catch; a real deploy (ECH-187) proved the age gate
# PARSED-OK while functionally inert.
npm_age_gate_behaves() {
  # A working min-release-age gate REFUSES an old package under a ~million-year
  # window (every version is "too new"); an inert gate resolves one. --dry-run,
  # so nothing installs. The window is forced via env so the box's own (small,
  # legitimate) window can't let an old package through and mask the result.
  local tmp out; tmp=$(mktemp -d 2>/dev/null) || return 1
  out=$( cd "$tmp" && npm init -y >/dev/null 2>&1
         NPM_CONFIG_MIN_RELEASE_AGE=99999999 npm install lodash@4.17.21 \
           --dry-run --no-audit --no-fund </dev/null 2>&1 )
  rm -rf "$tmp"
  printf '%s' "$out" | grep -qiE 'date before|No matching version|notarget'
}

# >>> python startup hooks
# BYTE-IDENTICAL in templates/verify.sh.j2 and action/verify.sh, from the line
# above to the matching <<< line (tests/ci/07-verify.bats compares them). It sits
# in both preambles instead of files/verify-probes.sh because it has to run before
# the first probe that starts Python normally, and both preambles start pip before
# the shared body is reached.
#
# A wheel's .data/purelib can drop a *.pth or a sitecustomize into the
# site-packages root, and Python runs it on EVERY interpreter start: the October
# 2026 litellm wheels did exactly that (docs/limitations.md). This script starts
# python3 and pip below, so it would be one more thing that fires such a hook.
# Read the site directories as plain files first and say what is there before
# anything runs it.
#
# DETECTION, NOT A PROTECTION, AND NOT A CLEAN BILL. Nothing is removed or
# blocked. It reports what it can see in the directories it found; a payload
# somewhere else on sys.path, or inside a module a listed hook imports, is not
# seen. Three outcomes: WEAK when a hook has nothing vouching for it, OK listing
# the hooks that are recognised, and no row only when there are no hooks at all.
#
# Where it reads: the prefixes of the interpreters this run starts (python3,
# python, and pip/pip3 through their shebang), as found on PATH, resolved, and as
# the interpreter itself reports them; plus /usr, /usr/local, the user site
# (PYTHONUSERBASE too) and $VIRTUAL_ENV. The interpreter is asked with -I -S,
# which does not import site, so no .pth or sitecustomize runs (MEASURED). Without
# that, a python3 behind a pyenv/asdf/mise-style shim was never located. Its own
# executable path is asked for as well: under -S a venv's python reports the base
# install as sys.prefix, because it is site.py that points it at the venv.
#
# What counts, matching CPython's site.py (MEASURED on 3.13.12 and 3.12.3):
#   - Lines are split the way Python splits them, not on \n alone. 3.13 uses
#     str.splitlines(), so \r, \v, \f, \x1c-\x1e, U+0085, U+2028 and U+2029 all
#     end a line; a payload after any of them, behind a `#` comment, ran.
#   - A line starting with `import` and a space or tab runs, including after a
#     UTF-8 BOM. One with a leading space does not. Dotfiles are skipped.
#   - Any other line is a directory added to sys.path, and Python imports
#     sitecustomize and usercustomize from anywhere on sys.path, so those
#     directories and PYTHONPATH are read for them as well as the site root.
#   - sitecustomize/usercustomize run as a module, a compiled module or a package.
#
# What "recognised" means, and what it does not. Two kinds:
#   - a file a Debian package installed, whose md5 still matches the one dpkg
#     recorded. dpkg's records are root-owned, so a wheel cannot forge this.
#   - a .pth whose executing lines are exactly what setuptools, virtualenv/uv or
#     a setuptools editable install generate. This is NOISE REDUCTION ONLY: the
#     line just imports a module, and a wheel can ship the same line plus its own
#     copy of that module (MEASURED: it ran, unreported). Nothing on the host can
#     vouch for a file installed from PyPI, which is why recognised hooks are
#     listed in an OK row instead of being dropped.
# Anything else is listed with the installed distribution whose RECORD claims it.
scv_site_dirs() {
  local p c r pre d
  {
    for p in python3 python pip3 pip; do
      c=$(command -v "$p" 2>/dev/null) || continue
      case "$p" in
        pip*)
          r=$(sed -n '1s/^#![[:space:]]*\([^[:space:]]*\).*/\1/p' "$c" 2>/dev/null)
          case "${r##*/}" in python*) c="$r" ;; *) continue ;; esac ;;
      esac
      printf '%s\n' "${c%/*/*}"
      r=$(readlink -f "$c" 2>/dev/null) && printf '%s\n' "${r%/*/*}"
      "$c" -I -S -c 'import sys; print(sys.prefix); print(sys.base_prefix); print(sys.executable.rsplit("/", 2)[0])' 2>/dev/null </dev/null
    done
    printf '%s\n' /usr /usr/local "$HOME/.local" ${PYTHONUSERBASE:+"$PYTHONUSERBASE"} ${VIRTUAL_ENV:+"$VIRTUAL_ENV"}
  } | while IFS= read -r pre; do
    for d in "$pre"/lib/python3*/site-packages "$pre"/lib/python3*/dist-packages \
             "$pre"/lib/python3/dist-packages "$pre"/lib64/python3*/site-packages; do
      [ -d "$d" ] && readlink -f "$d"
    done
  done | awk '!seen[$0]++'
}

# A .pth file's lines, split where CPython splits them.
scv_pth_lines() {
  local bom nel ls ps nl
  bom=$(printf '\357\273\277')
  nel=$(printf '\302\205')
  ls=$(printf '\342\200\250')
  ps=$(printf '\342\200\251')
  nl='\
'
  LC_ALL=C tr '\r\013\014\034\035\036' '\n' < "$1" 2>/dev/null \
    | LC_ALL=C sed -e "1s/^$bom//" -e "s/$nel/$nl/g" -e "s/$ls/$nl/g" -e "s/$ps/$nl/g"
}

# The lines CPython would execute from one .pth file.
scv_pth_imports() { scv_pth_lines "$1" | LC_ALL=C grep '^import[[:blank:]]'; }

# The directories one .pth file adds to sys.path, resolved against its site dir.
scv_pth_paths() {
  local x
  scv_pth_lines "$1" | LC_ALL=C grep -v -e '^#' -e '^import[[:blank:]]' -e '^[[:space:]]*$' \
    | LC_ALL=C sed 's/[[:space:]]*$//' | while IFS= read -r x; do
      case "$x" in /*) ;; *) x="$2/$x" ;; esac
      [ -d "$x" ] && printf '%s\n' "$x"
    done
}

# True when every executing line in a .pth is a known tool's generated text.
scv_hook_known() {
  local pat
  case "${1##*/}" in
    distutils-precedence.pth)
      pat="^import os; var = 'SETUPTOOLS_USE_DISTUTILS'; enabled = os\.environ\.get\(var, '[a-z]+'\) == 'local'; enabled and __import__\('_distutils_hack'\)\.add_shim\(\);" ;;
    _virtualenv.pth)
      pat='^import _virtualenv' ;;
    __editable__.*.pth)
      pat='^import __editable___[A-Za-z0-9_]+_finder; __editable___[A-Za-z0-9_]+_finder\.install\(\)' ;;
    *) return 1 ;;
  esac
  ! scv_pth_imports "$1" | LC_ALL=C grep -qvE "${pat}[[:space:]]*\$"
}

# Which Debian package installed this file. Prints the package. Returns 0 when the
# file still matches the md5 dpkg recorded, 2 when it does not, 3 when the package
# lists the file but records no checksum for it, 1 when no package lists it. Reads
# dpkg's own files, so it runs no package tooling.
scv_dpkg_owner() {
  local list sum
  list=$(grep -lxF -- "$1" "$scv_dpkg_info"/*.list 2>/dev/null | head -n 1)
  [ -n "$list" ] || return 1
  list=${list%.list}
  printf '%s\n' "${list##*/}"
  sum=$(md5sum "$1" 2>/dev/null) || return 3
  grep -qxF -- "${sum%% *}  ${1#/}" "$list.md5sums" 2>/dev/null && return 0
  grep -qF -- "  ${1#/}" "$list.md5sums" 2>/dev/null && return 2
  return 3
}

# One hook, classified. Prints "K<TAB>path (why it is recognised)" or
# "U<TAB>path (who claims it)". $2 is the site directory whose RECORD files may
# claim it. Control characters in a name are replaced: the name is package-chosen
# and ends up on a terminal and in a CI log.
scv_hook_file() {
  local f=$1 d=$2 kind=U o="" p rel
  if [ -f "$f" ]; then
    p=$(scv_dpkg_owner "$f")
    case $? in
      0) kind=K; o="$p package, checksum matches" ;;
      2) o="$p package, changed since it was installed" ;;
      3) o="$p package, which records no checksum for it" ;;
    esac
  fi
  if [ -z "$o" ]; then
    case "$f" in *.pth) scv_hook_known "$f" && { kind=K; o="a known tool's generated line"; } ;; esac
  fi
  if [ -z "$o" ]; then
    case "$f" in "$d"/*) rel=${f#"$d"/} ;; *) rel=${f##*/} ;; esac
    o=$(REL="$rel" awk -F, '$1 == ENVIRON["REL"] || index($1, ENVIRON["REL"] "/") == 1 { print FILENAME; exit }' \
          "$d"/*.dist-info/RECORD 2>/dev/null)
    o=${o%.dist-info/RECORD}
    o=${o##*/}
  fi
  f=${f//[[:cntrl:]]/?}
  o=${o//[[:cntrl:]]/?}
  printf '%s\t%s (%s)\n' "$kind" "$f" "${o:-claimed by no installed distribution}"
}

# Every startup hook found, one classified line each.
scv_startup_hooks() {
  local d f x
  {
    scv_site_dirs | while IFS= read -r d; do
      for f in "$d"/*.pth; do
        [ -f "$f" ] && [ -n "$(scv_pth_imports "$f")" ] && scv_hook_file "$f" "$d"
      done
      { printf '%s\n' "$d"
        for f in "$d"/*.pth; do [ -f "$f" ] && scv_pth_paths "$f" "$d"; done
      } | while IFS= read -r x; do
        for f in "$x"/sitecustomize "$x"/sitecustomize.* "$x"/usercustomize "$x"/usercustomize.*; do
          case "$f" in *.pth) continue ;; esac
          [ -e "$f" ] && scv_hook_file "$f" "$d"
        done
      done
    done
    printf '%s\n' "${PYTHONPATH:-}" | tr ':' '\n' | while IFS= read -r x; do
      [ -n "$x" ] && [ -d "$x" ] || continue
      for f in "$x"/sitecustomize "$x"/sitecustomize.* "$x"/usercustomize "$x"/usercustomize.*; do
        [ -e "$f" ] && scv_hook_file "$f" "$x"
      done
    done
  } | awk '!seen[$0]++'
}

# "a; b; c; and N more" from one item per line, on stdin.
scv_hook_join() {
  awk 'NR <= 5 { printf "%s%s", (NR > 1 ? "; " : ""), $0 } END { if (NR > 5) printf "; and %d more", NR - 5 }'
}

scv_dpkg_info=/var/lib/dpkg/info
scv_hooks=$(scv_startup_hooks)
scv_hooks_u=$(printf '%s\n' "$scv_hooks" | awk -F'\t' '$1 == "U" { print $2 }')
scv_hooks_k=$(printf '%s\n' "$scv_hooks" | awk -F'\t' '$1 == "K" { print $2 }')
if [ -n "$scv_hooks_u" ]; then
  scv_hook_n=$(printf '%s\n' "$scv_hooks_u" | wc -l | tr -d ' ')
  scv_hook_list=$(printf '%s\n' "$scv_hooks_u" | scv_hook_join)
  [ "${QUIET:-0}" = 1 ] || echo "[supply-chain-verify] warning: $scv_hook_n Python startup hook(s) with nothing vouching for them: $scv_hook_list. The checks below start python3 and pip, which will run them; see \"Don't run it on a host you suspect is compromised\" at ${SCV_DOCS_URL:-https://github.com/echennells/supply-chain-hardening/blob/main}/docs/verify.md#dont-run-it-on-a-host-you-suspect-is-compromised" >&2
  row WEAK PRESENT "python startup hooks" \
    "$scv_hook_n file(s) that run code on every Python start with nothing vouching for them: $scv_hook_list. A wheel's .data/purelib can install these, as the October 2026 litellm wheels did. Detection only, nothing was changed: check each against the distribution named"
elif [ -n "$scv_hooks_k" ]; then
  scv_hook_n=$(printf '%s\n' "$scv_hooks_k" | wc -l | tr -d ' ')
  row OK PRESENT "python startup hooks" \
    "$scv_hook_n startup hook file(s), each unchanged from a Debian package or matching a known tool's generated line: $(printf '%s\n' "$scv_hooks_k" | scv_hook_join). That recognises the file named, not the module it imports, and it is not a clean bill for the host"
fi
# <<< python startup hooks

# >>> npm exclude scope
# BYTE-IDENTICAL in templates/verify.sh.j2 and action/verify.sh, from the line
# above to the matching <<< line (tests/ci/07-verify.bats compares them). Both
# npm rows live in the preambles, which run before the shared body, so this
# cannot live in files/verify-probes.sh.
#
# WHICH NAMES DOES A min-release-age-exclude LIST EXEMPT? npm's own test is
#   name === pattern || minimatch(name, pattern, {nonegate, nocomment, noext})
# (@npmcli/arborist lib/release-age-exclude.js, read on npm 11.19.1), and the
# rows used to compare entries with a literal '*' instead. MEASURED on npm
# 11.19.1 with a repo .npmrc and a 99999-day window: '*' exempted lodash but
# NOT @types/node (minimatch's '*' does not cross the '/' of a scoped name), so
# "every package skips the gate" overstated it; '**' exempted both, and '@*/*'
# and '*/*' every scoped package, while the row graded all three WEAK.
#
# So ask the minimatch npm itself loads, about sentinel names of each kind. A
# list that matches every sentinel of a kind ("a" and the made-up ones) matches
# that whole kind. A list that matches ANY made-up sentinel is broad even when
# it misses some: no list that names real packages names zz9-sch-sentinel, and
# MEASURED on npm 11.19.1 with a 99999-day window, '??*' and '[!z]*' each
# exempted lodash AND express, while 'lodash' alone left express refused
# (ENOVERSIONS), yet requiring every sentinel to match graded both WEAK as narrow.
# Prints "unscoped", "scoped", "broad", any two or three of them, or nothing.
# When npm's matcher cannot be found (a version-manager shim, an npm laid out
# differently) only '*' and '**', whose meaning is fixed, are judged, and
# anything else prints "unknown".
scv_npm_exclude_scope() { # <the list as `npm config get` prints it: comma-separated>
  local npmjs npmdir out
  npmjs=$(command -v npm 2>/dev/null)
  # Our npm wrapper names the real npm it execs.
  if [ -n "$npmjs" ] && grep -q 'supply-chain-harden' "$npmjs" 2>/dev/null; then
    npmjs=$(grep -oE "^REAL_NPM='[^']*'" "$npmjs" 2>/dev/null | head -1 | sed "s/^REAL_NPM='//; s/'\$//")
  fi
  [ -n "$npmjs" ] && npmjs=$(readlink -f "$npmjs" 2>/dev/null)
  npmdir=${npmjs%/bin/npm-cli.js}
  out=unknown
  if [ -n "$npmjs" ] && [ "$npmdir" != "$npmjs" ] && [ -d "$npmdir/node_modules/@npmcli/arborist/lib" ]; then
    out=$(cd / && node -e '
const path = require("path");
const lib = path.join(process.argv[1], "node_modules", "@npmcli", "arborist", "lib");
let mm;
try { mm = require(require.resolve("minimatch", { paths: [lib] })).minimatch; } catch (e) { process.exit(3); }
if (typeof mm !== "function") process.exit(3);
const opts = { nonegate: true, nocomment: true, noext: true };
const pats = process.argv[2].split(",").map(s => s.trim()).filter(Boolean);
const hit = n => pats.some(p => n === p || mm(n, p, opts));
const kinds = [];
const made = ["zz9-sch-sentinel", "q7x-sch-sentinel", "m3k-sch-sentinel", "e5w-sch-sentinel"];
const madeS = made.map(n => "@" + n + "/sentinel");
const unsc = ["a"].concat(made).every(hit), scop = ["@a/b"].concat(madeS).every(hit);
if (unsc) kinds.push("unscoped");
if (scop) kinds.push("scoped");
if ((!unsc && made.some(hit)) || (!scop && madeS.some(hit))) kinds.push("broad");
process.stdout.write(kinds.join(" "));
' "$npmdir" "$1" 2>/dev/null) || out=unknown
  fi
  if [ "$out" = unknown ]; then
    case ",$(printf '%s' "$1" | tr -d ' ')," in
      *",**,"*) out="unscoped scoped" ;;
      *",*,"*)  out="unscoped" ;;
    esac
  fi
  printf '%s\n' "$out"
}

# The age-gate row's verdict on an exclude list, as "STATUS<TAB>detail".
scv_npm_exclude_verdict() { # <npm version> <window days> <list>
  local where sc; where=$(pwd); sc=$(scv_npm_exclude_scope "$3")
  case "$sc" in
    "unscoped scoped")
      printf 'GAP\tnpm %s reports min-release-age=%s but min-release-age-exclude=%s in %s matches EVERY package name, scoped or not (asked of the matcher npm uses) - the gate is off for every package, and no exported setting overrides a repo'"'"'s exclude list' "$1" "$2" "$3" "$where" ;;
    unscoped)
      printf 'GAP\tnpm %s reports min-release-age=%s but min-release-age-exclude=%s in %s matches every UNSCOPED package name (asked of the matcher npm uses) - the gate is off for every package except scoped @org/name ones, and no exported setting overrides a repo'"'"'s exclude list' "$1" "$2" "$3" "$where" ;;
    scoped)
      printf 'GAP\tnpm %s reports min-release-age=%s but min-release-age-exclude=%s in %s matches every SCOPED package name (asked of the matcher npm uses) - the gate is off for every @org/name package, and no exported setting overrides a repo'"'"'s exclude list' "$1" "$2" "$3" "$where" ;;
    "unscoped broad")
      printf 'GAP\tnpm %s reports min-release-age=%s but min-release-age-exclude=%s in %s matches every UNSCOPED package name, and made-up scoped names too (asked of the matcher npm uses) - the gate is off for nearly every package, and no exported setting overrides a repo'"'"'s exclude list' "$1" "$2" "$3" "$where" ;;
    "scoped broad")
      printf 'GAP\tnpm %s reports min-release-age=%s but min-release-age-exclude=%s in %s matches every SCOPED package name, and made-up unscoped names too (asked of the matcher npm uses) - the gate is off for nearly every package, and no exported setting overrides a repo'"'"'s exclude list' "$1" "$2" "$3" "$where" ;;
    broad)
      printf 'GAP\tnpm %s reports min-release-age=%s but min-release-age-exclude=%s in %s matches made-up package names no exclude list would name (zz9-sch-sentinel and the like, asked of the matcher npm uses) - a wildcard that broad exempts arbitrary packages, not a named few, and no exported setting overrides a repo'"'"'s exclude list' "$1" "$2" "$3" "$where" ;;
    unknown)
      printf 'WEAK\tnpm %s enforces %s day(s) but %s exempts: %s (min-release-age-exclude). The matcher npm uses could not be loaded, so whether these patterns match every package was not tested' "$1" "$2" "$where" "$3" ;;
    *)
      printf 'WEAK\tnpm %s enforces %s day(s) but %s exempts: %s (min-release-age-exclude)' "$1" "$2" "$where" "$3" ;;
  esac
}
# <<< npm exclude scope

# >>> shell reachability
# BYTE-IDENTICAL in templates/verify.sh.j2 and action/verify.sh, from the line
# above to the matching <<< line (tests/ci/16-verify-reach.bats compares them).
#
# WHAT THIS SHELL GETS. The rows below grade the tools the verifier finds, with
# the config it finds. An agent runner can start every command in a shell that
# gets less: MEASURED on two agent VMs (2026-11-26), one ran each command as
# `bash --norc --noprofile -c` with HOME=/home/hatch while root's passwd home
# was /root, and a PATH with no home directory on it; the other replayed a
# shell state saved once per session ("Agent runners" in
# docs/design-principles.md). These helpers say where this shell differs:
# no env layer, a HOME the JVM does not read, a tool the verifier found only in
# a directory it added to PATH, a too-old tool in a directory nobody here can
# change. They read PATH, the passwd database and file modes, and start no tool.
#
# They compare against SCV_CALLER_PATH and SCV_CALLER_HOME, saved at the top of
# this file: go discovery and the shared body's discover() prepend directories
# to PATH later. The role's run at the end of an apply passes --apply-run
# (tasks/verify.yml), which sets SCV_APPLY_RUN=1. That run is ansible's own
# process, not a shell anyone works in, so the rows about this shell are left
# out of it. A flag and not a variable: both preambles set SCV_APPLY_RUN=0
# first, so one left exported in a shell rc cannot hide these rows.

# scv_passwd_home: the home the passwd database gives uid $(id -u), looked up by
# uid, never by $USER or $LOGNAME, which a relocated-HOME container can set to
# anything. getent is missing from some minimal images, so /etc/passwd is read
# after it. Nothing for a uid with no entry. The lookup harden_gradle in
# action/harden.sh does.
scv_passwd_home() {
  local scv__u scv__h
  scv__u=$(id -u 2>/dev/null) || return 0
  scv__h=$(getent passwd "$scv__u" 2>/dev/null | cut -d: -f6)
  [ -n "$scv__h" ] || scv__h=$(awk -F: -v u="$scv__u" '$3 == u { print $6; exit }' /etc/passwd 2>/dev/null)
  printf '%s' "$scv__h"
}

# scv_same_dir <a> <b>: both name one directory. Symlinks are resolved where
# both exist; otherwise compared as text, less a trailing slash.
scv_same_dir() {
  local scv__a="${1%/}" scv__b="${2%/}"
  [ -n "$scv__a" ] || scv__a=/
  [ -n "$scv__b" ] || scv__b=/
  [ "$scv__a" = "$scv__b" ] && return 0
  scv__a=$(CDPATH="" cd -P -- "$scv__a" 2>/dev/null && pwd -P) || return 1
  scv__b=$(CDPATH="" cd -P -- "$scv__b" 2>/dev/null && pwd -P) || return 1
  [ "$scv__a" = "$scv__b" ]
}

# scv_jvm_home_row: gradle and maven run on the JVM, which takes user.home from
# the passwd entry, not from HOME. MEASURED for gradle 8.14.3 on openjdk-21
# (tasks/gradle.yml): with HOME relocated it read <passwd home>/.gradle. That
# maven reads <passwd home>/.m2 the same way is inferred, not measured. So where
# HOME is not the passwd home, they do not read their files under HOME: WEAK,
# naming both homes. A gradle with GRADLE_USER_HOME set reads that instead and
# is left out, and so is a tool this run was not asked to check (requested, as
# in scv_reach_row). No row in any other case: a mismatch alone says nothing
# (every tests/ci test relocates HOME), and the row would be noise.
scv_jvm_home_row() {
  local scv__ph scv__h scv__d=""
  have gradle || have mvn || return 0
  scv__ph=$(scv_passwd_home)
  scv__h=${SCV_CALLER_HOME:-}
  [ -n "$scv__ph" ] && [ -n "$scv__h" ] || return 0
  scv_same_dir "$scv__ph" "$scv__h" && return 0
  if have gradle && [ -z "${GRADLE_USER_HOME:-}" ] \
     && { ! command -v requested >/dev/null 2>&1 || requested gradle; }; then
    scv__d="gradle reads ${scv__ph%/}/.gradle, not ${scv__h%/}/.gradle (GRADLE_USER_HOME would move it)"
  fi
  if have mvn && { ! command -v requested >/dev/null 2>&1 || requested maven; }; then
    scv__d="${scv__d:+$scv__d; }maven most likely reads ${scv__ph%/}/.m2, not ${scv__h%/}/.m2 (not measured)"
  fi
  [ -n "$scv__d" ] || return 0
  row WEAK PARSED "env JVM user home" \
    "HOME is $scv__h, but the JVM takes user.home from the passwd entry of uid $(id -u), $scv__ph: $scv__d"
}

# scv_tool_file <command>: the file a bare <command> runs or, when that is one
# of our wrappers, the real binary it names (REAL_<TOOL>='...').
scv_tool_file() {
  local scv__f scv__t
  scv__f=$(command -v "$1" 2>/dev/null) || return 0
  case "$scv__f" in /*) ;; *) return 0 ;; esac
  if grep -q 'supply-chain-harden' "$scv__f" 2>/dev/null; then
    scv__t=$(grep -oE "^REAL_[A-Z]+='[^']*'" "$scv__f" 2>/dev/null | head -1 | sed "s/^[^=]*='//; s/'\$//")
    [ -z "$scv__t" ] || scv__f=$scv__t
  fi
  printf '%s' "$scv__f"
}

# scv_where_clause <name> <path>: for the GAP of a tool too old for a setting,
# where it is and whether this account can change it, as one clause that starts
# with ". ". Nothing when its directory is writable. `[ -w ]` asks access(2),
# which refuses a read-only filesystem to root too (EROFS, per its man page):
# MEASURED on an agent VM, npm 10.9.4 sat in a read-only /opt/hatch-image/bin.
scv_where_clause() {
  local scv__d scv__o
  [ -n "${2:-}" ] || return 0
  if [ -d "$2" ]; then scv__d=$2; else scv__d=$(dirname -- "$2"); fi
  [ -d "$scv__d" ] || return 0
  [ -w "$scv__d" ] && return 0
  if [ "$(id -u 2>/dev/null)" = 0 ]; then
    printf '. %s is at %s: read-only (image-owned?)' "$1" "$2"
    return 0
  fi
  scv__o=$(ls -ld -- "$scv__d" 2>/dev/null | awk '{print $3}')
  if [ -n "$scv__o" ] && [ "$scv__o" != "$(id -un 2>/dev/null)" ] && [ "$scv__o" != "$(id -u 2>/dev/null)" ]; then
    printf '. %s is at %s: owned by %s; upgrading needs that account' "$1" "$2" "$scv__o"
  else
    printf '. %s is at %s, in a directory its owner cannot write' "$1" "$2"
  fi
}

# scv_env_presence <file>: how many variables the file exports (its
# `export NAME=` lines), how many this shell has (set, even empty: the go
# bypass knobs are empty on purpose), and which it lacks. Sets SCV_EP_N,
# SCV_EP_HAVE and SCV_EP_MISSING (" NAME NAME"). Presence only: values are not
# compared.
scv_env_presence() {
  local scv__l scv__k
  SCV_EP_N=0; SCV_EP_HAVE=0; SCV_EP_MISSING=""
  while IFS= read -r scv__l || [ -n "$scv__l" ]; do
    case "$scv__l" in export\ *) ;; *) continue ;; esac
    scv__k=${scv__l#export }; scv__k=${scv__k%%=*}
    case "$scv__k" in ''|[0-9]*|*[!A-Za-z0-9_]*) continue ;; esac
    SCV_EP_N=$((SCV_EP_N + 1))
    if [ -n "${!scv__k+set}" ]; then
      SCV_EP_HAVE=$((SCV_EP_HAVE + 1))
    else
      SCV_EP_MISSING="$SCV_EP_MISSING $scv__k"
    fi
  done < "$1"
}

# scv_profile_env_row <file>: the role's env layer, as the profile.d file it
# deploys exports it, against this shell. A login shell sources that file
# (/etc/profile does); a shell that loaded no startup file has none of it.
# MEASURED on the first agent VM above: no variable of the env layer was set.
scv_profile_env_row() {
  if [ "${SCV_APPLY_RUN:-}" = 1 ]; then
    row "N/A" BYDESIGN "env layer propagation" \
      "this is the apply's own run, in ansible's environment, which loads no startup file. Run supply-chain-verify from the shell you want checked"
    return 0
  fi
  if [ ! -f "$1" ]; then
    row GAP PRESENT "env layer propagation" "$1 is not there, so no shell gets the env layer. Re-apply the role"
    return 0
  fi
  scv_env_presence "$1"
  if [ "$SCV_EP_N" -eq 0 ]; then
    row WEAK PRESENT "env layer propagation" "$1 exports no variables"
  elif [ -z "$SCV_EP_MISSING" ]; then
    row OK FUNCTIONAL "env layer propagation" "all $SCV_EP_N variables $1 exports are set in this shell"
  elif [ "$SCV_EP_HAVE" -eq 0 ]; then
    row GAP FUNCTIONAL "env layer propagation" \
      "NONE of the $SCV_EP_N variables $1 exports are set in this shell. Most likely it loaded no startup file (bash --norc or -c, a container CMD, systemd, cron, an agent runner): the config files still apply, the variables do not. Run it from a login shell, or source the file first"
  else
    row WEAK FUNCTIONAL "env layer propagation" \
      "$SCV_EP_HAVE/$SCV_EP_N variables $1 exports are set in this shell; missing:$SCV_EP_MISSING. A shell that got /etc/environment but not /etc/profile.d (cron, or sudo on Ubuntu) looks like this, and so does a shell state saved before the last apply: start a new session"
  fi
}

# scv_reach_row <command> <first word of its rows> <ecosystem>: WEAK when the
# rows below grade a <command> that a bare call in this shell does not run.
# That happens only where the verifier added a directory to PATH (go discovery,
# and discover() and the cargo lookup in files/verify-probes.sh): the tool is
# then found only there, or a copy there now comes first. No row when PATH is
# as the caller left it, when both name the same file (a symlink to it
# included: test -ef), or for an ecosystem this run was not asked to check.
scv_reach_row() {
  local scv__now scv__was
  [ "${SCV_APPLY_RUN:-}" = 1 ] && return 0
  [ -n "${SCV_CALLER_PATH+set}" ] && [ "$PATH" != "$SCV_CALLER_PATH" ] || return 0
  scv__now=$(command -v "$1" 2>/dev/null) || return 0
  case "$scv__now" in /*) ;; *) return 0 ;; esac
  scv__was=$(PATH=$SCV_CALLER_PATH; command -v "$1" 2>/dev/null) || scv__was=""
  case "$scv__was" in /*) ;; *) scv__was="" ;; esac
  [ "$scv__now" = "$scv__was" ] && return 0
  [ -n "$scv__was" ] && [ "$scv__now" -ef "$scv__was" ] && return 0
  if command -v requested >/dev/null 2>&1 && ! requested "$3"; then return 0; fi
  if [ -z "$scv__was" ]; then
    row WEAK PARSED "$2 on this shell's PATH" \
      "the $2 rows grade $scv__now, but that directory is not on this shell's PATH, so a bare \`$1\` here finds nothing (the verifier also looks in a few fixed places)"
  else
    row WEAK PARSED "$2 on this shell's PATH" \
      "the $2 rows grade $scv__now, from a directory the verifier added to PATH, but a bare \`$1\` here runs $scv__was"
  fi
}
# <<< shell reachability

# ---------------------------------------------------------- env layer --------
# The variables the role exports from /etc/profile.d, against this shell, and
# HOME against the home the JVM reads. Both say what THIS shell gets: run the
# verifier from the shell an agent or a build actually uses.
scv_profile_env_row /etc/profile.d/supply-chain-hardening.sh
scv_jvm_home_row

# ---------------------------------------------------------------- npm --------
if have npm; then
  # `npm config get` is npm's own view after merging every config source. If it
  # disagrees with our file, npm did not honor our file.
  if ! npm_implements ignore-scripts; then
    row GAP FUNCTIONAL "npm lifecycle scripts blocked" "npm $(npm --version 2>/dev/null) does not implement ignore-scripts"
  else
    v=$(npm config get ignore-scripts 2>/dev/null | tr -d '\r')
    if [ "$v" = "true" ]; then
      # NOTE: a behavioral probe here would be a TAUTOLOGY on npm >= 12, which
      # blocks dependency install-scripts by default (the allowScripts model) —
      # a postinstall marker never fires whether our config is set or not, so
      # "blocked" proves nothing about the role. Kept PARSED deliberately; see
      # the [npm] allowScripts ticket for the redundancy + test-tautology it
      # creates for existing postinstall tests.
      row OK PARSED "npm lifecycle scripts blocked" "npm implements ignore-scripts and reports true"
    else
      row GAP PARSED "npm lifecycle scripts blocked" "npm reports ignore-scripts=${v:-<unset>}"
    fi
  fi

  # The age gate needs BOTH checks, and the implementation check comes first.
  # npm echoes back keys it does not implement, so the value alone is not
  # evidence — see npm_implements() above.
  nv=$(npm --version 2>/dev/null)
  if [ -z "$nv" ]; then
    row GAP FUNCTIONAL "npm age gate" "npm is present but 'npm --version' returned nothing — cannot verify the age gate"
  elif ! ver_ge "$nv" "11.10.0"; then
    # Deterministic, OFFLINE backstop (ECH-187). min-release-age landed in npm
    # 11.10.0; below that npm echoes the key but nothing enforces it. A real
    # deploy false-OK'd here on npm 10.9.8 because the config-echo probe was
    # defeated by a leaked project .npmrc — a version comparison cannot be
    # defeated by config echo. Version, not npm_implements, is the reliable
    # signal for this key: min-release-age's DEFAULT is null even when
    # implemented (npm 12.0.2 returns null for a clean query), so a
    # "does npm return a value?" probe cannot tell implemented from unknown.
    row GAP FUNCTIONAL "npm age gate" "npm $nv does NOT implement min-release-age (added in npm 11.10.0) — below that version npm echoes the key but nothing enforces it$(scv_where_clause npm "$(scv_tool_file npm)")."
  else
    # npm >= 11.10.0: implemented (version is authoritative). Validate the
    # configured value; under SCV_BEHAVIORAL, prove enforcement behaviorally.
    v=$(npm config get min-release-age 2>/dev/null | tr -d '\r')
    case "$v" in
      ''|null|undefined) row GAP PARSED "npm age gate" "npm implements min-release-age but reports no value" ;;
      *[!0-9]*)          row GAP PARSED "npm age gate" "npm reports non-numeric min-release-age='$v'" ;;
      0)                 row GAP PARSED "npm age gate" "min-release-age=0 disables the gate" ;;
      *)
        # Below the declared window first: the env var outranks both npmrc files,
        # so a healthy-looking number can still be shorter than this host promised.
        # Compared in days the way the writers derive it, floored at 1.
        nwant=""
        case "$SCV_MIN_AGE_HOURS" in
          ''|*[!0-9]*) ;;
          *) nwant=$((SCV_MIN_AGE_HOURS / 24)); [ "$nwant" -lt 1 ] && nwant=1 ;;
        esac
        # PARSED is a floor, not the ceiling. With SCV_BEHAVIORAL=1, prove
        # ENFORCEMENT: resolve an old package under a huge window; a working
        # gate refuses it, an inert one resolves it.
        # A repo .npmrc can exempt packages (min-release-age-exclude, npm 11.17)
        # or pin a cutoff date (before, npm 11.15), and both are read from the
        # working directory, as here. MEASURED on npm 11.19.1 and 12.2.2: a
        # project `min-release-age-exclude[]=*` let every UNSCOPED package through (scoped ones stayed gated on 11.19.1: see scv_npm_exclude_scope) even
        # with the env layer set (an exported empty list does NOT override it)
        # while this row printed OK. npm_age_gate_behaves below runs in a temp
        # dir and cannot see a repo file, so this check is not optional there.
        # A repo `before=` wins only when no NPM_CONFIG_MIN_RELEASE_AGE is set.
        nexcl=$(npm config get min-release-age-exclude 2>/dev/null | tr -d '\r')
        case "$nexcl" in null|undefined) nexcl="" ;; esac
        nbefore=$(npm config get before 2>/dev/null | tr -d '\r')
        case "$nbefore" in null|undefined) nbefore="" ;; esac
        nxv=""
        [ -n "$nexcl" ] && nxv=$(scv_npm_exclude_verdict "$nv" "$v" "$nexcl")
        if [ "${nxv%%$'\t'*}" = GAP ]; then
          row GAP PARSED "npm age gate" "${nxv#*$'\t'}"
        elif [ -n "$nbefore" ] && [ -z "${NPM_CONFIG_MIN_RELEASE_AGE:-}${npm_config_min_release_age:-}" ]; then
          row GAP PARSED "npm age gate" "npm $nv reports before=$nbefore in $(pwd), which replaces the min-release-age window when no NPM_CONFIG_MIN_RELEASE_AGE is set"
        elif [ -n "$nexcl" ]; then
          row WEAK PARSED "npm age gate" "${nxv#*$'\t'}"
        elif [ -n "$nwant" ] && [ "$v" -lt "$nwant" ]; then
          row WEAK PARSED "npm age gate" "npm $nv reports $v day(s), below the $nwant day(s) this host declared${NPM_CONFIG_MIN_RELEASE_AGE:+ - NPM_CONFIG_MIN_RELEASE_AGE in the environment outranks both npmrc files}"
        elif [ "${SCV_BEHAVIORAL:-0}" = "1" ]; then
          if npm_age_gate_behaves; then
            row OK FUNCTIONAL "npm age gate" "npm $nv ENFORCES min-release-age (window ${v}d): an old package was refused under a huge window"
          else
            row GAP FUNCTIONAL "npm age gate" "npm $nv reports min-release-age=$v but a package RESOLVED under a huge window — the gate is not enforcing"
          fi
        else
          row OK PARSED "npm age gate" "npm $nv implements min-release-age and reports $v day(s) (set SCV_BEHAVIORAL=1 to prove enforcement)"
        fi ;;
    esac
  fi
else
  row "N/A" - "npm" "npm not installed"
fi

# ---------------------------------------------------------------- yarn -------
# The yarn probe is in the shared body (files/verify-probes.sh), so the CI
# surface asks yarn the same question instead of grepping our own file.

# ---------------------------------------------------------------- pnpm -------
# The pnpm rows are in the shared body (files/verify-probes.sh): they ask pnpm,
# from /, and the CI surface asks the same questions.

# ------------------------------------------------- npq (reputation layer) ----
# The layer that addresses slopsquatting — an attacker pre-registering a
# plausible name an agent might guess. An age gate does nothing against a squat
# registered months ago; this is what catches it. It also fails OPEN: below
# Node 20.13.0 it warns, runs the real package manager, and exits 0.
#
# npq is a protection COMPONENT, not an ecosystem, so "not installed" is a
# broken promise rather than "nothing to protect" — provided it was promised.
if have npq-hero; then
  out=$(cd / && npq-hero --version 2>&1)
  if printf '%s' "$out" | grep -qi 'npq suppressed'; then
    row GAP FUNCTIONAL "npq reputation checks" "npq is installed but SUPPRESSED on Node $(cd / && node --version 2>/dev/null); it passes through to npm and exits 0"
  else
    row OK FUNCTIONAL "npq reputation checks" "npq responds normally (not suppressed)"
  fi
elif expected tool.npq; then
  row GAP PRESENT "npq reputation checks" "npq-hero not installed — no pre-install reputation checking"
else
  na_design "npq reputation checks" "npq-hero not installed"
fi

# ------------------------------------------------- sfw (reputation layer) ----
if have sfw; then
  # The wrappers' sfw_ready test: a non-root caller, the npm shim, nothing
  # cached, and a cache this caller cannot fill. The wrappers then run npm and
  # cargo WITHOUT sfw and warn, which is not the same as an sfw that fails.
  sfw_cold=""
  if [ "$(id -u)" != 0 ]; then
    _s=$(readlink -f "$(command -v sfw)" 2>/dev/null); _p=${_s%/*}; _p=${_p%/*}
    if [ -n "$_s" ] && [ -f "$_p/package.json" ] && [ ! -e "$_p/.sfw-cache/latest" ]; then
      if [ -e "$_p/.sfw-cache" ]; then [ -w "$_p/.sfw-cache" ] || sfw_cold="$_p/.sfw-cache"
      else [ -w "$_p" ] || sfw_cold="$_p/.sfw-cache"; fi
    fi
  fi
  # Who can change the binary sfw runs. sfw runs .sfw-cache/latest without
  # checking its digest again, for every caller, root included (`sudo npm
  # install` goes through the npm wrapper), so a cache another account can
  # write lets that account choose what root runs. Earlier role versions left
  # it that way (VM#1: mode 0777 and a user-owned `latest`). The apply resets
  # such a cache, but only when it runs; between applies this row is the only
  # place it shows. Same test as that reset in tasks/socket.yml, and only for
  # a root-owned sfw: a per-user sfw's cache is its owner's to write.
  sfw_foreign=""
  _s=$(readlink -f "$(command -v sfw)" 2>/dev/null); _p=${_s%/*}; _p=${_p%/*}
  if [ -n "$_s" ] && [ -f "$_p/package.json" ] && [ "$(stat -c %u "$_p" 2>/dev/null)" = 0 ] \
     && { [ -e "$_p/.sfw-cache" ] || [ -L "$_p/.sfw-cache" ]; }; then
    if [ -L "$_p/.sfw-cache" ] || [ ! -d "$_p/.sfw-cache" ]; then
      sfw_foreign="$_p/.sfw-cache is not a directory"
    else
      _b=$(find "$_p/.sfw-cache" \( ! -uid 0 -o \( ! -type l -perm /022 \) \) -print -quit 2>/dev/null)
      if [ -n "$_b" ]; then
        sfw_foreign="$_b is $(stat -c '%U %a' "$_b" 2>/dev/null)"
      elif [ -L "$_p/.sfw-cache/latest" ]; then
        _t=$(readlink -f "$_p/.sfw-cache/latest" 2>/dev/null)
        case "$_t" in "$_p/.sfw-cache"/*) ;; *) sfw_foreign="$_p/.sfw-cache/latest points outside the cache, at $_t" ;; esac
      fi
    fi
  fi
  # SFW_SKIP_UPDATE_CHECK=1 because that is how the npm and cargo wrappers run
  # it. Without it, sfw run by a non-root account fails from one hour after the
  # apply (it tries to rewrite its root-owned .sfw-cache/next-check), and this
  # row reported a GAP for wrappers that were working.
  if [ -n "$sfw_foreign" ]; then
    row GAP FUNCTIONAL "Socket Firewall" "sfw's cache is not root-only ($sfw_foreign). sfw runs the cached binary without checking it again, for root too, so whoever can write there chooses what the npm and cargo wrappers run, including under sudo. Re-apply the role: it removes the cache and downloads the binary again"
  elif [ -n "$sfw_cold" ]; then
    row GAP FUNCTIONAL "Socket Firewall" "sfw has no firewall binary cached that this account can run ($sfw_cold), and only root can fetch it, so the npm and cargo wrappers run without sfw and warn - installs work, unfiltered. Re-apply the role, or run  sudo sh -c 'umask 022; sfw true && chmod -R go+rX $sfw_cold'  once"
  elif sfw_err=$(cd / && SFW_SKIP_UPDATE_CHECK=1 sfw --version 2>&1 >/dev/null); then
    row OK FUNCTIONAL "Socket Firewall" "sfw responds to --version"
  else
    row GAP FUNCTIONAL "Socket Firewall" "sfw is on PATH but does not execute successfully: $(printf '%s' "$sfw_err" | grep -v '^[[:space:]]*$' | tail -n 1)"
  fi
elif expected tool.sfw; then
  row GAP PRESENT "Socket Firewall" "sfw not installed — npm installs are not threat-intel filtered"
else
  na_design "Socket Firewall" "sfw not installed (socket_firewall_install=false)"
fi

# ------------------------------------------------------- PATH wrappers -------
# Wrappers are the weakest evidence class in the whole role: existence proves
# nothing about whether callers resolve through them.
#
# CHECK THE PATH CALLERS ACTUALLY HIT, NOT A FIXED DIRECTORY.
# An earlier version of this loop only looked in /usr/local/bin. But only npm
# and pip/pip3 deploy there — composer, deno, bun and bunx are written to the
# DISCOVERED binary path. On a stock Ubuntu 24.04 that is /usr/bin/composer, so
# the probe reported "not deployed" for a wrapper that was installed and
# working. That is the same defect as the npm false OK, pointing the other way:
# a real protection reported as absent. Under-reporting is the safer direction,
# but it is still wrong, and a verifier that cries wolf gets ignored.
#
# AND THE OTHER HALF, WHICH IS THE ONE THE PREAMBLE FIXED. "Not deployed" used
# to be WEAK, which does not move the exit code, so a host with every wrapper
# and a host with none both printed "RESULT: no gaps". It is now measured
# against SCV_EXPECT: a GAP when the role was configured to deploy it, an
# N/A BYDESIGN when it was not.

# Where a wrapper for this tool was MEANT to go, per the preamble. Empty when
# the role deploys it to a path only discovered at apply time.
scv_intended_path() { # tool
  printf '%s\n' "$SCV_WRAPPER_PATHS" | sed -n "s|^$1=||p" | head -1
}

# Find a deployed wrapper for this tool ANYWHERE a caller could have it, not
# just where the tool currently resolves from. A shadowed wrapper is by
# definition not on the resolved path, so looking only there reports it as
# "never deployed" — the wrong diagnosis, pointing at the wrong fix.
#
# The marker is "supply-chain-harden", a substring of both this role's
# "supply-chain-hardening" and the CI action's "supply-chain-harden action",
# so one probe recognises a wrapper from either surface.
locate_wrapper() { # tool
  local w="$1" d ip
  local -a dirs
  IFS=: read -ra dirs <<< "$PATH"
  for d in "${dirs[@]}"; do
    [ -n "$d" ] || continue
    if [ -f "$d/$w" ] && grep -q "supply-chain-harden" "$d/$w" 2>/dev/null; then
      printf '%s\n' "$d/$w"; return 0
    fi
  done
  ip=$(scv_intended_path "$w")
  if [ -n "$ip" ] && [ -f "$ip" ] && grep -q "supply-chain-harden" "$ip" 2>/dev/null; then
    printf '%s\n' "$ip"; return 0
  fi
  return 1
}

# WHAT WON, NAMED.
#
# "an unwrapped binary" is false for every front-runner that is itself a
# wrapper, which is most of them. Naming it turns "your wrapper is not in
# front" into a diagnosis with an action attached.
describe_binary() {
  f="$1"
  [ -n "$f" ] || { echo "nothing on PATH"; return; }
  if grep -q "supply-chain-harden" "$f" 2>/dev/null; then echo "our own wrapper"; return; fi
  if grep -qi "safe-chain" "$f" 2>/dev/null; then echo "an Aikido safe-chain shim"; return; fi
  case "$f" in
    */.asdf/shims/*)                      echo "an asdf shim" ;;
    */mise/shims/*|*/.local/share/mise/*) echo "a mise shim" ;;
    */fnm_multishells/*|*/.fnm/*|*/fnm/node-versions/*|*/fnm/aliases/*) echo "an fnm shim" ;;
    */.volta/*)                           echo "a volta shim" ;;
    */.nodenv/shims/*|*/.pyenv/shims/*)   echo "a version-manager shim" ;;
    *)
      # A script is not necessarily a wrapper. Most of what PATH resolves to on
      # a stock host is a launcher: Debian's /usr/bin/pip3 and /usr/bin/npm and
      # a venv's bin/pip are python or node scripts, NodeSource's npm is
      # npm-cli.js under node, a composer.phar is php. Calling those "another
      # wrapper script" sent a reader looking for a second security tool that
      # does not exist. Name the interpreter instead.
      if head -c 2 "$f" 2>/dev/null | grep -q '#!'; then
        interp=$(head -n 1 "$f" 2>/dev/null | sed 's/^#![[:space:]]*//' | awk '{
          b = $1; sub(".*/", "", b)
          if (b == "env") { b = ""; for (i = 2; i <= NF; i++) if ($i !~ /^-/) { b = $i; sub(".*/", "", b); break } }
          print b }')
        case "$interp" in
          sh|bash|dash|zsh|ksh|mksh|ash|busybox) echo "a shell script that is not ours" ;;
          '') echo "a script with no interpreter named" ;;
          *) echo "an unwrapped $interp launcher" ;;
        esac
      else echo "an unwrapped binary"; fi ;;
  esac
}

# DID OUR WRAPPER ACTUALLY RUN?
#
# This row used to answer by INFERENCE from PATH position, and graded itself
# WEAK PRESENT for exactly that reason — the comment below said so: "nothing
# here EXECUTED the wrapper". Honest, but it meant a working wrapper could
# never read as OK, and worse, the shadowed branch asserted "never runs" from
# the same inference.
#
# Position tells you what resolves FIRST, not what executes AT ALL. MEASURED:
# with an Aikido safe-chain shim in front, our wrapper ran on every call (the
# shim strips its own directory and execs the next match, which is us) while
# this row said it was shadowed and never ran. Every version manager — asdf,
# mise, volta, nodenv, pyenv — is shim-first and delegates identically, so the
# same false report fired for those hosts with no second security tool.
#
# The wrappers now record a breadcrumb when SCH_WRAPPER_PROBE is set, so this
# can observe instead of infer — which is what upgrades the row from PRESENT
# to genuine FUNCTIONAL evidence.
SCV_WRAPPER_RAN_PATH=""
SCV_WRAPPER_REFUSAL=""
wrapper_ran() {
  w="$1"
  SCV_WRAPPER_RAN_PATH=""
  SCV_WRAPPER_REFUSAL=""
  probe=$(mktemp 2>/dev/null) || return 2
  # RUSTUP_AUTO_INSTALL=0: one of these tools is cargo, a rustup proxy that
  # downloads its toolchain to answer --version when it is not installed
  # (MEASURED: 757 MB). Only rustup reads the variable.
  # --no-plugins for composer: an unwrapped `composer --version` inside a
  # checkout activates the checkout's allowed plugin (MEASURED, 2.11.2).
  # --no-interaction, COMPOSER_ALLOW_SUPERUSER=1 and COMPOSER (a file that cannot
  # exist): see the composer version probe in files/verify-probes.sh. An
  # unwrapped composer run as root on a terminal otherwise waits at a hidden
  # prompt, and a version probe must not boot the checkout it is standing in.
  # Only composer reads those two variables.
  wa=""; case "${w##*/}" in composer) wa="--no-plugins --no-interaction" ;; esac
  # Bounded on every host, timeout(1) or not: see run_bounded.
  # From /, never the working directory: one of these is cargo, and through a
  # rustup proxy a checkout's rust-toolchain.toml `path =` names the cargo that
  # answers (MEASURED, rustup 1.29.3: it ran for `cargo --version`). See "no
  # project code" above.
  _wr_err=$(cd / && COMPOSER=/dev/null/composer.json COMPOSER_ALLOW_SUPERUSER=1 RUSTUP_AUTO_INSTALL=0 SCH_WRAPPER_PROBE="$probe" run_bounded 30 "$w" --version $wa 2>&1 >/dev/null; echo "rc=$?")
  # RAN IS NOT WORKS. The run-probe fires first thing, so a wrapper that then
  # REFUSES this account still records a run. The pip-to-uv wrapper exits 126
  # with a [supply-chain-hardening] error when the only uv it finds belongs to
  # another account (VM#2): pip does not work for this account at all, yet this
  # row read OK FUNCTIONAL for root on such a host. Exit 126 plus an attributed
  # error line, so a shell's own 126 (not executable) is not mistaken for it.
  case "$_wr_err" in
    *"rc=126") SCV_WRAPPER_REFUSAL=$(printf '%s\n' "$_wr_err" | grep -m1 'supply-chain-harden[a-z]*\] error: ') ;;
  esac
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    if [ -f "$line" ] && grep -q "supply-chain-harden" "$line" 2>/dev/null; then
      SCV_WRAPPER_RAN_PATH="$line"
      break
    fi
  done < "$probe"
  rm -f "$probe"
  [ -n "$SCV_WRAPPER_RAN_PATH" ]
}

for w in $SCV_WRAPPERS; do
  if ! have "$w"; then
    # The SUBJECT tool is absent, so there is nothing for a wrapper to wrap.
    # This is the one wrapper outcome that is N/A regardless of intent.
    row "N/A" - "$w PATH wrapper" "$w not installed"
    continue
  fi
  p=$(command -v "$w" 2>/dev/null)   # what callers resolve to

  wrapper_ran "$w"; probe_rc=$?
  if [ "$probe_rc" -eq 0 ]; then
    # OBSERVED. Still confirm it can reach the real tool: the probe fires
    # before the recursion guard, so an orphaned wrapper records a run and
    # then exits 127 on every call. Running is necessary, not sufficient.
    target=$(grep -oE "^(REAL_[A-Z]+|UV)='[^']*'" "$SCV_WRAPPER_RAN_PATH" 2>/dev/null | head -1 | sed "s/^[^=]*='//; s/'\$//")
    if [ -n "$SCV_WRAPPER_REFUSAL" ]; then
      row GAP FUNCTIONAL "$w PATH wrapper" "wrapper at $SCV_WRAPPER_RAN_PATH ran but REFUSES this account ($(id -un 2>/dev/null)), exit 126, so \`$w\` does not work here: ${SCV_WRAPPER_REFUSAL#*error: }"
    elif [ -n "$target" ] && [ -x "$target" ]; then
      if [ "$SCV_WRAPPER_RAN_PATH" = "$p" ]; then
        row OK FUNCTIONAL "$w PATH wrapper" "observed running when $w was invoked (at $p); callers bypassing PATH are unaffected"
      else
        row OK FUNCTIONAL "$w PATH wrapper" "observed running when $w was invoked — chained behind $(describe_binary "$p") at $p"
      fi
    else
      row GAP FUNCTIONAL "$w PATH wrapper" "wrapper at $SCV_WRAPPER_RAN_PATH ran, but its real target '${target:-<none>}' is missing or not executable — the recursion guard makes it refuse to run"
    fi
  elif [ -n "$p" ] && grep -q "supply-chain-harden" "$p" 2>/dev/null; then
    # Wrappers reach the real tool two different ways, and the check must know
    # both or it cries wolf. bun/deno/composer/cargo RENAME the binary to
    # <tool>-real and exec that. npm embeds REAL_NPM='<path>'; pip/pip3 embed
    # UV='<path>'. So check the TARGET THE WRAPPER ACTUALLY EXECS — the value
    # of its REAL_*/UV assignment — not a <tool>-real file that npm/pip never
    # create. (Checking ${p}-real reported npm/pip wrappers as "refuses to run"
    # on every host, a false GAP for a working wrapper — the mirror of the old
    # composer false GAP.)
    # Ours is what resolves, but it did not record a run. On a long-lived host
    # that means a wrapper deployed before the run-probe existed — common,
    # since nothing removes an old wrapper. Position evidence only, and it
    # must not read as observation.
    target=$(grep -oE "^(REAL_[A-Z]+|UV)='[^']*'" "$p" 2>/dev/null | head -1 | sed "s/^[^=]*='//; s/'\$//")
    if [ -n "$target" ] && [ -x "$target" ]; then
      row WEAK PRESENT "$w PATH wrapper" "wrapper is in place at $p but predates the run-probe, so this is position evidence, not observation — re-apply the role to upgrade this row"
    else
      row GAP PRESENT "$w PATH wrapper" "wrapper at $p but its real target '${target:-<none>}' is missing or not executable — the recursion guard makes it refuse to run"
    fi
  elif [ "$probe_rc" -eq 2 ]; then
    row WEAK PRESENT "$w PATH wrapper" "could not create a temp file to run the probe; falling back to position: $w resolves to $p ($(describe_binary "$p"))"
  elif shadow=$(locate_wrapper "$w"); then
    # Deployed, and it did NOT run — confirmed by the probe rather than
    # inferred from PATH order, which is what made this branch wrong for every
    # front-runner that delegates.
    row GAP FUNCTIONAL "$w PATH wrapper" "wrapper is at $shadow and did NOT run — $w resolves to $p ($(describe_binary "$p"))"
  elif expected "wrapper.$w"; then
    row GAP FUNCTIONAL "$w PATH wrapper" "not deployed; $w resolves to $p ($(describe_binary "$p"))"
  else
    na_design "$w PATH wrapper" "not deployed; $w resolves to $p ($(describe_binary "$p"))"
  fi
done

# ---------------------------------------------------------------- go ---------
# >>> go discovery
# BYTE-IDENTICAL in templates/verify.sh.j2 and action/verify.sh, from the line
# above to the matching <<< line (tests/ci/07-verify.bats compares them, and
# checks the directories against `discover go` in files/verify-probes.sh).
# The shared body's discovery (ECH-189) runs AFTER this preamble, so a go that
# is installed at /usr/local/go/bin but not on this PATH (a non-login PATH,
# another user's) read "go not installed" here, while the shared go rows below
# found it and graded it OK in the same table (MEASURED). Look in the same
# fixed directories, in the same order, before the go rows below.
if ! have go; then
  for scv__gd in /usr/local/go/bin "$HOME/go/bin"; do
    if [ -x "$scv__gd/go" ]; then PATH="$scv__gd:$PATH"; export PATH; break; fi
  done
fi
# <<< go discovery

if have go; then
  # `go env` is go's effective config, not our file. Asked from /: in a module
  # whose go.mod has a `toolchain` line, `go env` fetched and ran that toolchain
  # (MEASURED, go1.24.10 ran go1.25.4), and GOFLAGS comes from no project file.
  v=$(cd / && go env GOFLAGS 2>/dev/null)
{% if goflags_mod | length > 0 %}
  # goflags_mod was set, so the role wrote GOFLAGS=-mod={{ goflags_mod }}.
  case "$v" in
    *-mod={{ goflags_mod }}*)
      row OK PARSED "go module mode" "go env GOFLAGS contains -mod={{ goflags_mod }} (goflags_mod)" ;;
    *)
      # The role delivers GOFLAGS through /etc/profile.d + /etc/environment,
      # which only a PAM-launched or login shell loads. An empty value in a
      # docker exec / systemd / CMD context is the DOCUMENTED non-PAM gap, not
      # a misconfiguration — and saying "not configured" would send an operator
      # to fix a file that is already correct. Distinguish the two.
      if grep -qs -- "-mod={{ goflags_mod }}" /etc/environment /etc/profile.d/*.sh 2>/dev/null; then
        row WEAK PRESENT "go module mode" "GOFLAGS is empty in THIS process, but -mod={{ goflags_mod }} is present in /etc/environment or /etc/profile.d — non-PAM contexts (docker exec, systemd, CMD) do not load it. Verify from a login shell."
      else
        row GAP PARSED "go module mode" "GOFLAGS='${v:-<empty>}' and -mod={{ goflags_mod }} is not in /etc/environment or /etc/profile.d either"
      fi ;;
  esac
{% else %}
  # The role does not set GOFLAGS (goflags_mod is empty), so this row reports
  # Go's own module mode rather than a protection of ours. Go's default already
  # refuses to change go.mod/go.sum during a build: readonly, or vendor/ when the
  # module vendors (MEASURED on go1.22.12 and go1.27.4; see defaults/main.yml).
  # The one value that undoes that is -mod=mod, which lets `go build`/`go test`
  # resolve a missing import and rewrite go.mod/go.sum with no `go get` (MEASURED
  # on go1.27.4: it downloaded the latest uuid and wrote both files). The row
  # is WEAK rather than GAP because the role never promised to override it, and
  # N/A otherwise: an OK here would count Go's default as a protection of ours.
  case "$v" in
    *-mod=mod*)
      row WEAK PARSED "go module mode" "go env GOFLAGS='$v' contains -mod=mod: a build may add requirements and rewrite go.mod/go.sum without go get. The role does not set GOFLAGS; find where this comes from (go env GOENV, the environment)" ;;
    *)
      na_design "go module mode" "goflags_mod is empty, so the role does not set GOFLAGS. go env GOFLAGS='${v:-<empty>}' has no -mod=mod, so Go's default applies: a build refuses to change go.mod/go.sum (readonly, or vendor/ when the module vendors)" ;;
  esac
{% endif %}
  # "go checksum verification" and "go toolchain switching" are in the shared
  # body (files/verify-probes.sh), so the action reports them too. The row that
  # was here read only GOPRIVATE, and printed OK under GOSUMDB=off.
else
  row "N/A" - "go" "go not installed"
fi

# ---------------------------------------------------------------- pip --------
if have pip3 || have pip; then
  # ECH-188. On a role-hardened host `command -v pip` resolves to OUR pip->uv
  # wrapper, which has NO `config` subcommand — so `pip config list` errored and
  # this row false-GAP'd while the protection was actually in effect. Two paths,
  # two sources of truth; do NOT shell `config` through a wrapper:
  #   - pip is our wrapper  -> the source-build block is uv's `no-build`. Ask the
  #     uv the wrapper execs, not the uv.toml we wrote: this row used to grep
  #     /etc/uv/uv.toml and print OK PARSED, and from inside a repo whose uv.toml
  #     says no-build = false it still printed OK while `uv pip install` there
  #     ran a setup.py (MEASURED, uv 0.13.9). So it asks twice, from "/" (the
  #     host config, where nobody but root can plant an ancestor uv.toml) and
  #     from the working directory (where a repo's config outranks the host's),
  #     and is OK only when both say no_build=All.
  #   - pip is a real pip   -> ask pip (`config list`) for `only-binary`. Even
  #     :all: is WEAK, never OK: only-binary refuses an sdist pip RESOLVES from
  #     an index or --find-links, and not one named by path or URL, which still
  #     runs setup.py (MEASURED on pip 22.0.2, 23.0.1, 24.0, 25.1.1 and 26.0.1,
  #     in a venv and with system pip). This row was OK PARSED from a grep.
  PIPBIN=$(command -v pip3 2>/dev/null || command -v pip 2>/dev/null)
  if grep -q 'supply-chain-hardening' "$PIPBIN" 2>/dev/null; then
    pipuv=$(grep -oE "^UV='[^']*'" "$PIPBIN" 2>/dev/null | head -1 | sed "s/^UV='//; s/'\$//")
    { [ -n "$pipuv" ] && [ -x "$pipuv" ]; } || pipuv=$(command -v uv 2>/dev/null)
    pipnbr=""; pipnbc=""; piprr=1; piprc=1; pipwhy=""
    if [ -n "$pipuv" ]; then
      pipdr=$( (cd / && "$pipuv" pip list --show-settings) 2>&1 ); piprr=$?
      pipnbr=$(printf '%s\n' "$pipdr" | grep 'no_build:' | head -1 | sed 's/.*no_build:[ ]*//; s/,.*//')
      pipdc=$("$pipuv" pip list --show-settings 2>&1); piprc=$?
      pipnbc=$(printf '%s\n' "$pipdc" | grep 'no_build:' | head -1 | sed 's/.*no_build:[ ]*//; s/,.*//')
      pipwhy=$(printf '%s' "$pipdc" | grep -i 'failed to parse\|^error:' | head -1 | cut -c1-150)
    fi
    if [ "$piprr" -eq 0 ] && [ -n "$pipnbr" ]; then
      if [ "$pipnbr" != All ]; then
        row GAP PARSED "pip source-build blocking" "pip delegates to uv ($pipuv), but uv reports no_build=$pipnbr - no config uv reads sets no-build, so every sdist pip installs runs its setup.py"
      elif [ "$piprc" -ne 0 ]; then
        row WEAK PARSED "pip source-build blocking" "pip delegates to uv, and the host config sets no-build, but in $PWD uv refuses to run (${pipwhy:-exit $piprc}) - nothing installs here, and whatever config uv found here could not be compared"
      elif [ "$pipnbc" = All ]; then
        row OK PARSED "pip source-build blocking" "pip delegates to uv ($pipuv), which reports no_build=All from / and from $PWD - it refuses every sdist, one named by path or URL included"
      else
        row GAP PARSED "pip source-build blocking" "pip delegates to uv, and the host config sets no-build, but in $PWD uv reports no_build=${pipnbc:-<absent>} - a uv.toml or pyproject.toml [tool.uv] at or above this directory outranks the host config, so a pip install run here builds sdists and runs setup.py"
      fi
    else
      # This uv cannot report its settings back: the file grep is all there
      # is, and a grep is PRESENT evidence, whatever this row used to call it.
      uv_nb=""
      for f in "${UV_CONFIG_FILE:-}" /etc/uv/uv.toml "${XDG_CONFIG_HOME:-$HOME/.config}/uv/uv.toml" "$HOME/.config/uv/uv.toml"; do
        [ -n "$f" ] && [ -f "$f" ] && grep -qiE '^[[:space:]]*no-build[[:space:]]*=[[:space:]]*true' "$f" && { uv_nb="$f"; break; }
      done
      if [ -n "$uv_nb" ]; then
        row WEAK PRESENT "pip source-build blocking" "pip delegates to uv; no-build=true is in $uv_nb, but ${pipuv:-uv} does not report its settings back, so nothing confirms uv reads that file or that no repo config overrides it"
      else
        row GAP PRESENT "pip source-build blocking" "pip delegates to uv but no-build=true is not set in any uv config"
      fi
    fi
  else
    # From /: pip reads no config from the working directory (see "no project
    # code" above).
    pipv=$(cd / && "$PIPBIN" --version 2>/dev/null | awk '{print $2}')
    pipcl=$(cd / && "$PIPBIN" config list 2>/dev/null); pipclrc=$?
    if [ "$pipclrc" -eq 0 ]; then
      # Environment beats a [install] section, which beats [global].
      pipcl=$(printf '%s\n' "$pipcl" | tr -d " '\"\r")
      pipob=$(printf '%s\n' "$pipcl" | sed -n 's/^:env:\.only-binary=//p' | tail -1)
      [ -n "$pipob" ] || pipob=$(printf '%s\n' "$pipcl" | sed -n 's/^install\.only-binary=//p' | tail -1)
      [ -n "$pipob" ] || pipob=$(printf '%s\n' "$pipcl" | sed -n 's/^global\.only-binary=//p' | tail -1)
      case "$pipob" in
        :all:)
          row WEAK PARSED "pip source-build blocking" "pip ${pipv:-?} ($PIPBIN) reports only-binary=:all: - it refuses an sdist it resolves from an index or --find-links, but NOT one named by path or URL (pip install ./x.tar.gz), which still runs setup.py (MEASURED on pip 22.0.2 to 26.0.1). uv's no-build refuses both: prefer uv pip" ;;
        '')
          row GAP PARSED "pip source-build blocking" "pip ${pipv:-?} ($PIPBIN) reports no only-binary - every sdist it installs runs its setup.py" ;;
        *)
          row GAP PARSED "pip source-build blocking" "pip ${pipv:-?} ($PIPBIN) reports only-binary=$pipob, not :all: - sdists of every other package build and run setup.py" ;;
      esac
    else
      pip_ob=""
      for f in "${PIP_CONFIG_FILE:-}" /etc/pip.conf "${XDG_CONFIG_HOME:-$HOME/.config}/pip/pip.conf" "$HOME/.pip/pip.conf" "$HOME/.config/pip/pip.conf"; do
        [ -n "$f" ] && [ -f "$f" ] && grep -qi 'only-binary' "$f" && { pip_ob="$f"; break; }
      done
      if [ -n "$pip_ob" ]; then
        row WEAK PRESENT "pip source-build blocking" "only-binary is in $pip_ob, but '$PIPBIN config list' failed, so pip never confirmed it; and even :all: does not cover an sdist named by path or URL"
      else
        row GAP PRESENT "pip source-build blocking" "no only-binary in any pip config file pip reads"
      fi
    fi
  fi
else
  row "N/A" - "pip" "pip not installed"
fi

# ------------------------------------------------- python import shadowing ---
# ROLE-ONLY, and deliberately not in the shared probe body. python_safe_path is
# opt-in on this surface and absent from the action, so a shared probe would
# fire on CI wherever expected() falls open (SCV_EXPECT_KNOWN=0).
#
# Reports on a control WE DEPLOY, which is the whole reason this row is
# allowed to exist: with python_safe_path=false it is N/A BYDESIGN, not a GAP
# nobody can clear by re-running the role. An un-actionable GAP would make the
# exit code permanently non-zero and poison every actionable row with it.
if ! expected python.safepath; then
  na_design "python import-path shadowing" "python_safe_path is not enabled"
elif ! have python3; then
  row "N/A" - "python import-path shadowing" "python3 not installed"
else
  pysd=$(mktemp -d 2>/dev/null) || pysd=""
  if [ -z "$pysd" ]; then
    row WEAK PRESENT "python import-path shadowing" "could not create a temp dir to run the probe"
  else
    printf 'import os\nopen(os.path.join(os.path.dirname(os.path.abspath(__file__)),"M"),"w").write("x")\n' > "$pysd/struct.py"
    pyv=$(python3 -I -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null)
    # CONTROL first: strip the protection and require the marker. A probe for
    # "nothing happened" is worthless without proof it can observe something.
    rm -f "$pysd/M"
    ( cd "$pysd" && env -u PYTHONSAFEPATH python3 -c "import base64" ) >/dev/null 2>&1
    if [ ! -f "$pysd/M" ]; then
      row WEAK FUNCTIONAL "python import-path shadowing" \
        "control failed: a hostile struct.py did not execute even with PYTHONSAFEPATH stripped on python ${pyv:-?}, so this probe cannot tell protected from blind"
    else
      rm -f "$pysd/M"
      ( cd "$pysd" && python3 -c "import base64" ) >/dev/null 2>&1
      if [ -f "$pysd/M" ]; then
        row GAP FUNCTIONAL "python import-path shadowing" \
          "python_safe_path is enabled but python ${pyv:-?} still executed a struct.py from the working directory during 'import base64' - PYTHONSAFEPATH is not reaching this context (needs 3.11+; env layer does not load for container CMD, systemd or cron)"
      else
        row OK FUNCTIONAL "python import-path shadowing" \
          "python ${pyv:-?} refused a struct.py in the working directory, and the control proved one executes without the protection"
      fi
    fi
    rm -rf "$pysd"
  fi
fi

# =========================================================================
# Fragment 50 (files/verify-probes.sh) follows: bun, deno, uv, pip age gates,
# go checksum db + toolchain, composer, cargo, bundler, maven, gradle, nuget.
# Fragment 90 renders the table.
# =========================================================================
